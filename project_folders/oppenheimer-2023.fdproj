            "image": "data:image/svg+xml;utf8,%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20960%20540%22%20width%3D%22100%25%22%20height%3D%22100%25%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdefs%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3ClinearGradient%20id%3D%22bg%22%20x1%3D%220%25%22%20y1%3D%220%25%22%20x2%3D%220%25%22%20y2%3D%22100%25%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%220%25%22%20stop-color%3D%22%231b2a4a%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%22100%25%22%20stop-color%3D%22%230d1527%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2FlinearGradient%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3CradialGradient%20id%3D%22glow%22%20cx%3D%2250%25%22%20cy%3D%2250%25%22%20r%3D%2250%25%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%220%25%22%20stop-color%3D%22%23f59e0b%22%20stop-opacity%3D%220.35%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%22100%25%22%20stop-color%3D%22%23f59e0b%22%20stop-opacity%3D%220%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2FradialGradient%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdefs%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Crect%20width%3D%22960%22%20height%3D%22540%22%20fill%3D%22url(%23bg)%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ccircle%20cx%3D%22480%22%20cy%3D%22270%22%20r%3D%22270%22%20fill%3D%22url(%23glow)%22%20%2F%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cline%20x1%3D%22316.8%22%20y1%3D%220%22%20x2%3D%22316.8%22%20y2%3D%22540%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.06)%22%20stroke-dasharray%3D%224%206%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cline%20x1%3D%22633.6%22%20y1%3D%220%22%20x2%3D%22633.6%22%20y2%3D%22540%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.06)%22%20stroke-dasharray%3D%224%206%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cline%20x1%3D%220%22%20y1%3D%22178.20000000000002%22%20x2%3D%22960%22%20y2%3D%22178.20000000000002%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.06)%22%20stroke-dasharray%3D%224%206%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cline%20x1%3D%220%22%20y1%3D%22356.40000000000003%22%20x2%3D%22960%22%20y2%3D%22356.40000000000003%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.06)%22%20stroke-dasharray%3D%224%206%22%20%2F%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cpath%20d%3D%22M%20440%20405%20Q%20480%20205.2%20520%20405%20Z%22%20fill%3D%22rgba(0%2C0%2C0%2C0.65)%22%20stroke%3D%22%23f59e0b%22%20stroke-width%3D%221.5%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ccircle%20cx%3D%22480%22%20cy%3D%22226.79999999999998%22%20r%3D%2218%22%20fill%3D%22rgba(0%2C0%2C0%2C0.75)%22%20stroke%3D%22%23f59e0b%22%20stroke-width%3D%221.5%22%20%2F%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cg%20transform%3D%22translate(480%2C%20442.79999999999995)%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cline%20x1%3D%22-35%22%20y1%3D%220%22%20x2%3D%2235%22%20y2%3D%220%22%20stroke%3D%22%23f59e0b%22%20stroke-width%3D%222%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cpolygon%20points%3D%2235%2C-4%2045%2C0%2035%2C4%22%20fill%3D%22%23f59e0b%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctext%20x%3D%220%22%20y%3D%22-8%22%20text-anchor%3D%22middle%22%20fill%3D%22%23f59e0b%22%20font-family%3D%22sans-serif%22%20font-size%3D%2211%22%20font-weight%3D%22bold%22%20letter-spacing%3D%221%22%3ECAMERA%3A%20STATIC%3C%2Ftext%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fg%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Crect%20x%3D%2220%22%20y%3D%2220%22%20width%3D%22auto%22%20height%3D%2224%22%20rx%3D%224%22%20fill%3D%22rgba(0%2C0%2C0%2C0.7)%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.15)%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctext%20x%3D%2230%22%20y%3D%2236%22%20fill%3D%22%23ffffff%22%20font-family%3D%22'Space%20Grotesk'%2C%20monospace%22%20font-size%3D%2212%22%20font-weight%3D%22bold%22%3E%F0%9F%8E%AC%20WIDE%20SHOT%3C%2Ftext%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Crect%20x%3D%2220%22%20y%3D%22492%22%20width%3D%22920%22%20height%3D%2232%22%20rx%3D%226%22%20fill%3D%22rgba(0%2C0%2C0%2C0.75)%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.12)%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctext%20x%3D%2232%22%20y%3D%22513%22%20fill%3D%22%23e2e2e6%22%20font-family%3D%22sans-serif%22%20font-size%3D%2212%22%20font-weight%3D%22600%22%3EEXT.%20LAKESIDE%2C%20INSTITUTE%20FOR%20ADVANCED%20STUDY%2C%20PRINCETON%20--%20DAY%20%E2%80%94%20Einstein%20TURNS%20to%20leave.%20Up%20the%20hill%2C%20Strauss%20approaches...%3C%2Ftext%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fsvg%3E",
            "ts": 1788158809449
          }
        },
        "promptAuto": true
      }
    ]
  },
  "references": {
    "activeCategory": "all",
    "items": []
  },
  "script": [
    {
      "type": "center-title",
      "text": "GADGET"
    },
    {
      "type": "center-title",
      "text": "Written by"
    },
    {
      "type": "center-title",
      "text": "Christopher Nolan"
    },
    {
      "type": "center-title",
      "text": "Based on the novel:"
    },
    {
      "type": "center-title",
      "text": "\"American Prometheus:"
    },
    {
      "type": "center-title",
      "text": "The Triumph and Tragedy of J. Robert Oppenheimer\""
    },
    {
      "type": "center-title",
      "text": "By"
    },
    {
      "type": "center-title",
      "text": "Kai Bird and Martin J. Sherwin"
    },
    {
      "type": "center-title",
      "text": "© 2022 SYNCOPY"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  1.1."
    },
    {
      "type": "action",
      "text": "A VAST SPHERE OF FIRE, the fire of a thousand suns, slowly eats the night-time desert. A line of black type appears:"
    },
    {
      "type": "action",
      "text": "PROMETHEUS STOLE FIRE FROM THE GODS AND GAVE IT TO MAN."
    },
    {
      "type": "action",
      "text": "And the sound of DOZENS OF FEET STAMPING RHYTHMICALLY..."
    },
    {
      "type": "action",
      "text": "FOR THIS HE WAS CHAINED TO A ROCK AND TORTURED FOR ETERNITY."
    },
    {
      "type": "action",
      "text": "ROILING PLASMA expands, the sound of STAMPING GROWS OPPRESSIVE, the STAMPING FASTER and FASTER OVER-"
    },
    {
      "type": "action",
      "text": "A FACE. Gaunt, tense, EYES TIGHTLY SHUT. The face SHUDDERS- the sound CEASES AS MY EYES OPEN, STARING INTO THE CAMERA:"
    },
    {
      "type": "action",
      "text": "Peer into my soul- J. ROBERT OPPENHEIMER, aged fifty, close- cropped greying hair. The gentle sounds of bureaucracy..."
    },
    {
      "type": "action",
      "text": "SUPER TITLE: \"1. FISSION\""
    },
    {
      "type": "character",
      "text": "VOICE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer, as we begin, I believe you have a statement to read into the record? I glance down at my notes."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Yes, your honour-"
    },
    {
      "type": "character",
      "text": "SECOND VOICE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "We’re not judges, doctor."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No. Of course."
    },
    {
      "type": "parenthetical",
      "text": "(I start reading)"
    },
    {
      "type": "dialogue",
      "text": "Members of the Security Board, the so-called derogatory information in your indictment of me cannot be fairly understood except in the context of my life and work. This answer is a summary of relevant aspects of my life in more or less chronological order..."
    },
    {
      "type": "character",
      "text": "SENATE AIDE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "How long did he testify?"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  2.2."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (BLACK-AND-WHITE SEQUENCE)"
    },
    {
      "type": "action",
      "text": "CLOSE: on a prosperous sixty-three-year-old man, LEWIS STRAUSS, as he takes a cup of coffee from a SENATE AIDE..."
    },
    {
      "type": "action",
      "text": "SUPER TITLE: \"2. FUSION\""
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I forget. Three days, or so. The whole hearing took a month."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "An ordeal."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I’ve only read the transcripts, but who’d want to justify their whole life?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "You weren’t there?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "As Chairman, I wasn’t allowed to be. Are they really going to ask about it? It was years ago."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Four years ago. Oppenheimer still divides America- the committee will want to know where you stood."
    },
    {
      "type": "parenthetical",
      "text": "(checks his watch)"
    },
    {
      "type": "dialogue",
      "text": "Ready?"
    },
    {
      "type": "scene-heading",
      "text": "INT. CORRIDOR, SENATE BUILDING -- MOMENTS LATER (B&W)"
    },
    {
      "type": "action",
      "text": "The Senate Aide leads Strauss along the corridor."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Senator Thurmond asked me to say not to feel you’re on trial."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I didn’t, till you said that. SENATE AIDE Really, Mr Strauss- STRAUSS (CONT’D) Admiral."
    },
    {
      "type": "character",
      "text": "SENATE AIDE (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Admiral Strauss, this is a formality."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  3.3."
    },
    {
      "type": "character",
      "text": "SENATESENATE  AIDEAIDE  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "President Eisenhower’s asked you to be in his cabinet, the Senate has no choice but to confirm you. They arrive at the door."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "And if they bring up Oppenheimer?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "When they bring up Oppenheimer, answer honestly and no senator can deny that you did your duty. It’ll be uncomfortable..."
    },
    {
      "type": "parenthetical",
      "text": "(smiles)"
    },
    {
      "type": "dialogue",
      "text": "Who’d want to justify their whole life? The door to the VAST committee room opens- they enter, FLASHBULBS POPPING as PRESS and PUBLIC see Strauss."
    },
    {
      "type": "character",
      "text": "ROBB (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Why did you leave the United States?"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "The room is SMALL, SHABBY. Surprised, I look up from my statement at the prosecutor, Roger ROBB. Then turn to the THREE BOARD MEMBERS (GRAY, EVANS, MORGAN)."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I wanted to learn the new physics."
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "dialogue",
      "text": "Was there nowhere here? I thought Berkeley had the leading theoretical physics department-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Sure. Once I built it. First I had to go to Europe. I went to Cambridge to work under Patrick Blackett."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Were you happier there than in America?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  4.4. INSERT CUT: A YOUNG ME (TWENTY-ONE) LIES IN BED STARING UP, CRYING... PARTICLES WITH THE VASTNESS OF THE STARS MOVE LIKE FIREFLIES..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No. I was homesick. Emotionally immature... troubled by visions of a hidden universe..."
    },
    {
      "type": "scene-heading",
      "text": "INT. LABORATORY, CAMBRIDGE -- DAY"
    },
    {
      "type": "action",
      "text": "The young ME, frazzled demeanor, STRUGGLES with equipment."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...useless in the lab. I drop a beaker, it SHATTERS. PATRICK BLACKETT looks over, FROWNING. He picks up an APPLE and takes a LARGE BITE."
    },
    {
      "type": "character",
      "text": "BLACKETT"
    },
    {
      "type": "parenthetical",
      "text": "(through apple)"
    },
    {
      "type": "dialogue",
      "text": "Christ, Oppenheimer, have you had any sleep? Start again."
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I need to go to the lecture."
    },
    {
      "type": "character",
      "text": "BLACKETT"
    },
    {
      "type": "dialogue",
      "text": "Why?"
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(pleading)"
    },
    {
      "type": "dialogue",
      "text": "It’s Niels Bohr. Blackett checks his watch- starts packing up-"
    },
    {
      "type": "character",
      "text": "BLACKETT"
    },
    {
      "type": "dialogue",
      "text": "Damn, completely forgot. Let’s go. I start to pack up with the other students."
    },
    {
      "type": "character",
      "text": "BLACKETT (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Not you. Finish coating those plates. I clean up as Blackett and the other students leave- one leaves an APPLE for Blackett- GREEN WITH STEM AND TINY LEAF. I pause at a bottle: \"Potassium Cyanide\"... CLUMSY HANDS SHAKING, I draw CYANIDE into a syringe. I INJECT the apple..."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  5.5."
    },
    {
      "type": "scene-heading",
      "text": "EXT. QUADRANGLE, CAMBRIDGE -- EVENING"
    },
    {
      "type": "action",
      "text": "I HURRY across the quad. A lonely figure."
    },
    {
      "type": "character",
      "text": "BOHR (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Quantum physics isn’t a step forward..."
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, CAMBRIDGE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "I sneak into the back of the auditorium. Standing, SPELLBOUND, as NIELS BOHR, a charismatic Dane, lectures."
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "...It’s a new way to understand reality. Einstein’s opened a door, now we’re peering through, seeing a world inside our world... a world of energy and paradox that not everyone can accept. I RAISE my hand to ask a question..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss sits facing the Committee, COUNSEL beside him, PRESS, CAMERAS and PUBLIC behind..."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE"
    },
    {
      "type": "dialogue",
      "text": "Admiral Strauss, I’m interested in your relationship with Dr J. Robert Oppenheimer. You met in 1947?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Correct."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE"
    },
    {
      "type": "dialogue",
      "text": "You were a commissioner of the Atomic Energy Commission?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I was, but I met Robert in my capacity as board member of the Institute for Advanced Study at Princeton. After the war he was world-renowned- the great man of physics..."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  6.6."
    },
    {
      "type": "scene-heading",
      "text": "EXT. INSTITUTE FOR ADVANCED STUDY, PRINCETON -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss, younger, fifty-one, bustles out of the Institute-"
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...I was determined to get him to run the Institute. -to welcome the rail-thin figure of Oppenheimer (forty- three), emerging from a TAXI in HAT and coat, PIPE in mouth. ICONIC."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer, an honour."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Mr Strauss."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "It’s pronounced 'straws'."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "'Oh-ppenheimer', 'aw-ppenheimer'- any way you say it they know I’m Jewish."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I’m a proud member of Temple Emmanuel- 'straws' is the Southern pronunciation. Welcome to the Institute. I think you could be very happy here."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Oh?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Well, you’ll love the commute- the position comes with that house for you and your wife. Strauss points along an avenue of trees to Olden Manor..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "And your two children... Oppenheimer nods as he follows Strauss into the Institute."
    },
    {
      "type": "scene-heading",
      "text": "INT. INSTITUTE FOR ADVANCED STUDY, PRINCETON -- CONTINUOUS"
    },
    {
      "type": "parenthetical",
      "text": "(B&W)"
    },
    {
      "type": "dialogue",
      "text": "Strauss leads Oppenheimer through the Institute."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  7.7."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I’m a great admirer of your work."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You’re a physicist by training, Mr Strauss?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "No, I’m not trained in physics, or anything else. I’m a self-made man."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I can relate to that..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Really?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(dry)"
    },
    {
      "type": "dialogue",
      "text": "My father was one."
    },
    {
      "type": "scene-heading",
      "text": "INT. PRESIDENT’S OFFICE, INSTITUTE FOR ADVANCED STUDY --"
    },
    {
      "type": "action",
      "text": "MOMENTS LATER (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss shows Oppenheimer into the well-appointed office."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "This would be your office. Oppenheimer drifts to the windows- a LAWN rolls down to a POND. He spots a FIGURE- long grey hair poking from under his hat-"
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I’m told he’s there most afternoons. The figure gently tosses a stone into the water."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I’ve always wondered why you didn’t involved him in the Manhattan Project. Oppenheimer turns to Strauss, interested."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "The greatest scientific mind of our time?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  8.8."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Of his time. Einstein published his Theory of Relativity more than forty years ago, but never embraced the quantum world it revealed."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "'God doesn’t play dice.'"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Precisely. You never thought of studying physics formally?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I had offers. But I chose to sell shoes."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Lewis Strauss was once a lowly shoe salesman?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "No. Just a shoe salesman."
    },
    {
      "type": "parenthetical",
      "text": "(opens the door)"
    },
    {
      "type": "dialogue",
      "text": "I’ll introduce you-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No need. I’ve known him for years. Strauss, awkward, stays in the doorway and WATCHES... FROM AFAR: as Oppenheimer approaches, Einstein’s HAT BLOWS off his head, unleashing a MESS OF GREY HAIR, hat rolling across the grass to where Oppenheimer SCOOPS it up, and we..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "I flip a page. Continue reading my statement."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I struggled badly trying to visualize this new world..."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOMS AT CAMBRIDGE -- DAY"
    },
    {
      "type": "action",
      "text": "The Young Me lies on the floor, STARING UP."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  9.9."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...you had to retool your mind to see things hovering just out of site... INSERT CUT: POINTS OF LIGHT MOVE LIKE SPARKS, BUT IN A WAVE."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...then you could unlock forces never before imagined... I wipe TEARS from my eyes. INSERT CUT: STARS. SPARKS FROM A CAMPFIRE. I PAT THE NOSE OF A HORSE IN THE DARKNESS AS I FEED IT AN APPLE. I grow calm, my eyelids lowering... INSERT CUT: AN APPLE- GREEN WITH STEM AND A TINY LEAF... I open MY EYES- JUMP out of bed- SCRAMBLE to dress-"
    },
    {
      "type": "scene-heading",
      "text": "EXT. QUADRANGLE, CAMBRIDGE -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "I RUN, DESPERATE, AGAINST the crowd-"
    },
    {
      "type": "scene-heading",
      "text": "INT. LABORATORY, CAMBRIDGE -- DAY"
    },
    {
      "type": "action",
      "text": "I BURST in- Blackett LOOKS UP. ANOTHER MAN has his back to me. Between them on the workbench- the POISONED APPLE..."
    },
    {
      "type": "character",
      "text": "BLACKETT"
    },
    {
      "type": "dialogue",
      "text": "You alright? I nod awkward, trying to control my BREATHING..."
    },
    {
      "type": "character",
      "text": "BLACKETT (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Niels, meet J. Robert Oppenheimer. The other man TURNS, offers his hand- Niels Bohr."
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "What does the 'J' stand for?"
    },
    {
      "type": "character",
      "text": "BLACKETT"
    },
    {
      "type": "dialogue",
      "text": "Nothing, apparently. Bohr takes me in- this strange, BREATHLESS young man..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  10.10."
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "You were at my lecture. You asked the only good question."
    },
    {
      "type": "character",
      "text": "BLACKETT"
    },
    {
      "type": "dialogue",
      "text": "Nobody’s denying his insight. It’s his labouratory skills that leave a little to be desired. YOUNG OPPENHEIMER I heard you give the same BOHR lecture- At Harvard. And you asked the same question. Why ask again?"
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I hadn’t liked your answer."
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "Did you like it better yesterday?"
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "A lot."
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "You can lift the rock without being ready for the snake that’s revealed. Now, it seems, you’re ready. Bohr picks up the POISONED APPLE from Blackett’s desk..."
    },
    {
      "type": "character",
      "text": "BOHR (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You don’t enjoy the lab? I shake my head. Bohr GESTICULATES with the apple as he talks- I watch it bob around- a kitten following a ball of string..."
    },
    {
      "type": "character",
      "text": "BOHR (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Get out of Cambridge, with its beakers and potions. Go somewhere they’ll let you think..."
    },
    {
      "type": "parenthetical",
      "text": "(assesses me)"
    },
    {
      "type": "dialogue",
      "text": "Gottingen."
    },
    {
      "type": "character",
      "text": "BLACKETT"
    },
    {
      "type": "dialogue",
      "text": "Born?"
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "Born. Get to Germany. Study under Max Born. Learn the ways of theory. I’ll send word. Bohr raises the apple to take a bite- I GRAB it."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  11.11."
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Wormhole. -DROP it into the wastebasket. Blackett peers at it, curious."
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "How’s your mathematics?"
    },
    {
      "type": "character",
      "text": "BLACKETT"
    },
    {
      "type": "dialogue",
      "text": "Not good enough for the physicist he wants to be."
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "Algebra’s like sheet music. The important thing isn’t can you read music, it’s can you hear it. Can you hear the music, Robert?"
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I can. SPARKS explode in WAVES, WAVES of FIRE CRASHING on a SHORE of GLASS, FLYING OVER the MEDIEVAL SPIRES of Gottingen, I watch BORN and BOHR and DIRAC, GALAXIES of PARTICLES DISPERSE and REFORM, a CUBIST PAINTING transfixes the Young Me, an ORCHESTRA plays STRAVINSKY, I read THE WASTE LAND, I WRITE FURIOUSLY at a desk, I WRITE FURIOUSLY on a chalkboard, I SMASH a glass, and ANOTHER, and ANOTHER, WATCHING the SHARDS skid across the floor, CATCHING and REFRACTING LIGHT, I watch RAINDROPS scintillate a PUDDLE, STREAM down a windowpane, I disturb the surface of a sink full of WATER, watching RIPPLES propagate and INTERFERE, I BOUNCE a ball against a corner of my room, studying its trajectory..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. INSTITUTE FOR ADVANCED STUDY, PRINCETON -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss watches Oppenheimer hand the HAT to Einstein. Strauss checks his watch, then starts down the hill towards them. As he approaches, Einstein TURNS, walking towards Strauss with a GRIM EXPRESSION."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "parenthetical",
      "text": "(friendly)"
    },
    {
      "type": "dialogue",
      "text": "Albert... Einstein PASSES without acknowledging Strauss. Strauss reaches Oppenheimer-"
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "What did you say to him?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  12.12."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "He’s fine. Mr Strauss, there are things in my past you need to be aware of."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "As Chairman of the AEC I have access to your security file. I’ve read it. The job is yours."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You’re not worried?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "After all you’ve done for your country?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Times change, Mr Strauss."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "The purpose of this Institute is to provide a haven for independent minds. You’re the man for the job."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Then I’ll consider it. And I’ll see you at the AEC meeting tomorrow. Oppenheimer turns, heads back up the hill."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "parenthetical",
      "text": "(taken aback)"
    },
    {
      "type": "dialogue",
      "text": "This is one of the most prestigious appointments in the country... Oppenheimer looks back at Strauss, GRINS-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "With a great commute. That’s why I’m considering it. Strauss watches him go, shaking his head."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "So, Dr Oppenheimer brought your attention to his past associations before you appointed him?"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Yes."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  13.13."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE"
    },
    {
      "type": "dialogue",
      "text": "And they didn’t concern you?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Just then I was more concerned about what he’d said to Einstein to sour him on me. A few CHUCKLES from the room."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE"
    },
    {
      "type": "dialogue",
      "text": "But later?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Well, we all know what happened later."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "The board members listen as I continue reading..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "After Gottingen I moved on to Leiden in Holland..."
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, LEIDEN -- DAY"
    },
    {
      "type": "action",
      "text": "A packed hall. The Young Me nervously checks my notes."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...where I first met Isidor Rabi... A stocky young man, ISIDOR RABI (thirty), plonks down next to a DUTCH STUDENT who reluctantly shifts, giving him room."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "A Yank lecturing on new physics? This I have to hear- I’m an American myself."
    },
    {
      "type": "character",
      "text": "DUTCH STUDENT"
    },
    {
      "type": "dialogue",
      "text": "How surprising."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Let me know if you need help with the English. I start lecturing... IN DUTCH. Ravi, confused, leans in."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  14.14."
    },
    {
      "type": "character",
      "text": "RABI (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Wait, what’s he saying?"
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, LEIDEN TO ZURICH -- NIGHT"
    },
    {
      "type": "action",
      "text": "I stare out the window at dark trees, steam and shadows, Rabi dumps his bags down, slumps opposite, sizes me up. Offers me an orange-"
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No, thank you."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "It’s a long way to Zurich. You get any skinnier we might lose you between the seat cushions. I’m Rabi."
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Oppenheimer. Rabi starts peeling his orange."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "I caught your lecture on molecules. Caught some if it- we’re a couple of New York Jews- how do you know Dutch?"
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I thought I’d better learn it when I got here this semester. Rabi STOPS peeling his orange to STARE at me-"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "You learned Dutch in six weeks to give a lecture on quantum mechanics?"
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I wanted to challenge myself."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Quantum physics isn’t challenging enough? Schvitzer."
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Schvitzer?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "'Show-off.' Dutch in six weeks but you never learned Yiddish?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  15.15."
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(smile)"
    },
    {
      "type": "dialogue",
      "text": "They don’t speak it so much my side of the park."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Screw you. Homesick?"
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You know it. Rabi peels his orange. He turns serious..."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Ever get the feeling our kind isn’t entirely welcome here?"
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Physicists?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Funny."
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Sometimes. Not in the department."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "They’re all Jewish, too. Rabi tosses me a slice of orange."
    },
    {
      "type": "character",
      "text": "RABI (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Eat. I take the orange, 'sipping' at it."
    },
    {
      "type": "character",
      "text": "RABI (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "In Zurich there’s a German you have to seek out-"
    },
    {
      "type": "character",
      "text": "YOUNG OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Heisenberg."
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, ZURICH -- DAY"
    },
    {
      "type": "action",
      "text": "A tall man of twenty-six turns from the blackboard- HEISENBERG. I study his every move. Rabi NUDGES me 'See?'..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SAME -- LATER"
    },
    {
      "type": "action",
      "text": "Rabi introduces me to Heisenberg."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  16.16."
    },
    {
      "type": "character",
      "text": "HEISENBERG"
    },
    {
      "type": "dialogue",
      "text": "Oppenheimer, yes. I liked your paper on molecules."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Probably because you inspired it."
    },
    {
      "type": "character",
      "text": "HEISENBERG"
    },
    {
      "type": "dialogue",
      "text": "If I inspire anything else, let me know. We could publish together."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I have to get back to America."
    },
    {
      "type": "character",
      "text": "HEISENBERG"
    },
    {
      "type": "dialogue",
      "text": "Why? There’s no one there taking quantum mechanics seriously."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That’s exactly why."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "He’s pining for the canyons of Manhattan."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The canyons of New Mexico."
    },
    {
      "type": "character",
      "text": "HEISENBERG"
    },
    {
      "type": "dialogue",
      "text": "You’re from New Mexico?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "New York, but my brother and I have a ranch outside of Santa Fe. That’s the America I miss right now."
    },
    {
      "type": "character",
      "text": "HEISENBERG"
    },
    {
      "type": "dialogue",
      "text": "Then you best go home, cowboys."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "That’s his thing- me and horses? I don’t think so."
    },
    {
      "type": "character",
      "text": "GRAY (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Did you ever encounter Heisenberg again?"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "I smile to myself."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  17.17."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Not in person. But you might say our paths crossed."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Doctor, during your time in Europe, you seem to have met a wide range of other countries’ physicists..."
    },
    {
      "type": "parenthetical",
      "text": "(consulting notes)"
    },
    {
      "type": "dialogue",
      "text": "Born, Bohr, Pauli, Dirac, Einstein, Heisenberg...?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That’s right. Robb looks up at me..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Any Russians?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Not that spring to mind."
    },
    {
      "type": "parenthetical",
      "text": "(from notes)"
    },
    {
      "type": "dialogue",
      "text": "Returning to America I accepted appointments at both Caltech..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BERKELEY -- DAY"
    },
    {
      "type": "action",
      "text": "I walk across campus to the physics department..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...and up at Berkeley."
    },
    {
      "type": "scene-heading",
      "text": "INT. CORRIDOR, BERKELEY -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "I struggle to unlock a door... it opens-"
    },
    {
      "type": "scene-heading",
      "text": "INT. CLASSROOM, BERKELEY -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "A DUSTY storage space. Scattered tables and chairs. A piano."
    },
    {
      "type": "scene-heading",
      "text": "EXT. CORRIDOR, BERKELEY -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "I step out of the classroom. Look NEXT DOOR..."
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  18.18."
    },
    {
      "type": "scene-heading",
      "text": "INT. RAD LAB, BERKELEY -- DAY"
    },
    {
      "type": "action",
      "text": "I enter. A handsome young scientist, ERNEST LAWRENCE, works on an assemblage of curved pipes and wiring with students, including Luis ALVAREZ."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Dr. Lawrence, I presume."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "You must be Oppenheimer. I hear you want to start a school of quantum theory."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I am starting it. Next door."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "They put you in there?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I asked for it. I wanted to be close to you experimentalists."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Theory will get you only so far."
    },
    {
      "type": "parenthetical",
      "text": "(gestures)"
    },
    {
      "type": "dialogue",
      "text": "We’re building a machine to accelerate electrons."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Magnificent."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Would you like to help?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Build it? No. But I’m working on theories I’d like to test with it."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "When do you start teaching?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ve got my first in an hour."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Seminar?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Pupil."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "One student? That’s it?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  19.19. OPPENHEIMER I’m teaching something no one LAWRENCE (CONT’D) here’s dreamt of. But once (grins) people start hearing what you There’s no going back. can do with it..."
    },
    {
      "type": "scene-heading",
      "text": "INT. CLASSROOM, BERKELEY -- LATER"
    },
    {
      "type": "action",
      "text": "I stand there, expectant. A student opens the door, looks around, embarrassed-"
    },
    {
      "type": "character",
      "text": "STUDENT"
    },
    {
      "type": "dialogue",
      "text": "I’m sorry, I must have missed-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No, this is it. Mr Lomanitz, right? LOMANITZ (twenty-one) nods, takes a seat."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "What do you know about quantum mechanics?"
    },
    {
      "type": "character",
      "text": "LOMANITZ"
    },
    {
      "type": "dialogue",
      "text": "I have a grasp on the basics-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Then you’re doing it wrong."
    },
    {
      "type": "parenthetical",
      "text": "(rapid-fire)"
    },
    {
      "type": "dialogue",
      "text": "Is light made up of particles or waves? Lomanitz opens his mouth to speak- too slow-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Quantum mechanics says it’s both- how can it be both? LOMANITZ It can’t. OPPENHEIMER (CONT’D) It can’t. But it is. It’s paradoxical and yet... it works. Lomanitz is hooked. I turn to the board, chalk out an equation... when I turn back- There are now FIVE students (including SERBER and SNYDER) listening intently... I move to Lomanitz to hand him his paper. I pat his shoulder."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  20.20."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You’re gonna be okay."
    },
    {
      "type": "transition",
      "text": "DISSOLVE TO:"
    },
    {
      "type": "action",
      "text": "A PACKED CLASSROOM, hanging on my every word as I- now thirty- two, slim, well-dressed, confident- teach in the round. Lawrence listens at the edge, fascinated."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Consider a star... a vast furnace burning in outer space... INSERT CUT: A STAR. A SUN. BURNING, ROILING."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Fire pushing outwards against its own gravity- balanced. But if its furnace cools, gravity starts winning. It contracts... I look around. Make eye contact with Hartland SNYDER."
    },
    {
      "type": "character",
      "text": "SNYDER"
    },
    {
      "type": "dialogue",
      "text": "Density increases..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Increasing gravity... INSERT CUT: THE SUN IS SHRINKING, MORE AND MORE RAPIDLY..."
    },
    {
      "type": "character",
      "text": "SNYDER"
    },
    {
      "type": "dialogue",
      "text": "Increasing density. A vicious cycle. Until... What’s the limit here?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I don’t know. See where the math takes us. I guarantee it’s somewhere no one’s been before."
    },
    {
      "type": "character",
      "text": "SNYDER"
    },
    {
      "type": "dialogue",
      "text": "Me?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Your math’s better than mine."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  21.21."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BERKELEY -- DAY"
    },
    {
      "type": "action",
      "text": "Energetic, dashing, I STRIDE across campus, a group of students, including Snyder and Lomanitz, following me, hanging on my every word..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Einstein can’t accept the Copenhagen interpretation-"
    },
    {
      "type": "character",
      "text": "LOMANITZ"
    },
    {
      "type": "dialogue",
      "text": "'God doesn’t play dice.'"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Except he does. Bohr showed us how..."
    },
    {
      "type": "scene-heading",
      "text": "INT. CLASSROOM, BERKELEY -- DAY"
    },
    {
      "type": "action",
      "text": "I mark up a paper. Lawrence comes in, frowns at the board."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "You shouldn’t let them bring their politics into the classroom... I follow his look: \"SATURDAY 2:00pm, RALLY FOR LOYALIST SPAIN\"."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I wrote that. Lawrence, you embrace the revolution in physics, can’t you see it everywhere else? Picasso, Stravinsky, Freud, Marx..."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "This is America, Oppie. We had our revolution. Seriously, keep it out of the lab."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Well, out of the lab, my landlady’s having a discussion group tonight."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "I’ve sampled the Berkeley political scene- it’s all philosophy postgrads and Communists talking integration."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You don’t care about integration?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  22.22."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "I want to vote for it, not talk about it. Let’s get dinner."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m meeting my brother there."
    },
    {
      "type": "character",
      "text": "SENATOR BARTLETT (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer’s file contained details of FBI surveillance on his activities at Berkeley..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss looks at the senator, cautious..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Yes, as I recall."
    },
    {
      "type": "character",
      "text": "SENATOR BARTLETT"
    },
    {
      "type": "dialogue",
      "text": "Why would they have started a file on Dr Oppenheimer before the war?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "You’d have to ask Mr Hoover."
    },
    {
      "type": "character",
      "text": "SENATOR BARTLETT"
    },
    {
      "type": "dialogue",
      "text": "I’m asking you, Admiral Strauss."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "My assumption is that it was connected to his left-wing political activities."
    },
    {
      "type": "character",
      "text": "SENATOR BARTLETT"
    },
    {
      "type": "dialogue",
      "text": "How would these activities have come to the attention of the FBI?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Well, if I remember correctly..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. HOUSE PARTY, SHASTA ROAD, BERKELEY -- NIGHT (COLOUR)"
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "The FBI was taking license plates outside suspected Communist gatherings and his name popped up. As I get out of my car, I spot TWO MEN checking the license plates of cars on the street... I am GRABBED-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  23.23."
    },
    {
      "type": "character",
      "text": "FRANK (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Gotcha! My younger brother FRANK (twenty-five) and his date, JACKIE."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM, HOUSE PARTY, SHASTA ROAD, BERKELEY -- NIGHT"
    },
    {
      "type": "action",
      "text": "We ENTER the bustling room- I spot a beguiling young woman-"
    },
    {
      "type": "character",
      "text": "VOICE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Robert! Come meet Chevalier. Mary WASHBURN grabs my tie and leads us to Haakon CHEVALIER."
    },
    {
      "type": "character",
      "text": "WASHBURN"
    },
    {
      "type": "dialogue",
      "text": "Dr Haakon Chevalier, Dr Robert Oppenheimer, and vice versa."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "This is my little brother, Frank. Oh, and... uh..."
    },
    {
      "type": "character",
      "text": "JACKIE"
    },
    {
      "type": "dialogue",
      "text": "Still Jackie."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Hello, Still Jackie."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Chevalier. You’re in languages?"
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "And your reputation precedes you."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m blushing- what’ve you heard?"
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "You’re teaching a radical new approach to physics that I have no chance of understanding. But I hadn’t heard you were a party member-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m not."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "Not yet."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  24.24. JACKIE Frank and I are thinking of OPPENHEIMER joining- (ignoring Jackie) I support of range of causes. Jackie, put out, leads Frank away."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "The Spanish Civil War?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "A democratic republic being overthrown by fascist thugs? Who wouldn’t be?"
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Our government- they think socialism’s a bigger threat than fascism."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Not for long- look at what the Nazis are doing to the Jews. I send funds to colleagues in Germany to emigrate. I have to do something. My own work is so... abstract."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "What’re you working on?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "What happens to stars when they die."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Do stars die?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "If they do they’d cool, then collapse. And the bigger the star, the more violent its demise. Their gravity gets so concentrated... INSERT CUT: THE SUN SHRINKS. THE LIGHT OF THE DISTANT STARS BEHIND IS TUGGED TOWARDS THE DYING STAR, BENDING, STRETCHING."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "...it swallows everything. Even light."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Good God. Can that really happen?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  25.25."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The math says it can. If we can get published, maybe one day an astronomer finds one. But all I have is theory. Which can’t impact people’s lives."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "If you’re sending money to Spain, do it through the Communist Party- they can get it to the front lines. The beguiling young woman is there with a tray of martinis. This is Jean TATLOCK..."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Mary sent me with these. I’m Jean."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Robert."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Haakon Chevalier. The union meeting at Serber’s last month? Tatlock nods. I take a glass."
    },
    {
      "type": "character",
      "text": "CHEVALIER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Robert here says he’s not a Communist."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Then he doesn’t know enough about it."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ve read Das Kapital. All three volumes. Does that count?"
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "That would make you better read than most Party members."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s turgid stuff, but there’s some thinking... 'Ownership is theft.'"
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "'Property', not 'Ownership'."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Sorry, I read it in the original German."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  26.26. Chevalier laughs, delighted, as he leaves us alone."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "It’s not about the book, it’s about the ideas. You sound uncommitted."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m committed to thinking freely about how to improve our world. Why limit yourself to one dogma?"
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "You’re a physicist- do you pick and choose rules? Or do you use the discipline to channel your energies into progress?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I like a little wiggle room. Do you always toe the party line? Tatlock considers this. Sizes me up."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "I like my wiggle room, too."
    },
    {
      "type": "scene-heading",
      "text": "INT. BEDROOM -- LATER"
    },
    {
      "type": "action",
      "text": "We are FUCKING. Hot, sweaty, a little brutal. Tatlock GIVES UP, climbs off me-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Wait, wait- I catch my breath, watching her STUDY my shelves."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Unexpected."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "What?"
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "For a physicist."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You’ve only got a shelf full of Freud? TATLOCK Actually my background’s more- OPPENHEIMER (CONT’D) Jungian."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  27.27."
    },
    {
      "type": "character",
      "text": "TATLOCK (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You know analysis."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "When I was a postgrad at Cambridge I had some trouble. She turns to me."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "I’ll bite."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I tried to poison my tutor."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Did you hate him?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I liked him very much. Tatlock turns back to the books."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "You just needed to get laid."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Wow. Took my analysts two years, and I’m not sure they ever put it that succinctly."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "You had them convinced you’re more complicated than you really are."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We’re all simple souls, I guess."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Not me. She pulls a book from the shelf: THE BHAGAVAD GITA. She opens the book to find INCOMPREHENSIBLE CHARACTERS."
    },
    {
      "type": "character",
      "text": "TATLOCK (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "What’s this?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Sanskrit."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "You can read this?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  28.28."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m learning- She climbs on top of me, opens the book in my face."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Go on then. I study the page as Tatlock starts to move. OPPENHEIMER In this part, Vishnu reveals TATLOCK (CONT’D) his multi-armed self- Read the words. She points to each word as I translate..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "'And now I am become Death... She nods, impressed, starts moving again..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "...destroyer of worlds.'"
    },
    {
      "type": "scene-heading",
      "text": "EXT. NEW MEXICO -- DAY"
    },
    {
      "type": "action",
      "text": "Moving over the VAST landscape to find three tiny figures. I lead Lawrence and Frank on horseback up a mountain trail."
    },
    {
      "type": "scene-heading",
      "text": "EXT. CAMPSITE -- EVENING"
    },
    {
      "type": "action",
      "text": "THUNDER. Lawrence climbs off his horse. The wind WHIPS as we set up our tent..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’ll break before dawn. The air cools overnight. Just before dawn, the storm dies. INT./EXT. TENT -- NIGHT Lawrence, Frank and I huddle in the BUFFETING TENT, trying to keep a fire going in the WIND and RAIN outside the tent."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "I’m getting married."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Congratulations, Frank. I look at Frank, sardonic with drink."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  29.29."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "To Jackie? Frank stares at me... the tent stops buffeting..."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "Yeah, to Jackie. The waitress."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "parenthetical",
      "text": "(sensing tension)"
    },
    {
      "type": "dialogue",
      "text": "Oppie, you’re right- it’s letting up. I’ll see if there’s any stars. Frank watches Lawrence go, then pounces-"
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "All your talk about the common man but Jackie’s not good enough? We join the Party- you can’t hide your disapproval- why? Because that’s supposed to be your thing?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I haven’t joined the Party, Frank. And I don’t think she should’ve convinced you to, either-"
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "Half the faculty’s Communist-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Not that half. I point in the direction Lawrence wondered off."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I’m your brother and I want you to be cautious."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "And I want to wring your neck. I giggle at this. Frank shakes his head, then starts laughing, too. I grab Frank’s shoulder. Frank looks up..."
    },
    {
      "type": "character",
      "text": "FRANK (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Robert, I won’t live my life afraid to make a mistake. I hold up my hands in defeat-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You’re happy, I’m happy."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  30.30."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "Then I’m happy you’re happy."
    },
    {
      "type": "scene-heading",
      "text": "EXT. PERRO CALIENTE -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "I approach Lawrence, who stares up at the stars."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "It’s so clear I feel like I could see one of those dark stars you’re working on..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You can’t, that’s the whole point. INSERT CUT: AN EXPANDING DARKNESS EATS THE STARS..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Their gravity swallows light. It’s like a kind of... hole in space."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Is Frank okay?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Yeah. He just has a shitty brother. Lawrence smiles at this. Looks around, then-"
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "It’s special here."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "As a kid I thought if I could find a way to combine physics and New Mexico, my life would be perfect."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "It’s a little remote for that. Let’s get some sleep. I turn, heading to the tent. Lawrence follows."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That mesa we saw today? One of my favorite places in the world. Tomorrow we’ll climb it."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "What’s it called? My response is so soft it is almost swallowed by the dark..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  31.31."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Los Alamos."
    },
    {
      "type": "scene-heading",
      "text": "EXT. STREET, BERKELEY -- DAY"
    },
    {
      "type": "action",
      "text": "Tatlock and I walk down the sidewalk. I try to take her hand- she folds her arms."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "I wasn’t expecting to see you."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I have to make an appointment? Across the street a young man BURSTS out of the BARBER SHOP, towel across chest, NEWSPAPER in hand... the barber runs out- the young man rips off the towel, TOSSES it to him and RUNS-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Alvarez! I leave Tatlock on the sidewalk, take off after Alvarez-"
    },
    {
      "type": "scene-heading",
      "text": "EXT. BERKELEY CAMPUS -- DAY"
    },
    {
      "type": "action",
      "text": "Alvarez SPRINTS, newspaper in hand- I follow-"
    },
    {
      "type": "scene-heading",
      "text": "INT. CLASSROOM, BERKELEY -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "I BURST in- Lawrence is trying to calm Alvarez-"
    },
    {
      "type": "character",
      "text": "ALVAREZ"
    },
    {
      "type": "parenthetical",
      "text": "(breathless)"
    },
    {
      "type": "dialogue",
      "text": "They’ve done it! Hahn and Strassman in Germany... Alvarez tosses the paper at me-"
    },
    {
      "type": "character",
      "text": "ALVAREZ (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "They split the uranium nucleus."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "How?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(reading)"
    },
    {
      "type": "dialogue",
      "text": "Bombarded it with neutrons."
    },
    {
      "type": "character",
      "text": "ALVAREZ"
    },
    {
      "type": "dialogue",
      "text": "Lawrence, it’s fission. Nuclear fission. They’ve split the atom..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  32.32."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s not possible. I put down the paper, take up my chalk like it’s a weapon, move to the board. Alvarez grabs the paper-"
    },
    {
      "type": "character",
      "text": "ALVAREZ"
    },
    {
      "type": "dialogue",
      "text": "I’m going to try to reproduce it. Alvarez and Lawrence leave. I write and write..."
    },
    {
      "type": "scene-heading",
      "text": "INT. CLASSROOM, BERKELEY -- LATER"
    },
    {
      "type": "action",
      "text": "Lawrence enters. I turn. Point at the board."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "See. It can’t be done."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Very elegant. Quite clear. Just one problem..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Where?"
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Next door. Alvarez did it."
    },
    {
      "type": "scene-heading",
      "text": "INT. RAD LAB, BERKELEY -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "I peer at Alvarez’s oscilloscope..."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Theory will take you only so far. I stand, moving away... thinking..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "During the process extra neutrons boil off. Which could be used to split other uranium atoms..."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "A chain reaction. You’re thinking what I’m thinking."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You, me and every physicist around the world who’s seen the news."
    },
    {
      "type": "character",
      "text": "ALVAREZ"
    },
    {
      "type": "dialogue",
      "text": "What? What’re we all thinking?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  33.33."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "A bomb, Alvarez. A bomb."
    },
    {
      "type": "scene-heading",
      "text": "EXT. TATLOCK HOUSE, BERKELEY -- NIGHT"
    },
    {
      "type": "action",
      "text": "Tatlock GRABS a bouquet out of my hands-"
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "I told you, Robert, no more fucking flowers. She dumps them in the trash. I just stare. OPPENHEIMER I don’t understand what you TATLOCK (CONT’D) want from me- I don’t want anything from you. I pause. Then, gently..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You say that. Then you call. Tatlock kicks at the dirt."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Don’t answer."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ll always answer. She looks up at me."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Fine. But no more flowers. She goes inside-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Aren’t you coming? Slams the door shut behind her. I stand there."
    },
    {
      "type": "character",
      "text": "CHEVALIER (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "You have to know when you’re beaten, Robert. I turn. Chevalier and his wife, BARBARA, wait in the car."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s not that simple, Haakon."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  34.34."
    },
    {
      "type": "scene-heading",
      "text": "INT. MEETING HALL, BERKELEY -- NIGHT"
    },
    {
      "type": "action",
      "text": "Chevalier and Barbara lead me into the crowded hall. A BANNER: \"FEDERATION OF ARCHITECTS, ENGINEERS, CHEMISTS AND TECHNICIANS\"."
    },
    {
      "type": "action",
      "text": "A man with a British accent greets us. This is ELTENTON."
    },
    {
      "type": "character",
      "text": "ELTENTON"
    },
    {
      "type": "dialogue",
      "text": "Chevalier, good to see you. And the illustrious Dr Oppenheimer. I’m Eltenton. Might you say a word about organized labour on campuses?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ll try to think of something. Eltenton guides me towards the stage..."
    },
    {
      "type": "character",
      "text": "ELTENTON"
    },
    {
      "type": "dialogue",
      "text": "I work at Shell, we’ve signed up chemists and engineers..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That’s excellent. I spot Lomanitz, who grins and waves..."
    },
    {
      "type": "character",
      "text": "ELTENTON"
    },
    {
      "type": "dialogue",
      "text": "So why not scientists in academia?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Sure. When do we- Eltenton pushes me onto the stage. People start APPLAUDING at the very sight of me. I can’t quite not smile about this."
    },
    {
      "type": "scene-heading",
      "text": "INT. RAD LAB, BERKELEY -- DAY"
    },
    {
      "type": "action",
      "text": "I watch Lawrence examine his cyclotron."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Teachers are unionized, Lawrence. Why not professors?"
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Don’t you have somewhere to be?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Academics have rights, too-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  35.35."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "It’s not that. I have a group coming."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ll sit in."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Not this one. The door opens. Richard TOLMAN and Vannevar BUSH enter-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Richard. Dr Bush. What brings you two up north? They exchange glances with Lawrence. Awkward SILENCE. I rise, letting them off the hook-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Richard, tell Ruth I’ll be down to Pasadena Thursday."
    },
    {
      "type": "scene-heading",
      "text": "INT. CLASSROOM, BERKELEY -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "As I enter, a magazine FLAPS into my hands from across the room. Students are all reading copies..."
    },
    {
      "type": "character",
      "text": "SERBER"
    },
    {
      "type": "dialogue",
      "text": "Your paper on black holes- it’s in! I open the magazine as I turn to a STUDENT-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Get Hartland."
    },
    {
      "type": "character",
      "text": "LOMANITZ"
    },
    {
      "type": "dialogue",
      "text": "September 1st, 1939- the world’s gonna remember this day... Snyder comes in with a newspaper. Glum."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Hartland, our paper, it’s in print!"
    },
    {
      "type": "character",
      "text": "SNYDER"
    },
    {
      "type": "dialogue",
      "text": "We’ve been upstaged. He holds up the paper: \"HITLER INVADES POLAND\"."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "During the Battle of France and the Battle of Britain..."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  36.36."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "Robb looks on intently as I turn the page on my statement..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "...I found myself increasingly out of sympathy with the policy of neutrality that Communists advocated."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "And after Hitler invaded Russia, did these Communist sympathies return? OPPENHEIMER No. If you’ll just allow me GRAY to- Mr Robb, you’ll have ample opportunity to cross-examine."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I need to make clear that my changing opinion of Russia did not mean a sharp break with those who held different views. For a year or two during a previous marriage my wife, Kitty, had been a Communist Party member. Behind me, on a couch, is KITTY (forty-six), listening intently..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "But when I first met her, in Pasadena in 1939, she had already disengaged from politics..."
    },
    {
      "type": "scene-heading",
      "text": "INT. HOUSE PARTY, TOLMAN HOUSE, PASADENA -- NIGHT"
    },
    {
      "type": "action",
      "text": "Kitty (thirty-one) watches as I EXPERTLY open the liquor cabinet-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "This is where I keep the good stuff."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "I thought this was the Tolmans’ house."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I live with them when I’m at Caltech."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  37.37."
    },
    {
      "type": "character",
      "text": "RUTH (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "You two need anything? I turn to see RUTH TOLMAN (forty-five) looking at me, mischievous."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We’re fine, Ruthie."
    },
    {
      "type": "parenthetical",
      "text": "(to Kitty)"
    },
    {
      "type": "dialogue",
      "text": "You’re a biologist?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Somehow I graduated to housewife. Can you explain quantum mechanics to me? It seems baffling."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It is. This glass- I thump a glass onto the cabinet- pour a drink-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "This drink- I hand her the glass- fingers touching..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Our bodies... are mostly empty space- groupings of tiny energy waves bound together."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "By what?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Forces of attraction strong enough to convince us that matter is solid... I push the palm of my hand up against hers."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "And stop my body passing through yours. Kitty pushes her fingers through mine, interlacing our hands. I look at a GREY-HAIRED MAN in conversation with Tolman..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You’re married to Dr Harrison."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Not very."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  38.38."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Well, there’s someone that I..."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Does she feel the same way?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Sometimes. Not often enough. As Ruth looks our way I let Kitty’s hand go."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I’m going to New Mexico, to my ranch. With friends. You should come. Kitty looks meaningfully over her glass at me."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I meant with your husband."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Yes, you did. Because you know it won’t make a bit of difference."
    },
    {
      "type": "scene-heading",
      "text": "EXT. PERRO CALIENTE -- DAY"
    },
    {
      "type": "action",
      "text": "Kitty and I THUNDER along on horseback, climbing a ridge. I shout ahead to Kitty-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Why did you marry him?! Kitty pulls up. I come alongside."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "I was lost. He was kind."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Lost?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "My previous husband died. At twenty- eight I wasn’t ready to be a widow. Kitty DISMOUNTS. I follow."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Who was your first husband?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Nobody. But my second husband was Joe Dallet."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  39.39."
    },
    {
      "type": "character",
      "text": "KITTYKITTY  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "From money, like me, but he was a union organizer in Youngstown, Ohio. I fell hard."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "How hard?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Hard enough to spend four years living off beans and pancakes, handing out the Daily Worker at factory gates. Kitty takes out a hip flask. SWIGS."
    },
    {
      "type": "character",
      "text": "KITTY (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "By ’36 I told Joe I couldn’t take it anymore, quit the Party and joined my parents swanning around Europe. A year later I said I wanted him back. Him, not the Daily Worker. He said 'Swell, I’ll meet you on my way to Spain.' She hands me the flask. I take a drink."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "He went to fight for the loyalists?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "On his way we reconciled. One beautiful week in Paris. Then he went to the brigades and I waited. One day Steve Nelson turns up in the lobby of the hotel to tell me Joe got himself killed first time he popped out of his trench."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Who’s Steve Nelson?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Head of the Communist Party in San Francisco. You don’t know him?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m not a Communist."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "You seem to know a lot of ’em."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Including you."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  40.40."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "parenthetical",
      "text": "(shakes head)"
    },
    {
      "type": "dialogue",
      "text": "Ideology got Joe killed. For nothing."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The Spanish Republic isn’t nothing."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "My husband offered both our futures to stop one fascist bullet embedding itself in a mudbank. That’s the definition of nothing."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That seems a little reductive-"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Pragmatic. Steve and his wife brought me home with them to Chicago, then set me up with husband number three. Now here I am... She looks around at the wilderness..."
    },
    {
      "type": "character",
      "text": "KITTY (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Wherever the hell this is- I grab her. Kiss her, hard."
    },
    {
      "type": "scene-heading",
      "text": "INT. TATLOCK’S BEDROOM -- DAY"
    },
    {
      "type": "action",
      "text": "Tatlock and I sit on the floor, backs to the bed like kids. Tatlock has been crying."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I didn’t want you to hear it from someone else."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "You didn’t bring flowers. That’s something. I reach into my pocket- she GRABS the small posy from me, TOSSING it aside."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Jean, we both know I’m not what you want."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Yeah. But it’s a door closing."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  41.41."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Not as far as I’m concerned. Tatlock looks at me. Appreciating the sentiment."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "You knocked her up. Fast work."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Can’t keep a good man down."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "I meant her. She knew what she wanted. What about the husband?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We spoke. He’s divorcing her so we can get married before she’s showing."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "How civilized, you idiot. This is your community- you think rules don’t apply to the golden boy?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Brilliance makes up for a lot."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Don’t alienate the only people in the world who understand what you do. One day you might need them."
    },
    {
      "type": "scene-heading",
      "text": "INT. RAD LAB, BERKELEY -- DAY"
    },
    {
      "type": "action",
      "text": "I write \"F.A.E.C.T.\" on the board, Lomanitz hands out FLIERS. Lawrence enters, GRABBING a flyer from the nearest student: \"UNIONIZE THE RADIATION LAB\"."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Lomanitz? What do you make a month?"
    },
    {
      "type": "character",
      "text": "LOMANITZ"
    },
    {
      "type": "parenthetical",
      "text": "(sheepish)"
    },
    {
      "type": "dialogue",
      "text": "A hundred and fifty dollars. Lawrence turns to another student-"
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "How are the working conditions?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That’s not the point, Lawrence."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  42.42."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "What do you have in common with dock workers and farm labourers?"
    },
    {
      "type": "character",
      "text": "LOMANITZ"
    },
    {
      "type": "dialogue",
      "text": "Plenty-"
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Right. Everybody out. Now!"
    },
    {
      "type": "parenthetical",
      "text": "(to me)"
    },
    {
      "type": "dialogue",
      "text": "Not you. The students file out. Lawrence SLAMS the door- turns on me-"
    },
    {
      "type": "character",
      "text": "LAWRENCE (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "What’re you doing?!"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s a trade union-"
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Full of Communists!"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "So? I haven’t joined the Party-"
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "They won’t let me bring you onto the project because of this shit! They won’t even let me tell you what the project is-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I know what the fucking project is, Lawrence! We all heard about Einstein and Szilard’s letter to Roosevelt. Warning him the Germans could make a bomb. And I know what it means for the Nazis to have a bomb."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "I don’t?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s not your people they’re herding into camps! It’s mine!"
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "You think I tell them about your politics? Next time you’re coming home from a meeting, take a look in the rear-view mirror."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  43.43."
    },
    {
      "type": "character",
      "text": "LAWRENCELAWRENCE  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "Listen for sounds on your phone line. And stop being so goddamn naïve. I’m taken aback by this..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Why would they care what I do?"
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Because you’re not just self- important, you’re actually important. I see the reality. Shift gears-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I get it. You don’t have to worry. I get it. LAWRENCE You just need to be more- OPPENHEIMER (CONT’D) Pragmatic. It’s done, Lawrence. I’ll talk to Lomanitz and the others. You don’t have to worry. Lawrence looks at me. Sees this is real."
    },
    {
      "type": "character",
      "text": "LAWRENCE (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Then welcome to the war."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "I filled out my first security questionnaire..."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "I glance up from my notes."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "...and was informed that my involvement in left-wing groups would not prove a bar to my work on the atomic programme."
    },
    {
      "type": "character",
      "text": "SENATOR PASTORE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Why were his Communist associations not seen as a security risk during the war?"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  44.44."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss suppresses his irritation at the line of questioning."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Senator, I can’t possibly answer for a security clearance granted years before I even met the man."
    },
    {
      "type": "character",
      "text": "SENATOR PASTORE"
    },
    {
      "type": "dialogue",
      "text": "Fine. What about after?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "After the war, Dr Oppenheimer was the most respected scientific voice in the world. That’s why I asked him to run the Institute, that’s why he advised the Atomic Energy Commission. Simple as that."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss paces-"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "What are they accusing me of?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "I think they just want to know what happened between 1947 and 1954 to change your mind on Oppenheimer’s security clearance."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I didn’t. I was the AEC Chairman, but it wasn’t me who brought the charges against Robert."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Who did?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Some former staff member of the Joint Congressional Committee- INSERT CUT: A YOUNG MAN LEAFS THROUGH A FILE, COLLECTING HIS THOUGHTS... THIS IS WILLIAM BORDEN... HE STARTS TYPING..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "A rabid anti-Communist named Borden. He wrote to the FBI demanding they take action."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  45.45."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "The FBI? Why not come to the AEC direct?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Why get caught holding the knife yourself?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "What did Borden have against Oppenheimer?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "This was the McCarthy era- people hounded out of jobs for any hint of red... reading Oppenheimer’s security file- his Communist brother, sister-in-law, fiancée, best friend, wife... that’s before you even get to the Chevalier incident."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "But how would Borden have access to Oppenheimer’s security file?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Someone gave it to him. Someone who wanted Oppenheimer silenced."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Who?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Who knows? Robert didn’t take care not to upset the power brokers in Washington. His opinions on the atom became definitive and he wasn’t always patient with us mere mortals. I came in for plenty of harsh treatment. There was an AEC vote on the export of isotopes to Norway..."
    },
    {
      "type": "scene-heading",
      "text": "INT. CONGRESSIONAL HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Oppenheimer sits at the witness table with Joe VOLPE, the AEC lawyer. Strauss is in the audience."
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "They drafted in Robert to make me look like a fool..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  46.46."
    },
    {
      "type": "character",
      "text": "CONGRESSMAN"
    },
    {
      "type": "dialogue",
      "text": "But, Dr Oppenheimer, one member of the AEC board thinks these isotopes could be useful to our enemies in the production of atomic weapons."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Congressman, you could use a shovel in making atomic weapons, in fact, you do. You could use a bottle of beer in making atomic weapons. In fact, you do. LAUGHTER. Strauss squirms, embarrassed."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Isotopes aren’t as useful as electronic components, but more useful than a sandwich. I’d put them somewhere in between. Volpe looks at Strauss, who SMILES, GOOD-HUMOURED..."
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Genius is no guarantee of wisdom. How could this man who saw so much be so blind?"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. OPPENHEIMER HOUSE, BERKELEY -- NIGHT (COLOUR)"
    },
    {
      "type": "action",
      "text": "I come in. The lights are off. A BABY’S CRIES echo..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Kitty? She is in the dining room, in the dark, drink in hand."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Kitty, the project- I’m in. She sips. SLIDES her drink down the table at me-"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Let’s celebrate. As the baby CRIES, Kitty comes to me, pulling at my clothes-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Don’t you need to go to him?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  47.47."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "I’ve been going to him all fucking day... She moves to kiss my neck- I look upstairs- she PUSHES me away- GRABS her drink... EXT./INT. CHEVALIER HOUSE -- NIGHT I carry the crying infant, PETER, to the front door. Knock. Barbara opens it- sees my distraught face and takes Peter."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM, CHEVALIER HOUSE -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "Chevalier hands me a drink. I stare into the liquid."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m ashamed to ask."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Anything."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Take Peter."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Sure."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No, for a while, Hoke. A while."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Does Kitty know you’re here?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(I laugh)"
    },
    {
      "type": "dialogue",
      "text": "Of course she fucking knows! We’re awful. Selfish, awful people..."
    },
    {
      "type": "parenthetical",
      "text": "(I down drink)"
    },
    {
      "type": "dialogue",
      "text": "Forget I asked- Chevalier puts out a hand to stop me rising..."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Robert, you see beyond the world we live in. There’s a price to be paid for that. Of course we’ll help."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  48.48."
    },
    {
      "type": "scene-heading",
      "text": "EXT. NEW MEXICO -- EVENING"
    },
    {
      "type": "action",
      "text": "Kitty and I GALLOP through the trees, EMERGING into the twilight overlooking a valley. Kitty turns to the wind."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Everything’s changing, Robert. OPPENHEIMER Having a child was always- KITTY (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(impatient)"
    },
    {
      "type": "dialogue",
      "text": "The world is pivoting in some new direction... reforming... this is your moment. OPPENHEIMER (CONT’D) We’re putting together a KITTY (CONT’D) group to study feasibility- 'We' shouldn’t be doing anything. You should. Lawrence won’t get this done. Or Tolman, or Rabi. You will."
    },
    {
      "type": "scene-heading",
      "text": "INT. PRESIDENT’S DINING HALL, BERKELEY -- DAY"
    },
    {
      "type": "action",
      "text": "A crowded and lavish lunch. I notice a large man in ARMY UNIFORM, Colonel GROVES, sitting next to another soldier (NICHOLS) with Bush and Tolman. I sidle up to Lawrence at the buffet."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Who’s the uniform? The husky GROVES spills sauce on his tunic, wipes at it."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "I thought you might know."
    },
    {
      "type": "scene-heading",
      "text": "INT. CLASSROOM, BERKELEY -- AFTERNOON"
    },
    {
      "type": "action",
      "text": "I am working. Groves and Lieutenant Colonel NICHOLS enter."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer. I’m Colonel Groves, this is Lieutenant Colonel Nichols. Groves pulls off his uniform jacket, TOSSES it to Nichols."
    },
    {
      "type": "character",
      "text": "GROVES (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Get that dry-cleaned. I watch Nichols leave."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  49.49."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "If that’s how you treat a lieutenant colonel, I’d hate to see how you treat a humble physicist."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "If I ever meet one I’ll let you know."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Ouch."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Theatres of combat all over the world- but I have to stay in Washington."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Why?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I built the Pentagon. The brass likes it so much they made me take over the Manhattan Engineer District."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Which is?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Don’t be a smart-ass. You know damn well what it is- you and half of every physics department across America. That’s problem number one."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I thought problem number one would be securing enough uranium ore."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Twelve hundred tons. Bought the day I took charge."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Processing?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Just broke ground at Oak Ridge, Tennessee. Now I’m looking for a project director."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "And my name came up."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  50.50."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Nope. Even though you brought quantum physics to America. That made me curious."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "What have you found out?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "You’re a dilettante, womanizer, suspected Communist-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m a New Deal Democrat-"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I said 'suspected'. Unstable, theatrical, egotistical, neurotic."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Nothing good? Not even 'he’s brilliant, but'...?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Brilliance is taken for granted in your circles. So, no. Only one person said anything good- Richard Tolman. He thinks you’ve got integrity. But Tolman strikes me as someone who knows science better than people."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Yet here you are. You don’t take much on trust."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I don’t take anything on trust. Why don’t you have a Nobel Prize?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Why aren’t you a general?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "They’re making me one for this."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Maybe I’ll have the same luck."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "A Nobel Prize for making a bomb?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Alfred Nobel invented dynamite."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  51.51."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "So how would you proceed?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You’re talking about turning theory into a practical weapons system faster than the Nazis."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Who have a twelve-month head start."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Eighteen."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "How could you possibly know that?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Our fast neutron research took six months- the man they’ve undoubtedly put in charge will have made that leap instantly."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Who do you think they put in charge?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Werner Heisenberg. He has the most intuitive understanding of atomic structure I’ve ever seen."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "You know his work?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I know him. Just like I know Walther Bothe. Von Weizsäcker. Diebner. In a straight race, the Germans win. We’ve got one hope."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Which is?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Anti-Semitism."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "What?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Hitler called quantum physics 'Jewish science'. Said it right to Einstein’s face."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  52.52."
    },
    {
      "type": "character",
      "text": "OPPENHEIMEROPPENHEIMER  (CONT(CONT’D)’D)"
    },
    {
      "type": "dialogue",
      "text": "Our one hope is that Hitler’s so blinded by hate he’s denied Heisenberg proper resources. Because it’ll take vast resources. Our nation’s best scientists, working together- right now they’re scattered."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Which gives us compartmentalization."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "All minds have to see the whole task to contribute efficiently. Poor security may cost us the race, inefficiency will. The Germans know more than us, anyway."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "The Russians don’t."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Remind me- who are we at war with?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Someone with your past doesn’t want to be seen downplaying the importance of security from our Communist allies."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Point taken. But no."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "You don’t get to say 'no' to me-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s my job to say 'no' to you when you’re wrong-"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "So you’ve got the job, now?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m considering it."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I’m starting to see how you got your reputation. My favorite response? 'Oppenheimer couldn’t run a hamburger stand.'"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  53.53."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I couldn’t. But I can run the Manhattan Project. I turn to the blackboard. Take up my chalk."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "There’s a way to balance these things..."
    },
    {
      "type": "parenthetical",
      "text": "(I draw)"
    },
    {
      "type": "dialogue",
      "text": "Leave the Rad Lab here at Berkeley under Lawrence, Met Lab in Chicago under Szilard, large-scale refining- where’d you say? Tennessee... all America’s industrial might and scientific innovation, connected by rail... focused on one goal, one point in space and time, coming together... here. I have drawn a cross at the centre of the diagram."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "And where’s that? INSERT CUT: A BARBED-WIRE FENCE IS STRUNG OUT..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "A secret labouratory. In the middle of nowhere. Self-sufficient. Secure. Equipment, housing, the works. We keep everyone there till it’s done. INSERT CUT: A SCHOOLHOUSE IS ERECTED. A CHURCH. A STORE..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "It’ll need a school, stores, a church..."
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, BERKELEY TO WASHINGTON, DC -- DAY"
    },
    {
      "type": "action",
      "text": "I talk to Groves as Nichols looks on..."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Why?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  54.54."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "If we don’t let scientists bring their families, we’ll never get the best. You want security? Build a town, and build it fast."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Where?"
    },
    {
      "type": "scene-heading",
      "text": "EXT. CAR, LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Groves emerges, squinting into the brightness, taking in the stark beauty. I greet him, arms spread wide."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Welcome to Los Alamos. There’s a boys’ school we’ll have to commandeer, and the local Indians come up here for burial rites. Other than that, nothing for forty miles any direction. And south- east, hundreds of miles of desert. Enough to find the perfect spot."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "For?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Success. Groves scans the horizon. Sniffs the air... turns to Nichols."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Build him a town. Fast."
    },
    {
      "type": "parenthetical",
      "text": "(to Oppenheimer)"
    },
    {
      "type": "dialogue",
      "text": "Let’s go recruit some scientists."
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, SANTA FE TO BOSTON -- NIGHT"
    },
    {
      "type": "action",
      "text": "I watch Groves go over a file."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "How much can I tell them?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "parenthetical",
      "text": "(without looking up)"
    },
    {
      "type": "dialogue",
      "text": "As much as you like, till you feel my boot on your balls."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  55.55."
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, HARVARD -- DAY"
    },
    {
      "type": "action",
      "text": "Groves and I sit talking to BAINBRIDGE and DONALD."
    },
    {
      "type": "character",
      "text": "BAINBRIDGE"
    },
    {
      "type": "dialogue",
      "text": "I’m not a soldier, Oppie."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Soldier? He’s a general-"
    },
    {
      "type": "parenthetical",
      "text": "(jab my thumb at Groves)"
    },
    {
      "type": "dialogue",
      "text": "I got all the soldier I need. Maybe too much. I’m here because you know isotopes, and you-"
    },
    {
      "type": "parenthetical",
      "text": "(to Donald)"
    },
    {
      "type": "dialogue",
      "text": "know explosives better than anyone."
    },
    {
      "type": "character",
      "text": "DONALD"
    },
    {
      "type": "dialogue",
      "text": "But you can’t tell us what you’re doing? I glance at Groves. Then CROSS my legs."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s about unleashing the strong force before the Nazis do."
    },
    {
      "type": "character",
      "text": "BAINBRIDGE"
    },
    {
      "type": "dialogue",
      "text": "Oh my God."
    },
    {
      "type": "scene-heading",
      "text": "INT. CORRIDOR, MIT -- DAY"
    },
    {
      "type": "action",
      "text": "Groves and I walk with CONDON."
    },
    {
      "type": "character",
      "text": "CONDON"
    },
    {
      "type": "dialogue",
      "text": "Why? Why would I leave my family?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I told you, bring your family."
    },
    {
      "type": "character",
      "text": "CONDON"
    },
    {
      "type": "dialogue",
      "text": "Why would we go to the middle of nowhere for who knows how long?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "A year or two. Or three."
    },
    {
      "type": "character",
      "text": "CONDON"
    },
    {
      "type": "dialogue",
      "text": "Why would you think I’d do that? Groves SNAPS like a bulldog-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  56.56."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Why? Why? How about because this is the most important fucking thing that’s ever happened in the history of the world? How about that? I look at Groves, then SHRUG at Condon."
    },
    {
      "type": "scene-heading",
      "text": "INT. OFFICE, UNIVERSITY OF MICHIGAN -- NIGHT"
    },
    {
      "type": "action",
      "text": "Groves and I sit across the desk from a CONCERNED SCIENTIST."
    },
    {
      "type": "character",
      "text": "CONCERNED SCIENTIST"
    },
    {
      "type": "dialogue",
      "text": "Robert, I hear you. I hear you. Concerned Scientist GLANCES at Groves then DROPS his gaze."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "General, could you give us a minute? Groves looks at me. Gets up and goes."
    },
    {
      "type": "character",
      "text": "CONCERNED SCIENTIST"
    },
    {
      "type": "dialogue",
      "text": "They’re not gonna let someone like me onto this project. And failing a security check isn’t gonna be good for a career even after the war."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "So you’re a fellow traveler, so what? This is a national emergency. I’ve got some skeletons, and they’ve put me in charge. They need us."
    },
    {
      "type": "character",
      "text": "CONCERNED SCIENTIST"
    },
    {
      "type": "dialogue",
      "text": "Until they don’t."
    },
    {
      "type": "scene-heading",
      "text": "INT. QUADRANGLE, PRINCETON -- DAY"
    },
    {
      "type": "action",
      "text": "Groves and I flank FEYNMAN as he hurries across the quad-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Heisenberg, Diebner, Bothe, Bohr... what do these men have in common?"
    },
    {
      "type": "character",
      "text": "FEYNMAN"
    },
    {
      "type": "dialogue",
      "text": "The greatest minds on atomic theory."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  57.57."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "And?"
    },
    {
      "type": "character",
      "text": "FEYNMAN"
    },
    {
      "type": "dialogue",
      "text": "I don’t know..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The Nazis have them."
    },
    {
      "type": "character",
      "text": "FEYNMAN"
    },
    {
      "type": "dialogue",
      "text": "Niels Bohr is in Copenhagen."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Under Nazi occupation. Did they stop printing newspapers in Princeton?"
    },
    {
      "type": "character",
      "text": "FEYNMAN"
    },
    {
      "type": "dialogue",
      "text": "Niels won’t work for the Nazis."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No. Never. But while they have him, we don’t. So I need you."
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, PRINCETON TO SANTA FE -- NIGHT"
    },
    {
      "type": "action",
      "text": "Groves is napping. I just start talking."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Is there any chance of getting Bohr out of Denmark?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "No dice. I checked with the British. Until we get Allied boots back onto the continent there’s no way. Is he that important? INSERT CUT: BOHR GESTICULATES WITH THE POISONED APPLE."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "How many people do you know who’ve proven Einstein wrong? The train BUMPS. I look out the window, impatient."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "It’d be quicker to take a plane."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "We can’t risk a plane. America needs us."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  58.58."
    },
    {
      "type": "scene-heading",
      "text": "EXT. LOS ALAMOS UNDER CONSTRUCTION -- DAY"
    },
    {
      "type": "action",
      "text": "Dressed in ARMY UNIFORM, I show Rabi and Condon the CHAOTIC SNOWY and MUDDY mesa. CONSTRUCTION CREWS at work. Feynman approaches-"
    },
    {
      "type": "character",
      "text": "FEYNMAN"
    },
    {
      "type": "dialogue",
      "text": "The Harvard guys say the building’s too small for their cyclotron."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(to Condon)"
    },
    {
      "type": "dialogue",
      "text": "Get ’em together with the architects. Condon hurries off with Feynman. Rabi turns to me."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "When’s this place supposed to open?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Two months."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "parenthetical",
      "text": "(shakes head)"
    },
    {
      "type": "dialogue",
      "text": "Robert, you’re the great improviser, but this you can’t do in your head..."
    },
    {
      "type": "scene-heading",
      "text": "INT. CONSTRUCTION CABIN, LOS ALAMOS -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "I draw on the board."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Four divisions- Experimental, Theoretical, Metallurgical, Ordnance."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Who’s running Theoretical?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I am."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "That’s what I was afraid of. You’re spread too thin."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "So you take Theoretical."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "I’m not coming here, Robert."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  59.59."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Why not? Rabi, seldom at a loss for words, is lost for words..."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "You drop a bomb and it falls on the just and the unjust. I don’t wish the culmination of three centuries of physics to be a weapon of mass destruction."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Izzy, I don’t know if we can be trusted with such a weapon, but I know the Nazis can’t. We have no choice."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Well, the second thing you have to do is appoint Hans Bethe to head the Theoretical division."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Wait, what was the first?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Take off that ridiculous uniform- you’re a scientist."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "General Groves is insisting we join."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Tell Groves to shit in his hat. They need us for who we are. So be yourself, only... better."
    },
    {
      "type": "scene-heading",
      "text": "INT. OPPENHEIMER’S OFFICE, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I pull on a jacket. Run a hand through newly shorn close- cropped dark hair. Put on a PORK PIE HAT. Pick up my pipe..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. LOS ALAMOS UNDER CONSTRUCTION -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "I walk the main drag like a SHERIFF, nodding at construction workers as I pass... THE ICONIC J. ROBERT OPPENHEIMER."
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  60.60."
    },
    {
      "type": "scene-heading",
      "text": "INT. RAD LAB, BERKELEY -- DAY"
    },
    {
      "type": "action",
      "text": "I look down onto the bustle of students. Lomanitz looks up and waves- then is ERASED by WHITEWASH as workers COVER the windows... Serber hands me a key."
    },
    {
      "type": "character",
      "text": "SERBER"
    },
    {
      "type": "dialogue",
      "text": "This is the only key. Teller’s here already. Shall I show him in?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No, wait for the others- The door BURSTS OPEN and a stooped, slightly heavy young man shuffles in. This is EDWARD TELLER."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Let’s get started."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Hello, Edward."
    },
    {
      "type": "scene-heading",
      "text": "INT. SAME -- DAY"
    },
    {
      "type": "action",
      "text": "I sit at the front, one long leg tucked under my ass. The scientists include Lawrence, Serber, Teller, BETHE, Condon, Tolman, Feynman, Donald, Bainbridge, NEDDERMEYER and Alvarez."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We’ll work here until the T-section at Los Alamos is finished- I see Teller waving a piece of paper-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Edward, can I get through my summary?"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "This is more important. Teller’s paper is passed around the room, scientists PALING..."
    },
    {
      "type": "character",
      "text": "TELLER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Calculating chain reactions... I found a rather troubling possibility. Hans Bethe hands me the paper, turns to Teller."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  61.61."
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "That can’t be right. Show me how you did your calculations."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Of course. I look up from the paper, grave. Teller watches the ruckus he’s caused with evident satisfaction. Bethe approaches."
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "Oppie, this is fantasy. Teller’s calculations cannot be right."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Do them yourself while I go to Princeton."
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "What for?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "To talk to Einstein."
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "There’s not much common ground between you two."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That’s why I should get his view."
    },
    {
      "type": "scene-heading",
      "text": "EXT. WOODS, PRINCETON, NEW JERSEY -- DAY"
    },
    {
      "type": "action",
      "text": "I walk through the trees, gaining on two figures. The two men turn. One of them is Einstein."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer. Have you met Kurt Gödel? We walk here most days. GÖDEL Trees are the most inspiring structures."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Albert, might I have a word? Einstein senses the gravity. Nods. We leave Gödel staring up at the bare trees."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  62.62."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "Some days Kurt refuses to eat. Even in Princeton, he’s convinced the Nazis can poison his food."
    },
    {
      "type": "scene-heading",
      "text": "EXT. LAKE, INSTITUTE FOR ADVANCED STUDY -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "Einstein and I emerge from the trees. I pull a piece of paper from my breast pocket. Einstein takes it."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "Whose work is this?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Teller’s."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "And what do you take it to mean?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Neutron smashes into nucleus releasing neutrons to smash into other nuclei... INSERT CUT: DARKNESS SPLIT BY GLOWING PARTICLES FIRING INTO EACH OTHER IN AN INCREASINGLY VIOLENT DISPLAY..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Criticality- the point of no return- massive explosive force... but the chain reaction doesn’t stop... Einstein studies the paper... he nods."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "It would ignite the atmosphere. The air around us CATCHES FIRE... THE PLANET EARTH, LONELY IN VAST DARKNESS, IS SUDDENLY ENGULFED IN FIRE."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "When we detonate an atomic device, we might start a chain reaction that destroys the world."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "And here we are, lost in your quantum world of probabilities, but needing certainty."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  63.63."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Can you run the calculations yourself?"
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "About the only thing you and I share is a disdain for mathematics. Who’s working on it at Berkeley?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Hans Bethe."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "He’ll get to the truth."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "And if the truth is catastrophic?"
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "Then you stop. And share your findings with the Nazis, so neither side destroys the world. I turn to leave."
    },
    {
      "type": "character",
      "text": "EINSTEIN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Robert?"
    },
    {
      "type": "parenthetical",
      "text": "(holding out paper)"
    },
    {
      "type": "dialogue",
      "text": "This is yours. Not mine."
    },
    {
      "type": "scene-heading",
      "text": "INT. CORRIDOR, BERKELEY -- DAY"
    },
    {
      "type": "action",
      "text": "I come past the secretaries. Bethe is there, excited."
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "Teller’s wrong- I gesture SILENCE as I unlock the Rad Lab-"
    },
    {
      "type": "scene-heading",
      "text": "INT. RAD LAB, BERKELEY -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Bethe runs to the cabinet- takes out some papers- hands them to me, excited. I start to scan them, GRINNING-"
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "When you narrow Teller’s critical assumptions the real picture emerges-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Bottom line?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  64.64."
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "The chances of an uncontrolled nuclear reaction are near zero."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Near zero?"
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "Oppie, this is good news-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Can you run more calculations?"
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "You’ll get the same answer. Until we actually detonate one of these things, the best assurance you’re going to get is this-"
    },
    {
      "type": "parenthetical",
      "text": "(jabs paper)"
    },
    {
      "type": "dialogue",
      "text": "Near zero."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Theory will take you only so far."
    },
    {
      "type": "scene-heading",
      "text": "INT. OPPENHEIMER HOUSE, BERKELEY -- NIGHT"
    },
    {
      "type": "action",
      "text": "Kitty opens the door to the Chevaliers, finger to her lips - I am holding the sleeping Peter."
    },
    {
      "type": "character",
      "text": "BARBARA"
    },
    {
      "type": "parenthetical",
      "text": "(whispering)"
    },
    {
      "type": "dialogue",
      "text": "So beautiful. We miss him."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Want to adopt?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "She’s kidding. Kitty shakes her head, 'not kidding'. Barbara takes Peter. I lead Chevalier to the kitchen..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "We wanted to see you before we left."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "For parts unknown..."
    },
    {
      "type": "scene-heading",
      "text": "INT. KITCHEN, OPPENHEIMER HOUSE, BERKELEY -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "I mix a tray of martinis. Chevalier watches, distracted."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  65.65."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "You know who I ran into the other day? Eltenton."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The chemist from Shell? Union guy?"
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Yeah. He was moaning about the way we’re handling the war."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "How so?"
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Lack of cooperation with our allies. Apparently, our government isn’t sharing any research with the Russians. He said a lot of scientists think the policy’s stupid. My hands SLOW..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Oh, yeah?"
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Yeah. He mentioned that if anyone had information they wanted to pass on, going around official channels, he could help... I look up at Chevalier. Grave."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That would be treason."
    },
    {
      "type": "character",
      "text": "CHEVALIER"
    },
    {
      "type": "dialogue",
      "text": "Yes, of course. I just thought you should know. We STARE at each other... BANG- Kitty barges in."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Brat’s down- where are the martinis? She sees us having a moment..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "The discussion ended there. I pick up the tray."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  66.66."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Nothing in our long-standing friendship would have led me to believe that Chevalier was actually seeking information; and I was certain he had no idea of the work on which I was engaged. I steal a glance at Robb, then look directly at the board-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "It has long been clear to me that I should have reported this incident at once."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "The Oppenheimer situation highlights the tension between scientists and the security apparatus..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss is at the witness table facing the Senate Committee."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE"
    },
    {
      "type": "dialogue",
      "text": "In hopes of learning how the nominee handled such issues during his time at the AEC, we’ll have a scientist appearing before the Committee."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "parenthetical",
      "text": "(private)"
    },
    {
      "type": "dialogue",
      "text": "Who’re they bringing in?"
    },
    {
      "type": "character",
      "text": "COUNSEL"
    },
    {
      "type": "parenthetical",
      "text": "(private)"
    },
    {
      "type": "dialogue",
      "text": "They haven’t said."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Mr Chairman, if I may? I’m nominated for Commerce Secretary. Why seek the opinion of scientists-"
    },
    {
      "type": "character",
      "text": "CHAIRMAN"
    },
    {
      "type": "dialogue",
      "text": "This is a Cabinet post, Admiral. We seek a wide range of opinion."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  67.67."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I’d like to know the name of the scientist testifying. And I’d like the chance to cross-examine."
    },
    {
      "type": "character",
      "text": "CHAIRMAN"
    },
    {
      "type": "parenthetical",
      "text": "(irritated)"
    },
    {
      "type": "dialogue",
      "text": "This is not a court."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- MOMENTS LATER (B&W)"
    },
    {
      "type": "action",
      "text": "The Senate Aide shows Strauss and Counsel in."
    },
    {
      "type": "character",
      "text": "COUNSEL"
    },
    {
      "type": "dialogue",
      "text": "Lewis, you’re not on trial-"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "So everyone keeps saying."
    },
    {
      "type": "character",
      "text": "COUNSEL"
    },
    {
      "type": "dialogue",
      "text": "You act like a defence attorney, the Committee’s gonna act like a prosecutor."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "parenthetical",
      "text": "(to Senate Aide)"
    },
    {
      "type": "dialogue",
      "text": "A formality, huh?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "No Presidential Cabinet nominee has failed to be confirmed since 1925. This is just how the game is played."
    },
    {
      "type": "character",
      "text": "COUNSEL"
    },
    {
      "type": "dialogue",
      "text": "It’s in the bag, Lewis, so play nice. They bring in a scientist, so what? Strauss gives a wry smile. Remembers- INSERT CUT: STRAUSS APPROACHES EINSTEIN AND OPPENHEIMER- EINSTEIN BLOWS PAST WITHOUT ACKNOWLEDGING STRAUSS..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "You don’t know scientists like I do, counselor. They resent anyone who questions their judgement- especially if you’re not one of them..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  68.68. INSERT CUT: STRAUSS STARES- THE CROWD AT THE ISOTOPES HEARING LAUGHS..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I was chair of the AEC- I’m easy to blame for what happened to Robert."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "We can’t let the Senate think that the scientific community doesn’t support you."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Should we pivot?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "To what?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Embrace it. 'I fought Oppenheimer and the US won'?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "I don’t think we need to go there. Isn’t there anyone we can call who knows what really happened?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Teller."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "He’ll make an impression."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Can you find out the name of the scientist they’ve called?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Probably."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "parenthetical",
      "text": "(to Counsel)"
    },
    {
      "type": "dialogue",
      "text": "We get that name- you call the AEC, find out if he was based in Chicago or Los Alamos during the war."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Why’s that matter?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "If he was in Chicago he worked under Szilard and Fermi, not the cult of Oppie at Los Alamos."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  69.69."
    },
    {
      "type": "character",
      "text": "STRAUSSSTRAUSS  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "Robert built that damn place- he was founder, mayor, sheriff all rolled into one..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "action",
      "text": "INT./EXT. CAR DRIVING THROUGH LOS ALAMOS -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "I DRIVE Kitty and Peter through the 'town'... Kitty STARES at the newly built BASIC WOODEN STRUCTURES..."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "All it needs is a saloon."
    },
    {
      "type": "scene-heading",
      "text": "INT. OPPENHEIMER HOUSE, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I stand in the hall, holding Peter, NERVOUS, as Kitty inspects the house... she pokes her head back in-"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Robert. There’s no kitchen."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Really? We’ll fix that. Don’t worry."
    },
    {
      "type": "scene-heading",
      "text": "EXT. T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I walk Bethe through the security gate."
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "Barbed wire. Guns, Oppie."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We’re at war, Hans."
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I step up to join Serber- throw up a slide. Condon, Neddermeyer, Kistiakowsky, Donald, Tolman, Bainbridge and Feynman, amongst other SCIENTISTS, are in attendance."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Halifax, 1917. A cargo ship carrying munitions exploded in the harbor..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  70.70. INSERT CUT: WOOD AND CONCRETE FRAGMENTS FLY..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "A vast and sudden chemical reaction... INSERT CUT: A SHOCKWAVE DRIFTS ACROSS THE TOPS OF THE CHOPPY WATER..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "The biggest man-made explosion in history. Let’s calculate how much more destructive it would have been with a nuclear, not chemical, reaction. Expressing power in terms of tons of TNT-"
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "But it’ll be thousands."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Then, kilotons. I switch the lights on, step down to let Serber-"
    },
    {
      "type": "character",
      "text": "SERBER"
    },
    {
      "type": "dialogue",
      "text": "Using U-235, the bomb- He sees me wave."
    },
    {
      "type": "character",
      "text": "SERBER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Sorry- the gadget will need a thirty-three-pound sphere, about this size... Serber reaches below the table, brings up a GOLDFISH BOWL-"
    },
    {
      "type": "character",
      "text": "SERBER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Or using plutonium, a ten-pound sphere... He puts a large BRANDY GLASS next to the aquarium."
    },
    {
      "type": "character",
      "text": "SERBER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Here’s the amount of uranium Oak Ridge refined all of last month. Serber drops THREE MARBLES into the bowl. The scientists stare at the almost-empty goldfish bowl."
    },
    {
      "type": "character",
      "text": "SERBER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "The Hanford plant made this much plutonium..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  71.71. He drops TWO MARBLES into the brandy glass."
    },
    {
      "type": "character",
      "text": "SERBER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "If we can enrich these amounts... we need a way to detonate them. Teller is at the back folding a paper plane."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Are we boring you, Edward?"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "parenthetical",
      "text": "(without looking up)"
    },
    {
      "type": "dialogue",
      "text": "Yes."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "May I ask why?"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "We came into this room knowing a fission bomb was possible. Let’s leave it with something new."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Such as?"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "A 'super' atomic bomb. Instead of uranium, or plutonium, we use hydrogen. MURMURS of dissent-"
    },
    {
      "type": "character",
      "text": "TELLER (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(shutting them down)"
    },
    {
      "type": "dialogue",
      "text": "Heavy hydrogen- deuterium. We compact the atoms together under great force and induce a fusion reaction. Not kilotons... megatons. A HUBBUB develops- I process quickly, then-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Hang on. How do you generate enough force to fuse hydrogen atoms? Teller smiles a self-satisfied smile."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "A small fission bomb. GROANS all around..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  72.72."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Well, since you’re going to need one, anyway... can we get back to the business at hand? Teller SHRUGS."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "character",
      "text": "SENATOR BARTLETT"
    },
    {
      "type": "dialogue",
      "text": "Mr Strauss, the isotopes issue wasn’t your most important policy disagreement with Dr Oppenheimer. It was the Hydrogen bomb, wasn’t it?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "We did disagree about the need for an H-bomb programme."
    },
    {
      "type": "character",
      "text": "SENATOR BARTLETT"
    },
    {
      "type": "dialogue",
      "text": "Tell us how that came to pass. As Strauss REMEMBERS we hear a SIREN and we-"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. NEW YORK STREET -- NIGHT (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss is in a car, barreling along behind a POLICE ESCORT-"
    },
    {
      "type": "scene-heading",
      "text": "INT. HOTEL, NEW YORK -- NIGHT (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss and his ASSISTANT rush down the corridor to a door-"
    },
    {
      "type": "scene-heading",
      "text": "INT. HOTEL CONFERENCE ROOM -- NIGHT (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss enters- a table surrounded by AEC members- Oppenheimer is slouched at the table, pipe blazing, Bush presides... Strauss removes his overcoat, revealing a tuxedo..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "What do we know?"
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "One of our B-29s over the north Pacific picked up radiation. Rabi uses a compass to indicate an area on the map..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  73.73."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Do you have the filter papers?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "There’s no doubt what this is."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "The White House says there’s doubt. Oppenheimer begrudgingly slides them over to Strauss."
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "Wishful thinking, I’m afraid."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s an atomic test."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "The Soviets have a bomb? We’re supposed to be years ahead of them. What were you guys doing at Los Alamos? Wasn’t the security tight? OPPENHEIMER Of course it was- you weren’t NICHOLS (O.S.) there, Lewis. Forgive me, doctor... Strauss leans around the FLOWERS in the centre of the table to see who is speaking- Nichols, now a civilian."
    },
    {
      "type": "character",
      "text": "NICHOLS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "But I was there."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. T-SECTION, LOS ALAMOS -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "Condon, Nichols and I watch cars pull up. Groves emerges."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Welcome back."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Progress? INSERT CUT: MARBLES DROP INTO THE GOLDFISH BOWL."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s nice to see you, too."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Meet the British contingent."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  74.74. SCIENTISTS emerge. A THIN YOUNG MAN offers his hand-"
    },
    {
      "type": "character",
      "text": "FUCHS"
    },
    {
      "type": "parenthetical",
      "text": "(German accent)"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer, Klaus Fuchs."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "How long have you been British?"
    },
    {
      "type": "character",
      "text": "FUCHS"
    },
    {
      "type": "dialogue",
      "text": "Since Hitler told me I wasn’t German."
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "Bethe, Teller, Condon, Kistiakowsky, Donald, Bainbridge, Fuchs and Feynman and other scientists listen to-"
    },
    {
      "type": "character",
      "text": "SERBER"
    },
    {
      "type": "dialogue",
      "text": "I call it 'shooting'- we fire a chunk of fissionable material into the larger sphere with enough force to achieve criticality. INSERT CUT: A URANIUM \"BULLET\" IS FIRED INTO A SPHERE-"
    },
    {
      "type": "character",
      "text": "TOLMAN"
    },
    {
      "type": "dialogue",
      "text": "I’ve been thinking about implosion. Explosives around the sphere blast inwards, crushing the material. INSERT CUT: A SPHERICAL ARRAY OF EXPLOSIVES BLASTS INWARD-"
    },
    {
      "type": "character",
      "text": "NEDDERMEYER"
    },
    {
      "type": "dialogue",
      "text": "I’d like to investigate that idea."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ll talk to the Ordinance division- we’ll get you blowing things up..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. \"MAIN STREET\", LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "Condon, Nichols and I show Groves the GROWING TOWN..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "School’s up and running. I thought of a way to reduce support staff... I open the door to the cabin containing my office-"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  75.75."
    },
    {
      "type": "scene-heading",
      "text": "INT. OUTER OFFICE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Groves notices the YOUNG WOMAN working behind the desk-"
    },
    {
      "type": "scene-heading",
      "text": "INT. OPPENHEIMER’S OFFICE, LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "I slump into my chair. Groves is perplexed-"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Is that...?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Mrs Serber. I’ve offered jobs to all the wives. Admin, librarians, computation. We cut down on staff and keep families together."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Are these women qualified?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Don’t be absurd. These are some of the brightest minds in our community."
    },
    {
      "type": "character",
      "text": "CONDON"
    },
    {
      "type": "dialogue",
      "text": "And they’re already security cleared."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "I’ve informed General Groves you’ve been holding cross-divisional open discussions- GROVES Shut ’em down. CONDON Compartmentalization is the It’s only the top men. key to maintaining security-"
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "Who, presumably, communicate with subordinates."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "These men aren’t stupid, they can be discreet."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I don’t like it."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You don’t like anything enough for there to be a fair test."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  76.76. Groves shrugs. Gets up to leave. Nichols rolls his eyes."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Once a week. Top men only."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’d like to bring my brother here."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "No. Groves and Condon leave- I corner Nichols-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I still haven’t heard that my security clearance has been approved."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "It hasn’t."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We’re going to Chicago tomorrow-"
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "You should wait."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You’re aware that the Nazis have a two-year head start?"
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer, the fact that your security clearance is proving difficult to obtain is not my fault. It’s yours."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It may not be your fault, but it’s your problem. Because I’m going."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. HOTEL CONFERENCE ROOM -- NIGHT (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss reaches to the centre of the table to move the flowers from between him and Nichols-"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "How many people were in the open discussions?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  77.77."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "Too many. Compartmentalization was supposed to be the protocol."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We were in a race against the Nazis-"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Well, now the race is against the Soviets."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Only if we start it. Strauss holds up the filter papers."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Robert, they just fired the starting gun. What’s the nature of the device they detonated?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The data indicates it may have been a plutonium implosion device."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Like the one you built at Los Alamos? Oppenheimer nods reluctantly..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "If the Soviets have a bomb, Truman needs to know what’s next. Bush nods. Oppenheimer looks incredulous-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "What’s next? Arms talks. Obviously."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "parenthetical",
      "text": "(to Bush)"
    },
    {
      "type": "dialogue",
      "text": "What about the Super? Does Truman even know about it?"
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "Not specifically."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We still don’t know if a Hydrogen bomb is technically feasible."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  78.78."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "My understanding is that Teller first proposed it at Los Alamos."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "His designs have always been wildly impractical. You’d have to deliver by ox-cart not airplane."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "If it could put us ahead again, Truman needs to know about it. And if there’s a possibility that the Russians know about it from a spy at Los Alamos... we’ve gotta get going."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "There’s no proof there was a spy at Los Alamos. Strauss holds up the filter papers, raises his eyebrows..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. FOOTBALL STADIUM, CHICAGO -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "Condon and I are led across the field by J. Ernest WILKINS..."
    },
    {
      "type": "character",
      "text": "CONDON"
    },
    {
      "type": "dialogue",
      "text": "They put it under the football stadium?"
    },
    {
      "type": "character",
      "text": "WILKINS"
    },
    {
      "type": "dialogue",
      "text": "The field’s not in use, anymore."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Just as well."
    },
    {
      "type": "scene-heading",
      "text": "INT. ATOMIC PILE, UNDERNEATH THE STADIUM, CHICAGO -- DAY"
    },
    {
      "type": "action",
      "text": "Wilkins shows us to SZILARD and FERMI. A scientist with GLASSES takes notes. The group approaches the atomic pile..."
    },
    {
      "type": "character",
      "text": "FERMI"
    },
    {
      "type": "dialogue",
      "text": "I hear you’ve got a little town."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Come and see."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  79.79."
    },
    {
      "type": "character",
      "text": "SZILARD"
    },
    {
      "type": "dialogue",
      "text": "Who could think straight in a place like that? Everybody will go crazy."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Thanks for the vote of confidence, Szilard. I spot Glasses SCRIBBLING - I GRAB his pen- he FLINCHES-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "We really need that in the notes?"
    },
    {
      "type": "parenthetical",
      "text": "(to Fermi)"
    },
    {
      "type": "dialogue",
      "text": "When are you going to try it out?"
    },
    {
      "type": "character",
      "text": "FERMI"
    },
    {
      "type": "dialogue",
      "text": "We already did. The first self- sustaining nuclear chain reaction. Didn’t Groves tell you?"
    },
    {
      "type": "scene-heading",
      "text": "EXT. T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "Condon and I have just passed through-"
    },
    {
      "type": "character",
      "text": "HORNIG"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer! I tried personnel. We turn to see a twenty-three-year-old young woman on the other side of the barrier. This is Lilli HORNIG."
    },
    {
      "type": "character",
      "text": "HORNIG (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "They asked if I could type."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Can you?"
    },
    {
      "type": "character",
      "text": "HORNIG"
    },
    {
      "type": "dialogue",
      "text": "Harvard forgot to teach that on the graduate chemistry course. I smile at this. Turn to Condon."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Put Mrs Hornig on the plutonium team."
    },
    {
      "type": "scene-heading",
      "text": "INT. CYCLOTRON BUILDING, LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Condon and I peer up at the equipment. Groves STORMS in-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  80.80."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "What the hell were you doing in Chicago?! CONDON Visiting the Met Lab- GROVES (CONT’D) Why?! Condon looks at me. I say nothing. He turns to Groves- CONDON (CONT’D) You can’t talk to us like GROVES (CONT’D) this. We have every right- You have just the rights I give you! No more, no less."
    },
    {
      "type": "character",
      "text": "CONDON (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "This is ridiculous- we’re adults, trying to run a project here."
    },
    {
      "type": "parenthetical",
      "text": "(to me)"
    },
    {
      "type": "dialogue",
      "text": "Tell him, Robert. I look steadily at Groves."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Compartmentalization is the protocol we agreed to."
    },
    {
      "type": "character",
      "text": "CONDON"
    },
    {
      "type": "dialogue",
      "text": "You’ve got to be kidding me. Enough of this madhouse- nobody can work under these conditions."
    },
    {
      "type": "parenthetical",
      "text": "(to Groves)"
    },
    {
      "type": "dialogue",
      "text": "You know what, Generalissimo? I quit."
    },
    {
      "type": "parenthetical",
      "text": "(to Oppenheimer)"
    },
    {
      "type": "dialogue",
      "text": "Thanks for nothing. Condon storms out. Groves turns to me."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Better off without him."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Aren’t you more worried about his discretion out there?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "We'll have him killed."
    },
    {
      "type": "parenthetical",
      "text": "(off Oppenheimer’s look)"
    },
    {
      "type": "dialogue",
      "text": "Kidding. He hates me, not America."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Not everyone has levers like mine to pull."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  81.81."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I don’t know what you mean."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You didn’t hire me despite my left- wing past, you hired me because of it. So you could control me."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I’m not that subtle. I’m just a humble soldier."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You’re neither humble, nor 'just' a soldier. You studied engineering at MIT."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Guilty as charged."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Now that we understand each other, perhaps you’ll get me my security clearance, so I can perform this miracle for you. General Groves looks at me. Nods."
    },
    {
      "type": "character",
      "text": "GARRISON (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "General Groves, were you aware of Dr Oppenheimer’s left-wing associations when you appointed him?"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "Groves, in CIVILIAN CLOTHES, testifies. I watch..."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I was aware that there were suspicions about him... I was aware that he had a very extreme liberal background."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "In your opinion, would he ever consciously commit a disloyal act?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I would be amazed if he did."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  82.82."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "You had complete confidence in his integrity?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "At Los Alamos, yes, which is where I really knew him."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "General, did your security officers on the project advise against the clearance of Dr Oppenheimer?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Truer to say they could not and would not clear him. Until I insisted..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "You became pretty familiar with the security file on Dr Oppenheimer?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I did."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "General, there’s really only one question we need answered here today... Groves shifts, knowing what’s about to be asked..."
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "In the light of your experience of security matters and knowledge of the file..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I greet Lawrence and Lomanitz as they get out of a car-"
    },
    {
      "type": "character",
      "text": "ROBB (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...would you clear Dr Oppenheimer today?"
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Physics and New Mexico, huh? But my God, what a trek."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That’s why you need a liaison."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  83.83."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "I’m appointing Lomanitz. I pat Lomanitz on the shoulder."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You’re gonna be okay."
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, T-SECTION, LOS ALAMOS -- LATER"
    },
    {
      "type": "action",
      "text": "As the group assembles, General Groves speaks to Lawrence."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I’ll remind you what we talked about in Berkeley, doctor."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Compartmentalization. I understand completely. Oppenheimer theatrically drops three marbles into the quarter- full goldfish bowl, then ADDS TWO MORE- the room APPLAUDS. Oppenheimer BOWS, steps down. Lawrence BOUNCES up-"
    },
    {
      "type": "character",
      "text": "LAWRENCE (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Greetings from Berkeley. I’m here to update you on our progress and solicit your input. To do so I will be sharing many things that General Groves has told me not to"
    },
    {
      "type": "parenthetical",
      "text": "(to Groves)"
    },
    {
      "type": "dialogue",
      "text": "Well, General, I said I 'understood', not that I agreed. So, to business... Groves looks at me. I shrug. He leaves."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. HOTEL CONFERENCE ROOM -- NIGHT (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss places the filter papers back down on the table..."
    },
    {
      "type": "action",
      "text": "STRAUSS There were rumours of OPPENHEIMER espionage at Los Alamos- Unsubstantiated-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  84.84. STRAUSS (CONT’D) I’ve heard there were OPPENHEIMER (CONT’D) Communists on the project- We didn’t knowingly employ were any of them involved any Communists. with discussions of the Super?"
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "I seem to remember you demanding that your brother come to Los Alamos."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "He’d left the Party by then."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "And Lomanitz?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "He was never employed at Los Alamos, he was a liaison. Our security was tight, as former Colonel Nichols well knows."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "Our security was the tightest we could make it given the personalities involved. But attempts were made. Doctor, we’ve all read your file here. Do we need to talk about Jean Tatlock? Or the Chevalier incident? Strauss watches Oppenheimer glare at Nichols."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. OPPENHEIMER’S OFFICE, LOS ALAMOS -- DAY (COLOUR)"
    },
    {
      "type": "character",
      "text": "SECRETARY"
    },
    {
      "type": "parenthetical",
      "text": "(over intercom)"
    },
    {
      "type": "dialogue",
      "text": "That’s Lomanitz on one... I pick up the phone-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Lomanitz? Okay, hang on, calm down."
    },
    {
      "type": "scene-heading",
      "text": "INT. COLONEL NICHOLS’ OFFICE -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "I stand at Nichols’ desk."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  85.85."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "There’s been another screw-up- Lomanitz just got drafted."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "We are at war, doctor."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Don’t be an asshole, Nichols. We need this kid. Fix it, will you?"
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "It wasn’t a mistake. Your friend Lomanitz has been trying to unionize the Radiation Lab."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "He promised to quit all that."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "Well, he hasn’t. The security officer at Berkeley is concerned about Communist infiltration through that union- the... F-A..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(thinking)"
    },
    {
      "type": "dialogue",
      "text": "F-A-E-C-T. I’m there next week, maybe I’ll drop in to see him. Nichols TOSSES a security pass across the desk."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "Your Q clearance came through. It’s important you not maintain or renew any questionable associations."
    },
    {
      "type": "character",
      "text": "ROBB (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Doctor, did you think social contacts between a person employed on secret war work and Communists was dangerous?"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "I testify, Kitty behind me..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "My awareness of the danger would be greater today."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  86.86."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "But it’s fair to say that during the war years..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. HOTEL, SAN FRANCISCO -- DAY"
    },
    {
      "type": "action",
      "text": "A TAXI pulls up. I get out, carrying a bag."
    },
    {
      "type": "character",
      "text": "ROBB (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...you felt that such contacts were potentially dangerous? I enter, without seeing a CAR FOLLOWING. The PASSENGER jumps out, while the DRIVER checks the time, makes a note."
    },
    {
      "type": "scene-heading",
      "text": "INT. HOTEL LOBBY, SAN FRANCISCO -- CONTINUOUS"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Were conceivably dangerous. I move to the elevators, watched by the passenger."
    },
    {
      "type": "scene-heading",
      "text": "INT. CORRIDOR, HOTEL, SAN FRANCISCO -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "At the door to 805 I reach into my bag..."
    },
    {
      "type": "character",
      "text": "ROBB (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Really? Known Communists? ...and remove a small BUNCH OF FLOWERS. I knock..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Look, I’ve had a lot of secrets in my head a long time. It doesn’t matter who I associate with... The door opens to reveal JEAN TATLOCK."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION - DAY"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT'D)"
    },
    {
      "type": "dialogue",
      "text": "I don’t talk about those secrets."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 805, HOTEL, SAN FRANCISCO -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Tatlock GRABS the flowers. As I follow her in, she DUMPS them in the wastebasket..."
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  87.87."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "Robb refers to his papers- Kitty watches..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "You said in your statement you 'had' to visit Jean Tatlock in 1943..."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 805, HOTEL, SAN FRANCISCO -- NIGHT"
    },
    {
      "type": "action",
      "text": "Tatlock and I sit across the room from each other, naked."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "You left. Not a word. What did you think that would do to me?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I wrote."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Pages of nothing. Where’d you go?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I can’t tell you."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "Why not?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Because you’re a Communist."
    },
    {
      "type": "character",
      "text": "ROBB (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Why did you have to see her?"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "I sit at the table, self-conscious, testifying..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "She had indicated a great desire to see me before we left. At that time I couldn’t. But I felt that she had to see me... Kitty watches me testify. I am NAKED..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "She was undergoing psychiatric treatment. She was extremely unhappy."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  88.88."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Did you find out why she had to see you?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Because she was still in love with me. Kitty watches Tatlock, also naked, STRADDLE me, head on my shoulder, facing Kitty..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "You spent the night with her didn’t you? As Tatlock GRINDS on me she locks eyes with Kitty..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Yes."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 805, HOTEL, SAN FRANCISCO -- NIGHT"
    },
    {
      "type": "action",
      "text": "Tatlock studies me from across the room."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "You drop in and out of my life and don’t have to tell me why. That’s power."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Not that I enjoy. I’d rather be here for you as you need."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "But now you’ve got other priorities."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I have a wife and child."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "That’s not what either of us is talking about."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Jean, you asked me to come. And I’m glad I did. But I can’t come again."
    },
    {
      "type": "character",
      "text": "TATLOCK"
    },
    {
      "type": "dialogue",
      "text": "What if I need you? I slowly shake my head."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  89.89."
    },
    {
      "type": "character",
      "text": "TATLOCK (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Not a word?"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "All eyes on me, clothed and alone again..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Did you think that consistent with good security? Behind me, Kitty’s face is stone..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It was, as a matter of fact. Not a word."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "When did you see her after that? INSERT CUT: HOT BATH RUNNING. PILL BOTTLE. DOWNTURNED HEAD IN THE WATER. THE SOUND OF FEET STAMPING, STAMPING... I JAM my eyes closed, shake off the image-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I never saw her again."
    },
    {
      "type": "scene-heading",
      "text": "INT. SAME -- DAY"
    },
    {
      "type": "action",
      "text": "As the room breaks up, Kitty speaks privately to me through CLENCHED TEETH as she gathers her things. No eye contact."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "I can make the last train back to Princeton."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I said nothing that I hadn’t already said to you, Kitty."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Well, today you said it to history."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "This is a closed hearing-"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "If they don’t release a transcript, you will!"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  90.90. She DROPS her bag, spilling the contents. Garrison spots a small FLASK as Kitty sweeps it into her purse. I CROUCH-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I was under oath."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "You were under an oath to me when you went to see Jean. She STANDS- I follow- she TURNS back- in my face-"
    },
    {
      "type": "character",
      "text": "KITTY (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You sit there, day after day, letting them pick our lives to pieces. Why won’t you fight? I don’t answer. She leaves. Garrison steps up."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Robert, I’m not putting her up there."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BERKELEY CAMPUS -- DAY"
    },
    {
      "type": "action",
      "text": "I stroll across the campus, enter an administrative building."
    },
    {
      "type": "scene-heading",
      "text": "INT. LT. JOHNSON’S OFFICE -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "I knock. Johnson opens the door, SURPRISED."
    },
    {
      "type": "character",
      "text": "JOHNSON"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer, it’s an honour. Please, take a seat-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No need. I just wanted to check whether I should talk to Lomanitz while I’m here- given your concerns."
    },
    {
      "type": "character",
      "text": "JOHNSON"
    },
    {
      "type": "dialogue",
      "text": "That’s up to you, really, professor. But I’d be cautious."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Understood. Oh, and as far as the union goes, I wanted to give you a heads up on a man named Eltenton."
    },
    {
      "type": "character",
      "text": "JOHNSON"
    },
    {
      "type": "dialogue",
      "text": "A heads up?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  91.91."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "He might merit watching, is all."
    },
    {
      "type": "character",
      "text": "JOHNSON"
    },
    {
      "type": "dialogue",
      "text": "I’d love to get more details-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ve got an appointment now, and I leave early tomorrow-"
    },
    {
      "type": "character",
      "text": "JOHNSON"
    },
    {
      "type": "dialogue",
      "text": "Come as early as you like. Since you haven’t time now."
    },
    {
      "type": "character",
      "text": "GROVES (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "You went back the next morning?"
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, SANTA FE TO CHICAGO -- DAY"
    },
    {
      "type": "action",
      "text": "Groves sits opposite. I stare out the window."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I did. I had to, really."
    },
    {
      "type": "scene-heading",
      "text": "INT. LT. JOHNSON’S OFFICE -- MORNING"
    },
    {
      "type": "action",
      "text": "Johnson smiles, beckons me in. Indicates a SECOND MAN-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "This time there was another man."
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, SANTA FE TO CHICAGO -- DAY"
    },
    {
      "type": "action",
      "text": "I stare out the window. Groves sits opposite."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Said his name was Pash."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Pash? You met Colonel Pash?"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "Alone on the couch, I glance up, NERVOUS, as a man in uniform walks past. As he sits, I study the back of his head."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Colonel Pash, can you read from your memo of June 29th, 1943?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  92.92."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "'Results of surveillance conducted on subject indicate further possible Communist Party connections. Subject met with and spent considerable time with one Jean Tatlock, Communist, the record of whom is attached.'"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "The subject being Dr Oppenheimer?"
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "Yes."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Whom you had not met?"
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "Not then, but soon after..."
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, SANTA FE TO CHICAGO -- DAY"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "He’s head of security for the project, shouldn’t I know him?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "No, he should know you. I’d never put you in a room with Pash."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Why not?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "When Pash first learned about Lomanitz- he told the FBI he was going to kidnap him, take him out on a boat, interrogate him 'in the Russian manner'..."
    },
    {
      "type": "scene-heading",
      "text": "INT. LT. JOHNSON’S OFFICE -- DAY"
    },
    {
      "type": "action",
      "text": "Pash sits down next to me, opposite Johnson."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  93.93."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer, this is a pleasure. General Groves has placed a certain responsibility in me, and it’s like having a child, that you can’t see, by remote control, so to actually meet you... I don’t mean to take much of your time... The disarming friendliness of the truly dangerous."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Not at all. Whatever time you choose."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "Mr Johnson told me of your conversation yesterday, in which I’m very interested. It had me worried all day..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I didn’t want to talk to Lomanitz without authorization-"
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "That’s not the particular interest I have. It’s something a little more, in my opinion, more serious..."
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, SANTA FE TO CHICAGO -- DAY"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "When the FBI pointed out that such information couldn’t be used in court Pash made it clear that he didn’t intend to have anyone left to prosecute. The FBI talked him down, but that’s the man you’re dancing with."
    },
    {
      "type": "scene-heading",
      "text": "INT. LT. JOHNSON’S OFFICE -- DAY"
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "I gather you’ve heard there are other parties interested in the work of the Radiation Lab..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  94.94."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Well, a man attached to the Soviet Consul indicated, through intermediate people, to people on this project that he was in a position to transmit information they might supply."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "Why would anyone on the project want that?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Frankly, I can see there might be arguments for the commander-in- chief informing the Russians- they’re our allies. But I don’t like the idea of it going out the back door- it might not hurt to be on the lookout for it."
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, SANTA FE TO CHICAGO -- DAY"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "You said that to Pash?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I was trying to put it in the context of... Russia’s not Germany."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Boris Pash is the son of a Russian Orthodox bishop. Born here but in he went back to Russia to fight the Bolsheviks. This is a man who’s killed Communists with his own hands."
    },
    {
      "type": "scene-heading",
      "text": "INT. LT. JOHNSON’S OFFICE -- DAY"
    },
    {
      "type": "action",
      "text": "Pash spreads his palms..."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "I’m not the judge of who should or should not get information. My business is to stop it going through illegally. Could you be a little more specific?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  95.95."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "There’s a man whose name was mentioned to me a couple of times- Eltenton. I think he’s a chemist employed by Shell. He talked to a friend of his who’s an acquaintance of someone on the project. To go beyond that would be to put names down of people who are not only innocent but were one hundred percent cooperative."
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, SANTA FE TO CHICAGO -- DAY"
    },
    {
      "type": "action",
      "text": "Groves is staring at me like I just crapped my pants."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "You thought Pash would be satisfied with that?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I was trying to give them Eltenton without opening a can of worms. I told him a cock-and-bull story."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "I am up front. Robb questioning-"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Did you lie to General Groves, too?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No, I told him I’d lied to Pash."
    },
    {
      "type": "scene-heading",
      "text": "INT. SAME -- DAY"
    },
    {
      "type": "action",
      "text": "Groves is on the stand, in civilian clothes-"
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Do you recall your conversation with him about the Chevalier incident?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I’ve seen so many versions of it, I wasn’t confused before, but I’m certainly getting there now."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "What was your conclusion?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  96.96."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "That he was under the influence of the typical American schoolboy attitude that there’s something wicked about telling on a friend. He did what he thought was essential- disclosing Eltenton."
    },
    {
      "type": "scene-heading",
      "text": "INT. SAME -- DAY"
    },
    {
      "type": "action",
      "text": "Pash is testifying."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "The memo I wrote at the time states 'Dr Oppenheimer sought to provide information to burnish his image as loyal, clearly having heard of our investigation at Berkeley. He is not to be trusted on matters of security.'"
    },
    {
      "type": "scene-heading",
      "text": "INT. LT. JOHNSON’S OFFICE -- DAY"
    },
    {
      "type": "action",
      "text": "Pash gazes, unblinking, into my eyes..."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "These other people you mentioned, were they contacted by Eltenton direct?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "Well now, could we know through whom that contact was made?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It would involve people who ought not be involved in this."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "Is this person a member of the project?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "A member of the faculty, but not on the project."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  97.97."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "Eltenton made the approach through a member of the faculty here at Berkeley?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "As far as I know- there may have been more than one person involved. If I seem uncooperative I think you can understand that it’s because of my insistence in not getting innocent people into trouble. Pash stares at me. I finally keep my mouth shut."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "You see me as persistent-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You are persistent, and that is your job. But my job is protecting the people who work for me."
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "Instead of us going on certain steps which may come to your attention and be a little bit... disturbing to you... I’d rather discuss those with you first. I’m not formulating any plans, I’m just going to have to digest the whole thing. I nod at Pash. Get to my feet."
    },
    {
      "type": "scene-heading",
      "text": "INT. TRAIN, SANTA FE TO CHICAGO -- DAY"
    },
    {
      "type": "action",
      "text": "Groves takes in the story."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "You’re protecting a friend. But who’s protecting you?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You could."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "If you gave me the name."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "If you order me to, I’ll do it."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  98.98."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "You’re making a mistake, Robert. A mistake that may haunt you. You need to volunteer this name. I turn to watch the scenery trundle past."
    },
    {
      "type": "character",
      "text": "ROBB (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "And did he give you the name?"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "He did."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "But not at that time."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "In fact, it was some months later, wasn’t it? Groves nods."
    },
    {
      "type": "scene-heading",
      "text": "INT. SAME -- DAY"
    },
    {
      "type": "action",
      "text": "I study the back of Boris Pash’s head..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "And in the months between your interview with Dr Oppenheimer and his eventual naming of Chevalier, did you expend resources trying to find the identity of the intermediary?"
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "Considerable resources. Without the name our job was extremely difficult."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "When did you receive the name?"
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "I was gone by the time Oppenheimer offered it up."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  99.99."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Gone?"
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "They felt my time would be better spent in Europe determining the status of the Nazi bomb project."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Who did?"
    },
    {
      "type": "character",
      "text": "PASH"
    },
    {
      "type": "dialogue",
      "text": "General Groves. He transferred me to London. I lift my head at this. INSERT CUT: MARBLES DROP INTO THE BOWL... THREE-QUARTERS FULL..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. LOS ALAMOS -- NIGHT"
    },
    {
      "type": "action",
      "text": "Serber and I walk down the street. Snow falling."
    },
    {
      "type": "character",
      "text": "SERBER"
    },
    {
      "type": "dialogue",
      "text": "Little early for a Christmas party."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Something’s up. Tolman’s been away."
    },
    {
      "type": "character",
      "text": "SERBER"
    },
    {
      "type": "dialogue",
      "text": "Where?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Ruth won’t tell. We head towards Fuller Lodge..."
    },
    {
      "type": "scene-heading",
      "text": "INT. FULLER LODGE, LOS ALAMOS -- LATER"
    },
    {
      "type": "action",
      "text": "A CHRISTMAS PARTY. DEBAUCHED. Kitty, in SANTA HAT, serves/spikes the EGGNOG. Bethe, Teller, Charlotte Serber, Neddermeyer, Kistiakowsky, Donald, Hornig, Bainbridge, Fuchs, Feynman amongst the revelers. I have Ruth cornered, glancing over at Kitty, who pretends she wasn’t looking at me and GRABS at the nearest male arm- pushing eggnog..."
    },
    {
      "type": "character",
      "text": "RUTH"
    },
    {
      "type": "dialogue",
      "text": "Compartmentalization, Oppie. What makes you think I know, anyway?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  100.100. I take her glass. Sip from it..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You do a good job of knowing where Mr Tolman is... when it counts."
    },
    {
      "type": "character",
      "text": "RUTH"
    },
    {
      "type": "dialogue",
      "text": "Like now. I turn- Tolman and Groves enter, brushing off snow..."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Atten-shun! We have an early Christmas present for you... They step aside to reveal... NIELS BOHR. I grin."
    },
    {
      "type": "character",
      "text": "BOHR (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "The British pilots put me in the bomb bay..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SAME -- LATER"
    },
    {
      "type": "action",
      "text": "Bohr holds court. I listen at the back."
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "...showed me the oxygen- of course I messed it up. When they opened me up in Scotland I was unconscious. I pretended I’d been napping. The crowd LAUGHS, loving it. Bohr peels off to talk to me."
    },
    {
      "type": "character",
      "text": "BOHR (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Is it big enough?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "To end the war?"
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "To end all war."
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, T-SECTION -- LATER"
    },
    {
      "type": "action",
      "text": "I sip my drink, watching Bohr read the boards. Tolman, Teller, Bethe and Serber sprawl, party hats, TINSEL scarves..."
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "Heisenberg sought me out in Copenhagen. It was chilling- my old student, working for the Nazis."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  101.101."
    },
    {
      "type": "character",
      "text": "BOHRBOHR  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "He told me things to draw me out... sustained fission reactions in uranium..."
    },
    {
      "type": "character",
      "text": "TOLMAN"
    },
    {
      "type": "dialogue",
      "text": "That sounds more like a reactor than a bomb."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Did he mention gaseous diffusion?"
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "He seemed more focused on heavy water."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "As a moderator?"
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "Yes. Instead of graphite. Serber and Tolman GRIN. I nod. Bohr notices us relax..."
    },
    {
      "type": "character",
      "text": "BOHR (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "What?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "He took a wrong turn. We’re ahead. And with you here to help us... Bohr turns to Teller and the others-"
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "Gentlemen, could you give us a moment? They shuffle out. Bohr looks at the MARBLES. Turns to me..."
    },
    {
      "type": "character",
      "text": "BOHR (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I’m not here to help, Robert. I knew you could do this without me."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Then why did you come?"
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "To talk about after. The power you’re revealing will forever outlive the Nazis. And the world is not prepared."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  102.102."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You can lift the rock without being ready for the snake that’s revealed."
    },
    {
      "type": "character",
      "text": "BOHR"
    },
    {
      "type": "dialogue",
      "text": "We have to make the politicians understand- this isn’t a new weapon- it’s a new world. I’ll be out there, doing what I can- but you..."
    },
    {
      "type": "parenthetical",
      "text": "(points at me)"
    },
    {
      "type": "dialogue",
      "text": "You’re an American Prometheus- Father of the Atomic Bomb. The man who gave them the power to destroy themselves. They’ll respect that. And your work really begins. I take this in. Charlotte Serber enters-"
    },
    {
      "type": "character",
      "text": "CHARLOTTE"
    },
    {
      "type": "dialogue",
      "text": "I’m sorry, Oppie, but there’s a call. From San Francisco. I look at my watch, surprised... look at Bohr, who nods 'Go.'"
    },
    {
      "type": "scene-heading",
      "text": "EXT. SNOWY WOODS, LOS ALAMOS -- DAWN"
    },
    {
      "type": "action",
      "text": "Kitty, on horseback, finds my horse, tied up. She dismounts, moving into the trees... She finds me curled up at the base of a tree in the SNOW, distraught."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Robert? She crouches, touches my shoulder- I look up, ASHAMED."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Her father called... they found her yesterday... in the bath... INSERT CUT: A WOMAN, FACE-DOWN IN THE BATH, A CUSHION BELOW..."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Who?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "She’d taken pills, left a note... not signed... she took barbiturates..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  103.103."
    },
    {
      "type": "action",
      "text": "INSERT CUT: TATLOCK KNEELS IN THE BATH, POPPING PILLS. SINKS SERENELY ONTO CUSHIONS UNDER THE WATER..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "But there was chloral hydrate in her blood... INSERT CUT: GLOVED HANDS HOLD TATLOCK’S STRUGGLING HEAD UNDERWATER... I SHAKE OFF the image..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "There was a note."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Jean Tatlock? INSERT CUT: OPPENHEIMER, NAKED, SHAKES HIS HEAD AT TATLOCK."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We were together- she said she needed me... but I told her I wouldn’t see her again. It was me. Kitty SLAPS me in the face. I look up at her, bleary-eyed..."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "You don’t get to commit the sin, then have us all feel sorry for you that it had consequences."
    },
    {
      "type": "parenthetical",
      "text": "(rises)"
    },
    {
      "type": "dialogue",
      "text": "Pull yourself together. People here depend on you."
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I vacantly preside over a shambles- the goldfish bowl is FILLED with marbles. As is the glass tumbler... Donald, Bainbridge, Feynman watch the others squabble-"
    },
    {
      "type": "character",
      "text": "HORNIG"
    },
    {
      "type": "dialogue",
      "text": "Serber, I’m not quitting my job because plutonium’s radioactive!"
    },
    {
      "type": "character",
      "text": "SERBER"
    },
    {
      "type": "dialogue",
      "text": "We can’t know what it might do to your reproductive system- Donald, help me out, here-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  104.104. DONALD You’re on your own, pal. HORNIG"
    },
    {
      "type": "parenthetical",
      "text": "(to Serber)"
    },
    {
      "type": "dialogue",
      "text": "Your reproductive system’s more exposed than mine. Presumably. KISTIAKOWSKY The implosion device is NEDDERMEYER nowhere. You can’t rush everything, Oppie. KISTIAKOWSKY (CONT’D) There’s rushing and there’s BETHE getting on with it- pick one, Teller’s not helping- I’ve will ya? been asking for calculations on the implosion lenses for weeks- TELLER The British can do it- Fuchs- FUCHS Absolutely. BETHE It’s your job, Teller! TELLER (CONT’D) I’m engaged in research-"
    },
    {
      "type": "character",
      "text": "BETHE (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "On a Hydrogen bomb we’re not even building! Teller simply walks away. As he passes me-"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "I won’t work for that man."
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "Let him go. He’s a prima donna-"
    },
    {
      "type": "character",
      "text": "SERBER"
    },
    {
      "type": "dialogue",
      "text": "I agree. He should leave Los Alamos. I sigh. RISE, clear and direct-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Kisty, you replace Neddermeyer. Seth, I’m putting you on plutonium. Lilli, go work for Kisty."
    },
    {
      "type": "parenthetical",
      "text": "(off her look)"
    },
    {
      "type": "dialogue",
      "text": "Because he needs you."
    },
    {
      "type": "parenthetical",
      "text": "(to Fuchs)"
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  105.105."
    },
    {
      "type": "character",
      "text": "OPPENHEIMEROPPENHEIMER  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "Fuchs, take Teller’s role- you’re exclusively on the implosion device. I head for the door-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "And nobody is leaving Los Alamos."
    },
    {
      "type": "scene-heading",
      "text": "EXT. T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "Teller is held at the gate. I approach. We face off in the 'street' like gunslingers."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "They won’t let me leave."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I won’t let you leave. Forget Hans, forget fission. Stay here and research what you want. Fusion. The Hydrogen bomb- whatever. We’ll meet to discuss-"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "You don’t have time to meet. You’re a politician now, Robert. You left physics behind long ago."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Once a week. One hour, you and me. Teller considers this. Nods, turns to the GUARD-"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Now, raise that fucking barrier."
    },
    {
      "type": "character",
      "text": "ROBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "So the Super was under development on your watch at Los Alamos..."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "...yet, after the war, you tried to deny it was viable."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No. I pointed out technical difficulties with it."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  106.106."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Didn’t you try to kill it at the AEC meeting after the Russian bomb test?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "But that was the recommendation the AEC offered, was it not?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "After hours of discussion..."
    },
    {
      "type": "scene-heading",
      "text": "INT. HOTEL CONFERENCE ROOM -- NIGHT (COLOUR)"
    },
    {
      "type": "action",
      "text": "Me, Bush, Nichols (CIVILIAN), Rabi, Fermi, Strauss and others."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...about the best response."
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "Truman has to do something... Rabi opens his compasses wider..."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "An H-bomb would be one thousand times the power of an A-bomb. He draws a circle around Moscow..."
    },
    {
      "type": "character",
      "text": "RABI (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "The only intended target would be the largest cities. And a circle around St Petersburg..."
    },
    {
      "type": "character",
      "text": "RABI (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "It’s a weapon of mass genocide."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Why don’t you draw some of those circles on this side of the map? He points at the USA..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Start here..."
    },
    {
      "type": "parenthetical",
      "text": "(gestures around them)"
    },
    {
      "type": "dialogue",
      "text": "New York."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  107.107."
    },
    {
      "type": "action",
      "text": "As I listen to them I hear the sound of FEET STAMPING..."
    },
    {
      "type": "character",
      "text": "FERMI"
    },
    {
      "type": "dialogue",
      "text": "It’s a weapon of attack, with no defensive value."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Deterrence."
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "Do we need more deterrence than our current arsenal of atomic bombs? I tense up as the STAMPING SOUND gets LOUDER and LOUDER..."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Drown in ten feet of water or ten thousand, what’s the difference? We can already drown Russia, and they know it. INSERT CUT: DOZENS OF FEET STAMPING, FASTER AND FASTER..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Now they can drown us. INSERT CUT:... SO FAST THE FEET BREAK RHYTHM, CAUSING CACOPHONY..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Gentlemen, I have to ask whether your discussion should be more of a technical one. Robert? I JAM my eyes CLOSED, SHAKE OFF the image- the sound STOPS-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Teller’s designs are as impractical as they were during the war."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "The Hydrogen bomb can be made to work, Oppie. You know that."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We can’t commit all our resources to that chance."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Then how would you have Truman reassure the American people?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  108.108."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "By limiting the spread of atomic weapons through international control of nuclear energy."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "World government?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The United Nations. As Roosevelt intended."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I asked what Truman should do. The world’s changed. Communism threatens our survival."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Lewis, if we build a Hydrogen bomb, the Soviets would have no choice but to build their own."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Could they be working on it already? Based on information from a spy at Los Alamos? OPPENHEIMER There was no spy at Los BUSH Alamos! Gentlemen, let’s not get sidetracked."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I say we use this moment to gain concessions from the Russians by committing that we will not build the Hydrogen bomb."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Thereby revealing its existence."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Which you seem convinced they already know."
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "At this point I’d like the Advisory Committee members to meet in privacy to finalize our recommendations. Strauss nods. Rises. Much of the room follows suit, leaving."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  109.109."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I’m not sure you want to go down this road, Robert."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Lewis, we’re the Advisory Committee. We’ll give them our advice. Strauss shrugs. As he, Lawrence and Nichols leave together, Borden approaches."
    },
    {
      "type": "character",
      "text": "BORDEN"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer? William Borden- Joint Committee on Atomic Energy."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Oh, yes."
    },
    {
      "type": "character",
      "text": "BORDEN"
    },
    {
      "type": "dialogue",
      "text": "During the war, I was a pilot. One night, flying back from a raid, I saw an amazing sight- like a meteor- INSERT CUT: BORDEN SPEEDS THROUGH THE NIGHT..."
    },
    {
      "type": "character",
      "text": "BORDEN (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "A V-2 rocket heading for England- INSERT CUT: A ROCKET STREAKS PAST, RIPPING APART THE DARK..."
    },
    {
      "type": "character",
      "text": "BORDEN (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "I can’t help but imagine what it will be for such an enemy rocket to carry an atomic warhead... INSERT CUT: A MISSILE RISES THROUGH THE CLOUDS... I hear the sound of FEET STAMPING... INSERT CUT: DOZENS OF FEET STAMPING FASTER AND FASTER... I peer into the future... INSERT CUT: HUNDREDS OF MISSILES RISE THROUGH THE CLOUDS... I look at the map... Rabi’s circles EXPAND like raindrops in a puddle..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  110.110."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Then let’s make sure we’re not the ones to make that possible. But that’s not the answer Borden wanted. He leaves. Fermi and Bush remain. Rabi leans over to me."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Oppie, you don’t want to go up against Strauss."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "If we both speak, they listen to me."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "When you speak, they hear a prophet. When Strauss speaks, they hear themselves."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "They’ll listen to a prophet."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "A prophet can’t be wrong. Not once."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Didn’t you accuse Oppenheimer of sabotaging the development of the Super?"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss shifts uneasily in his chair."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I was never one of those who bandied around terms like 'sabotage'."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE"
    },
    {
      "type": "dialogue",
      "text": "But Mr Borden was?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "As I understand it."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE"
    },
    {
      "type": "dialogue",
      "text": "How was Mr Borden able to put together such a detailed indictment?"
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  111.111."
    },
    {
      "type": "character",
      "text": "SENATORSENATOR  MCGEEMCGEE  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "He was no longer a government employee, and yet he appears to have had unlimited access to Dr Oppenheimer’s file. Might Mr Nichols have given him access to the file? Or someone else at the AEC?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Feelings ran high on these issues, but that’s a very serious accusation, Senator."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. LOS ALAMOS -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "RAIN. I ride my horse through the outskirts. Spot a FLIER stapled to a telegraph pole, ink running: \"THE IMPACT OF THE GADGET ON CIVILIZATION - DISCUSSION, BLDG T31 SUNDAY, 11AM\"."
    },
    {
      "type": "scene-heading",
      "text": "INT. CYCLOTRON BUILDING, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I enter to find forty scientists meeting. Hornig is speaking."
    },
    {
      "type": "character",
      "text": "HORNIG"
    },
    {
      "type": "dialogue",
      "text": "Germany’s about to surrender, the Japanese are losing. It’s no longer the enemy who are the greatest threat to mankind- it’s us. Our work. Heads turn as they notice me."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Hitler’s dead. But the Japanese fight on. The audience is now turned my way..."
    },
    {
      "type": "character",
      "text": "HORNIG"
    },
    {
      "type": "dialogue",
      "text": "Their defeat seems assured."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Not if you’re a GI preparing to invade Japan. We can end this war."
    },
    {
      "type": "character",
      "text": "MORRISON"
    },
    {
      "type": "dialogue",
      "text": "How can we justify using this weapon on human beings?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  112.112."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We’re theorists- we can imagine a future, and our imaginings horrify us. But they won’t fear it until they understand it, and they won’t understand it until they’ve used it. When the world learns the terrible secret of Los Alamos, our work will ensure a peace mankind has never seen. A peace based on the kind of international cooperation that Roosevelt always envisaged. Some of the scientists nod. Scattered applause... INSERT CUT: THE GOLDFISH BOWL IS FULL OF MARBLES..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I walk down the main drag with Groves."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Progress."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Two years and a billion dollars’ worth?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Hard to put a price on it."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Not really. Just add up the bills."
    },
    {
      "type": "parenthetical",
      "text": "(points)"
    },
    {
      "type": "dialogue",
      "text": "'Rural free delivery'... Eighty babies delivered the first year. This year they’ve had ten a month."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Birth control’s a little out of my jurisdiction, General. Groves watches Kitty approach- she’s HEAVILY PREGNANT."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Clearly."
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  113.113."
    },
    {
      "type": "scene-heading",
      "text": "EXT. CANYON, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "An IMPLOSION DEVICE ROCKS the canyon. Groves, Fuchs and I raise our heads- Kistiakowsky and Hornig rush to the device-"
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY"
    },
    {
      "type": "dialogue",
      "text": "That’s the one! I put my PIPE on the wall as we CLIMB out of the bunker..."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Two viable bombs. I need a date."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "September-"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "July- Kistiakowsky waves a trail of ticker tape-"
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY"
    },
    {
      "type": "dialogue",
      "text": "That’s the sweet spot, gentlemen!"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "August."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "July-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "A test in July. Fuchs hands me my pipe. I dust it off..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "But I need my brother."
    },
    {
      "type": "parenthetical",
      "text": "(off his look)"
    },
    {
      "type": "dialogue",
      "text": "Frank knows the desert. He left politics behind- he’s been working for Lawrence for two years. INSERT CUT: FLYING OVER DESERT TO FIND FRANK STANDING BY A JEEP WITH AN ARMY OFFICER."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "What do we call the test?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(thinking)"
    },
    {
      "type": "dialogue",
      "text": "'Batter my heart, three-person’d god.'"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  114.114."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "What?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Trinity. INSERT CUT: A STEEL TOWER IS RAISED IN THE DESERT..."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "So you insisted on bringing on your brother, Frank, a known Communist-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Former Communist-"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "You brought a known former Communist onto America’s most secret and important defence project?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I knew my brother could be trusted absolutely."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "And you feel your judgement was sound on who on the team could be trusted?"
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Fuchs! Head down!"
    },
    {
      "type": "scene-heading",
      "text": "EXT. BERM -- DAY"
    },
    {
      "type": "action",
      "text": "Behind a berm, Groves, Fuchs, Frank and I watch Kistiakowsky and Hornig arm a detonator. Fuchs shuffles lower."
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY"
    },
    {
      "type": "dialogue",
      "text": "Everybody ready...? Kistiakowsky triggers A VAST EXPLOSION, SPLINTERING THE TOWER, SENDING A MASSIVE PLUME OF FIRE INTO THE AIR... the SHOCKWAVE throws DEBRIS onto me and Groves..."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I hope you learned something."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  115.115."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "We learned we’re gonna need to be a lot further away..."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Well, figure it out. Fast."
    },
    {
      "type": "parenthetical",
      "text": "(to me)"
    },
    {
      "type": "dialogue",
      "text": "We leave for Washington tomorrow, and we’re going to give them a date."
    },
    {
      "type": "scene-heading",
      "text": "INT. HOTEL LOBBY, WASHINGTON, DC -- DAY"
    },
    {
      "type": "action",
      "text": "I walk across the lobby- someone GRABS my arm- Szilard, with the Scientist with Glasses in tow. I glance out the window, where Groves is getting into a car, waiting for me..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You’re a long way from Chicago, Leo."
    },
    {
      "type": "character",
      "text": "SZILARD"
    },
    {
      "type": "dialogue",
      "text": "If we don’t act now, they’re going to use this thing against Japan. We booked a meeting with Truman, but somebody killed it. You’re meeting the Secretary of War-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Just because we’re building it- doesn’t mean we get to decide how it’s used."
    },
    {
      "type": "character",
      "text": "SZILARD"
    },
    {
      "type": "dialogue",
      "text": "History will judge us, Robert. In Chicago we put together a petition- Glasses holds out a paper- I PUSH it back- Glasses FLINCHES-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m not getting into that. Tell me your concerns and I’ll relay them-"
    },
    {
      "type": "character",
      "text": "SZILARD"
    },
    {
      "type": "dialogue",
      "text": "My concerns?! Germany’s defeated, Japan’s not going to hold out alone-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "How would you know? You got us into this, you and Einstein, with your letter to Roosevelt saying we could build a bomb-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  116.116."
    },
    {
      "type": "character",
      "text": "SZILARD"
    },
    {
      "type": "dialogue",
      "text": "Against Germany."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That’s not how weapons manufacture works, Szilard."
    },
    {
      "type": "character",
      "text": "SZILARD"
    },
    {
      "type": "dialogue",
      "text": "Oppie, you have to help. OPPENHEIMER Fermi’s in the meeting. And SZILARD (CONT’D) Lawrence- They’re not you. You’re the great salesman of science- you can convince anyone of anything. Even yourself."
    },
    {
      "type": "scene-heading",
      "text": "INT. SECRETARY OF WAR’S OFFICE -- DAY"
    },
    {
      "type": "action",
      "text": "I sit on a couch next to Fermi- Lawrence, Groves and Bush in chairs. Secretary of War STIMSON presides. Military, scientists and officials are scattered through the room."
    },
    {
      "type": "character",
      "text": "STIMSON"
    },
    {
      "type": "dialogue",
      "text": "The firestorm in Tokyo killed one hundred thousand people. Mostly civilians. I worry about an America where we do these things and no one protests."
    },
    {
      "type": "character",
      "text": "MARSHALL"
    },
    {
      "type": "dialogue",
      "text": "Pearl Harbor and three years of brutal conflict in the Pacific buys a lot of latitude with the American public."
    },
    {
      "type": "character",
      "text": "STIMSON"
    },
    {
      "type": "dialogue",
      "text": "Enough to unleash the atomic bomb?"
    },
    {
      "type": "character",
      "text": "FERMI"
    },
    {
      "type": "dialogue",
      "text": "In truth, the A-bomb might not cause as much damage as the Tokyo bombings."
    },
    {
      "type": "character",
      "text": "STIMSON"
    },
    {
      "type": "dialogue",
      "text": "What are we estimating?"
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "In a medium-sized city, twenty or thirty thousand dead."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  117.117."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Don’t underestimate the psychological impact of an atomic explosion... a pillar of fire ten thousand feet tall, deadly neutron effects for a mile in all directions... from one. Single. Device. Dropped from a barely noticed B-29... the atomic bomb will be a terrible revelation of divine power. Groves carefully monitors my effect on the room..."
    },
    {
      "type": "character",
      "text": "MARSHALL"
    },
    {
      "type": "dialogue",
      "text": "If that’s true it would be definitive. World War II would be over. Our boys would come home."
    },
    {
      "type": "character",
      "text": "STIMSON"
    },
    {
      "type": "dialogue",
      "text": "This could end the war."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "This could end all war. If we retain moral advantage. Groves registers the pivot..."
    },
    {
      "type": "character",
      "text": "STIMSON"
    },
    {
      "type": "dialogue",
      "text": "How so?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "If we use this weapon without informing our allies, they’ll see It as a threat and we’ll be in an arms race."
    },
    {
      "type": "character",
      "text": "MARSHALL"
    },
    {
      "type": "dialogue",
      "text": "How open can we be with the Soviets?"
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "Secrecy won’t stop the Soviets becoming part of the atomic world. A politician, BYRNES, clears his throat politely-"
    },
    {
      "type": "character",
      "text": "BYRNES"
    },
    {
      "type": "dialogue",
      "text": "We’ve been told they have no uranium."
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "You’ve been misinformed. A Russian bomb is a matter of time."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  118.118."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "To stay ahead, our programme has to continue at full pace after the war."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Secretary Stimson, if I may. Not all the scientists on the project agree. In fact, this might be a moment to consider other opinions-"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "The Manhattan Project’s been plagued from the start by certain scientists of doubtful discretion and uncertain loyalty. One of them just tried to get a meeting with the President. I say nothing. Groves looks directly at me."
    },
    {
      "type": "character",
      "text": "GROVES (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "We need them for now, but as soon as is practical, we should sever any such scientists from the programme. Wouldn’t you agree, doctor? I meet Groves’ gaze. Stay silent... Nod."
    },
    {
      "type": "character",
      "text": "MARSHALL"
    },
    {
      "type": "dialogue",
      "text": "If a Russian bomb is inevitable, perhaps we should invite their top scientists to Trinity."
    },
    {
      "type": "character",
      "text": "BYRNES"
    },
    {
      "type": "dialogue",
      "text": "President Truman has no intention of raising expectations that Stalin be included in the atomic project."
    },
    {
      "type": "character",
      "text": "STIMSON"
    },
    {
      "type": "dialogue",
      "text": "Informing him of our breakthrough, and presenting it as the means to win the war need not make unkeepable promises. But the Potsdam peace conference in July is the last chance for Truman to have that conversation. Can you give us a working bomb by then?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Absolutely. We’ll test-fire before the conference."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  119.119."
    },
    {
      "type": "character",
      "text": "STIMSON"
    },
    {
      "type": "dialogue",
      "text": "And Japan?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "If the test works you’ll have two bombs for August."
    },
    {
      "type": "character",
      "text": "STIMSON"
    },
    {
      "type": "dialogue",
      "text": "Military targets?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "There aren’t any big enough."
    },
    {
      "type": "character",
      "text": "CONANT"
    },
    {
      "type": "dialogue",
      "text": "Perhaps a vital war plant, with workers housed nearby."
    },
    {
      "type": "character",
      "text": "FERMI"
    },
    {
      "type": "dialogue",
      "text": "Could we issue a warning? To reduce civilian casualties."
    },
    {
      "type": "character",
      "text": "AIR FORCE OFFICER"
    },
    {
      "type": "dialogue",
      "text": "They’d send up everything they have against us, and I’d be in that plane."
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "If we announce it and it fails to go off we’d scupper any chance of Japanese surrender."
    },
    {
      "type": "character",
      "text": "LAWRENCE"
    },
    {
      "type": "dialogue",
      "text": "Is there no way to demonstrate the bomb to Japan to provoke surrender?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "We intend to demonstrate it in the most unambiguous terms. Twice. Once to show the weapon’s power. A second to show that we can keep going until they surrender."
    },
    {
      "type": "character",
      "text": "STIMSON"
    },
    {
      "type": "dialogue",
      "text": "We have a list of twelve cities to choose from. Sorry, eleven, I’ve taken Kyoto off the list because of its cultural significance to the Japanese people. Stimson senses the unease in the room..."
    },
    {
      "type": "character",
      "text": "STIMSON (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Let me make this simple for you, gentlemen."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  120.120."
    },
    {
      "type": "character",
      "text": "STIMSONSTIMSON  (CONT(CONT’D)’D)"
    },
    {
      "type": "dialogue",
      "text": "The Japanese will not surrender short of a successful invasion of the home islands. Many lives, American and Japanese, will be lost in that invasion. The use of the atomic bomb against Japanese cities will save lives."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BASE OF STEEL TOWER, TRINITY TEST SITE -- DAY"
    },
    {
      "type": "action",
      "text": "Frank shows Groves and me the site plan..."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "Ground Zero. Observation posts at ten thousand yards north, south and west."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Where do we trigger from?"
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "South ten thousand. Base camp is ten miles south, here. And a further observation point on this hill twenty miles away. I point to a crew digging a trench from the base of the tower."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "What’s that? The trigger lines went in already."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "The air force requested a line of lights for their B-29."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "What B-29? Our bomb’s on the tower."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "They want to use the test to confirm the safe operating distance."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Risky."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "Not as risky as dropping one over Japan and hoping we were right about the blast radius."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  121.121."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Don’t let them slow us down- we’re firing on the 15th. FRANK The 15th?! That’s not- GROVES The 15th! Frank sees my expression-"
    },
    {
      "type": "character",
      "text": "FRANK (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "The 15th."
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I show the plan to the division heads."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ll be at the south observation point with Frank and Kistiakowsky. You’ll all be assigned to base camp, far observation, or west observation. INSERT CUT: I ENTER A TENT AT THE BASE OF THE TOWER- THE SILVER SPHERE OF THE BOMB IS SURROUNDED BY THE TEAM..."
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "Are those safe distances?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "They’re based on your calculations."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Time to stand behind your science, Hans. Literally. INSERT CUT: THE BOMB IS HOISTED UP IN TO THE TOWER..."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "What about the radiation cloud?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Without high winds it should settle within two to three miles. Evacuation measures will be in place, but we need good weather for visibility so it should be fine. We go on the night of the 15th."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  122.122. The team exchange looks-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "That’s a hard deadline, so if anyone has anything... speak now."
    },
    {
      "type": "character",
      "text": "BETHE"
    },
    {
      "type": "dialogue",
      "text": "We need a final implosion test."
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY"
    },
    {
      "type": "dialogue",
      "text": "Couldn’t hurt."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Do it. Is there anything else that might stop us? A THUNDERCLAP takes us into-"
    },
    {
      "type": "scene-heading",
      "text": "EXT. OPPENHEIMER HOUSE, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "White sheets FLAP CRAZILY in the wind... through the window we see Kitty put her drink down reluctantly. She comes out to grab a sheet that has come loose from the line... notices a JEEP idling at the gate, ARMED GUARDS patiently waiting."
    },
    {
      "type": "action",
      "text": "I emerge from the house carrying an overnight bag. Kitty, one hand on the washing line, turns to look at me, curious."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "It’s happening, isn’t it? I watch the sheets flapping. Glance at the guards..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ll send a message. If it’s gone our way... 'Take in the sheets.' She nods. I head towards the waiting jeep."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Robert? I turn, looking at Kitty amongst the FLAPPING SHEETS..."
    },
    {
      "type": "character",
      "text": "KITTY (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Break a leg."
    },
    {
      "type": "scene-heading",
      "text": "EXT. CANYON, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "A BANG as the final implosion test goes off... Kistiakowsky and Fuchs raise their heads... Kistiakowsky shows Fuchs the tape, grave."
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  123.123."
    },
    {
      "type": "scene-heading",
      "text": "EXT. STEEL TOWER, TRINITY TEST SITE -- EVENING"
    },
    {
      "type": "action",
      "text": "I watch the last TECHNICIAN come down. I nod at the man, then start my lonely climb... I stare at the silver sphere of the first atomic bomb, its surface STUDDED with detonators, WIRES DRAPED across it like spaghetti. Thunder RUMBLES. I watch the approaching storm..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BASE CAMP, TRINITY TEST SITE -- EVENING"
    },
    {
      "type": "action",
      "text": "Army tents. A WINDMILL SPINS FURIOUSLY..."
    },
    {
      "type": "scene-heading",
      "text": "INT. BASE CAMP, TRINITY TEST SITE -- EVENING"
    },
    {
      "type": "action",
      "text": "Fermi moves through the team, taking bets..."
    },
    {
      "type": "character",
      "text": "FERMI"
    },
    {
      "type": "dialogue",
      "text": "Oppie’s taken a very modest three kilotons... Teller’s in for forty- five... Rabi pulls out some bills-"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Twenty."
    },
    {
      "type": "character",
      "text": "FERMI"
    },
    {
      "type": "dialogue",
      "text": "Twenty thousand tons of TNT... and does anyone want the side action on total atmospheric ignition? The scientists groan and laugh. Soldiers look at each other: 'What the hell?' Groves corners the army WEATHERMAN."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Are you saying we’ll have to delay?"
    },
    {
      "type": "character",
      "text": "WEATHERMAN"
    },
    {
      "type": "dialogue",
      "text": "I’m saying it would be prudent."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Has this weather reached the site? The weatherman gets on his radio. Kistiakowsky BURSTS in-"
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY"
    },
    {
      "type": "dialogue",
      "text": "Oppie- The phone rings -"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  124.124."
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Bethe’s calling you to tell you the implosion test failed, but- I have the phone to my ear -"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Hans. Yes, he’s here. Yes."
    },
    {
      "type": "parenthetical",
      "text": "(I hang up)"
    },
    {
      "type": "dialogue",
      "text": "Is he wrong?"
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "So we’re about to fire a dud?"
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Explain."
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY"
    },
    {
      "type": "dialogue",
      "text": "I can’t. I just know the implosion lenses will work."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "If we fire those detonators and they don’t trigger the reaction, two years’ worth of plutonium will be scattered across white sands."
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY"
    },
    {
      "type": "parenthetical",
      "text": "(holds out his hand)"
    },
    {
      "type": "dialogue",
      "text": "A month of my salary against ten bucks says it lights. I study Kistiakowsky. Take the bet."
    },
    {
      "type": "character",
      "text": "WEATHERMAN"
    },
    {
      "type": "dialogue",
      "text": "The wind’s picking up at Zero, not the rain. Lightning circling. THUNDER. Rabi calls over-"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Hey, weatherman, you think it might be time to get your men away from the steel tower with the atomic bomb primed to detonate via electrical charge? The weatherman laughs. Then GRABS the radio -"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  125.125."
    },
    {
      "type": "character",
      "text": "WEATHERMAN"
    },
    {
      "type": "dialogue",
      "text": "Pull ’em out."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(to Groves)"
    },
    {
      "type": "dialogue",
      "text": "Let’s get to south observation. Make our determination there."
    },
    {
      "type": "scene-heading",
      "text": "EXT. STEEL TOWER, TRINITY TEST SITE -- NIGHT"
    },
    {
      "type": "action",
      "text": "The last trucks drive away, lightning on the horizon. The bomb sits there, impervious to peals of DRY THUNDER..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- NIGHT"
    },
    {
      "type": "action",
      "text": "Groves, the weatherman and I watch rain LASH the desert..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The team hasn’t slept for two nights. We stand down, make the bomb safe, it’s weeks before we get back here."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Then we miss Potsdam."
    },
    {
      "type": "parenthetical",
      "text": "(checks watch)"
    },
    {
      "type": "dialogue",
      "text": "I need to get word to Truman by seven."
    },
    {
      "type": "parenthetical",
      "text": "(to the weatherman)"
    },
    {
      "type": "dialogue",
      "text": "Our window’s closing. What’s it doing?"
    },
    {
      "type": "character",
      "text": "WEATHERMAN"
    },
    {
      "type": "dialogue",
      "text": "Raining. Blowing. Lightning."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "For how long, dammit?!"
    },
    {
      "type": "character",
      "text": "WEATHERMAN"
    },
    {
      "type": "dialogue",
      "text": "It’s holding strong."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’ll break before dawn."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "How could you know that?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I know this desert. The air cools overnight. Just before dawn, the storm breaks."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  126.126."
    },
    {
      "type": "character",
      "text": "WEATHERMAN"
    },
    {
      "type": "dialogue",
      "text": "He could be right. But schedule it as late as possible."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Five thirty? Groves considers this. Turns to the weatherman."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Sign your forecast. If you’re wrong, I’ll hang you."
    },
    {
      "type": "scene-heading",
      "text": "INT. BUNKER, SOUTH OBSERVATION POST -- NIGHT"
    },
    {
      "type": "action",
      "text": "Groves and me, alone. Rain pelting down outside."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Three years. Four thousand people. Two billion dollars. If it doesn’t go off we’re both finished."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I put my money on three kilotons. Any less, they won’t get what it is."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "What did Fermi mean by 'atmospheric ignition'?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We had a moment where it looked like the chain reaction from an atomic device might never stop. Setting fire to the atmosphere."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Why’s Fermi still taking side bets on it?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Call it gallows humour. Groves takes this in. Picks the scab-"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Are we saying there’s a chance that when we push that button... we destroy the world?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  127.127."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Nothing in our research over the last three years supports that conclusion except as the most remote possibility."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "How remote?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The chances are near zero."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Near zero?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(smiling)"
    },
    {
      "type": "dialogue",
      "text": "What do you want from theory alone?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Zero would be nice. I check my watch."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Well, in an hour and fifty-eight minutes, we’ll know. I listen-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "It’s letting up..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. TRINITY TEST SITE -- NIGHT"
    },
    {
      "type": "action",
      "text": "Searchlights settle on the gleaming steel tower. A line of lights leading from the blackness of the night-time desert to the tower comes on..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Groves and I come out into gentle rain. The wind has fallen off. Frank comes up to meet us."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "The arming party’s left Zero, heading this way, throwing the switches..."
    },
    {
      "type": "parenthetical",
      "text": "(to the soldiers)"
    },
    {
      "type": "dialogue",
      "text": "Turn the cars, ready for emergency evacuation..."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  128.128."
    },
    {
      "type": "scene-heading",
      "text": "EXT. SOUTH 1500 POST -- NIGHT"
    },
    {
      "type": "action",
      "text": "Kistiakowsky and military personal, including BAINBRIDGE, get out of a truck. Kistiakowsky THROWS a SWITCH on the ground..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BASE CAMP, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Rabi, Fermi and Bethe come outside. A SOLDIER hands them WELDER’S GLASS..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- NIGHT"
    },
    {
      "type": "action",
      "text": "Kistiakowsky and Bainbridge get out of the truck and enter the bunker."
    },
    {
      "type": "scene-heading",
      "text": "INT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Bainbridge pulls out a key. UNLOCKS the arming switches. Kistiakowsky nods, Bainbridge THROWS THE SWITCHES."
    },
    {
      "type": "character",
      "text": "BAINBRIDGE"
    },
    {
      "type": "dialogue",
      "text": "Twenty minutes."
    },
    {
      "type": "scene-heading",
      "text": "EXT. TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "A SIGNAL ROCKET flares up into the air..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BASE CAMP, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Rabi, Fermi and the others watch the rocket go up-"
    },
    {
      "type": "character",
      "text": "FERMI"
    },
    {
      "type": "dialogue",
      "text": "Twenty minutes!"
    },
    {
      "type": "scene-heading",
      "text": "EXT. HILLTOP DISTANT OBSERVATION POINT -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "A group of scientists, including Teller, Feynman and Lawrence, watch the distant rocket sputter..."
    },
    {
      "type": "character",
      "text": "FEYNMAN"
    },
    {
      "type": "dialogue",
      "text": "That’s twenty! DARK GLASSES are handed out. Feynman refuses, jumping up into the cab of a truck-"
    },
    {
      "type": "character",
      "text": "SOLDIER"
    },
    {
      "type": "dialogue",
      "text": "Hey, Feynman-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  129.129."
    },
    {
      "type": "action",
      "text": "Feynman TAPS the windshield-"
    },
    {
      "type": "character",
      "text": "FEYNMAN"
    },
    {
      "type": "dialogue",
      "text": "The glass stops the UV. Teller, in dark glasses, is APPLYING SUNSCREEN at night-"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "But what stops the glass? Feynman looks at Teller. Looks at the glass, shakes his head, grinning..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Groves moves to me-"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "I’m heading to base camp. Best of luck. Groves shakes my hand."
    },
    {
      "type": "character",
      "text": "GROVES (CONT'D) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Try not to blow up the world."
    },
    {
      "type": "scene-heading",
      "text": "INT. SAME -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "I watch Bainbridge take his place at the KILL SWITCH."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Watch that needle. If the detonators don’t charge, or if the voltage dips below one volt, you abort. Bainbridge nods, watching the meter of the X-unit like a hawk. A nervous hawk."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BASE CAMP, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "A loudspeaker broadcasts the countdown-"
    },
    {
      "type": "character",
      "text": "LOUDSPEAKER"
    },
    {
      "type": "dialogue",
      "text": "Two minutes to detonation... The two-minute rocket goes up-"
    },
    {
      "type": "character",
      "text": "ARMY CAPTAIN"
    },
    {
      "type": "dialogue",
      "text": "Everybody down!"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  130.130. The observers lie on the ground, facing away from the site."
    },
    {
      "type": "character",
      "text": "ARMY CAPTAIN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Do not turn around until you see light reflected on the hills. Then look at the explosion only through the welder’s glass..."
    },
    {
      "type": "character",
      "text": "LOUDSPEAKER"
    },
    {
      "type": "dialogue",
      "text": "Ninety seconds..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. DISTANT OBSERVATION POINT -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Feynman TUNES the radio into the countdown relay-"
    },
    {
      "type": "character",
      "text": "RADIO"
    },
    {
      "type": "dialogue",
      "text": "Sixty seconds... Lawrence jumps in next to Feynman. The scientists peer into the distance through the windshield... Teller, pale with sunscreen, adjusts his dark glasses..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Bainbridge PEERS at the X-unit... Frank and I peer at the tower... The electronic counter STARTS: 45, 44, 43, 42..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "These things are hard on your heart."
    },
    {
      "type": "character",
      "text": "LOUDSPEAKER"
    },
    {
      "type": "dialogue",
      "text": "Thirty seconds... FOUR RED LIGHTS flicker on-"
    },
    {
      "type": "scene-heading",
      "text": "EXT. STEEL TOWER, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "The bomb WAKES, detonators on its surface HUMMING..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "The NEEDLE on the X-unit SHOOTS to the right-"
    },
    {
      "type": "character",
      "text": "BAINBRIDGE"
    },
    {
      "type": "dialogue",
      "text": "Detonators charged! I pull on a pair of WELDER’S GOGGLES..."
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  131.131."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BASE CAMP, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Rabi lifts his head to peek around, welder’s glass over his eyes... Groves shakes hands with Bush..."
    },
    {
      "type": "character",
      "text": "LOUDSPEAKER"
    },
    {
      "type": "dialogue",
      "text": "...eighteen, seventeen..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. DISTANT OBSERVATION POINT -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Feynman peers through the windshield. Teller studies the horizon..."
    },
    {
      "type": "character",
      "text": "RADIO"
    },
    {
      "type": "dialogue",
      "text": "...twelve, eleven..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "A GONG sounds at T-minus 10- Bainbridge peers at the needle, which BOBBLES- his hand FLINCHES- the needle settles..."
    },
    {
      "type": "character",
      "text": "LOUDSPEAKER"
    },
    {
      "type": "dialogue",
      "text": "Ten, nine, eight... Frank and I peer through the holes in the concrete."
    },
    {
      "type": "character",
      "text": "LOUDSPEAKER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "...seven, six, five... Kistiakowsky SCRAMBLES out of the bunker-"
    },
    {
      "type": "scene-heading",
      "text": "EXT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "-and up onto the embankment, eyes locked on the tiny glow of the distant tower..."
    },
    {
      "type": "character",
      "text": "LOUDSPEAKER"
    },
    {
      "type": "dialogue",
      "text": "...four, three..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "I stare straight ahead..."
    },
    {
      "type": "character",
      "text": "LOUDSPEAKER"
    },
    {
      "type": "dialogue",
      "text": "...two, one... Bainbridge watches the needle as the counter goes down to- ... zero."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  132.132. My breath stops- an agonizing instant before- SILENT LIGHT. FULL BRIGHT NOON SUNNY DAYLIGHT."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BASE CAMP, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Rabi sees SUDDEN DAYTIME- turns to the LIGHT, peers through the welder’s glass at BLINDING SILENT WHITE..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. DISTANT OBSERVATION POINT -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Lawrence is stepping out of the car as Feynman SHUTS his eyes against INSTANT DAYLIGHT... a HUSHED INTAKE OF BREATH from the crowd of sunglasses-clad distant observers..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "All we can hear is my TREMULOUS BREATHING as the LIGHT becomes less BLINDING, resolving into a FIREBALL, BRIGHT AS THE SUN, BUT GIANT... I YANK off my goggles... watch the ROILING PLASMA become more visible in its HELLISH CONTORTIONS... CLIMBING into the sky like the DEVIL’S CLAW..."
    },
    {
      "type": "action",
      "text": "My PUPILS are PINPRICKS-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Now I am become Death, destroyer of worlds... And then- CRACK!!... !!!... !!!!... !!!!!... I am hit by the WIND and DUST of the SHOCKWAVE- THE THUNDER OF A THOUSAND STORMS ROLLS OVER, DEAFENING-"
    },
    {
      "type": "scene-heading",
      "text": "EXT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Kistiakowsky is BLOWN OFF HIS FEET..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "With the wave of DARK THUNDER, TERRIBLE BEAUTY GIVES WAY TO FEAR... I TREMBLE as I watch the glowing cloud climb to its full height, its inner fire dimming to a HELLISH SCARLET... DUST CLOUD RISING, CRACKLING WITH PURPLISH ENERGY..."
    },
    {
      "type": "action",
      "text": "As the sound diminishes to a RUMBLE and night REGAINS the desert floor, Frank turns to me-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  133.133."
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "parenthetical",
      "text": "(quiet)"
    },
    {
      "type": "dialogue",
      "text": "It worked. I nod, awestruck..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. BASE CAMP, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Startled murmurs, then a few claps... then CRAZY, CHEERING, CLAPPING, DANCING... in the middle of it all Rabi tries to understand what just happened..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. SAME -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "ECSTATIC CHEERING... even Teller SMILES... Feynman pulls out some BONGOS and hops onto the hood of the truck... people DANCE to his PAGAN RHYTHM as the dawn CREEPS IN..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. SOUTH OBSERVATION POST, TRINITY TEST SITE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Kistiakowsky GRABS me in a big HUG- steps back- holding out his hand for payment. I pull out my wallet, frown- there’s nothing in it-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m good for it. Kistiakowsky GRINS-"
    },
    {
      "type": "character",
      "text": "KISTIAKOWSKY"
    },
    {
      "type": "dialogue",
      "text": "Yes, you are! Yes, you are!"
    },
    {
      "type": "scene-heading",
      "text": "EXT. BASE CAMP, TRINITY TEST SITE -- MOMENTS LATER"
    },
    {
      "type": "action",
      "text": "Rabi, still amidst the celebration, watches a car pull up."
    },
    {
      "type": "action",
      "text": "I get out, walking like GARY FUCKING COOPER- the crowd spots me... goes NUTS."
    },
    {
      "type": "action",
      "text": "Groves turns to an AIDE -"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Get me Potsdam. Right away. I nod at Groves, move through the sea of congratulations to find Serber..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Get a message to Kitty..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  134.134. Serber’s face falls, perturbed-"
    },
    {
      "type": "character",
      "text": "SERBER"
    },
    {
      "type": "dialogue",
      "text": "We can’t say anything-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Just tell her to bring in the sheets. Serber grins. I spot Groves on a FIELD TELEPHONE- then am HOISTED ONTO JOYFUL SHOULDERS..."
    },
    {
      "type": "scene-heading",
      "text": "INT. OPPENHEIMER HOUSE, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "Kitty wrangles the kitchen phone while she feeds our baby daughter and young son-"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Sorry. Yes, Charlotte, go ahead."
    },
    {
      "type": "character",
      "text": "CHARLOTTE"
    },
    {
      "type": "parenthetical",
      "text": "(over phone)"
    },
    {
      "type": "dialogue",
      "text": "Well, I don’t know, he just said to tell you to bring in the sheets. Kitty freezes, letting the phone come off her ear..."
    },
    {
      "type": "character",
      "text": "CHARLOTTE (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(over phone)"
    },
    {
      "type": "dialogue",
      "text": "Kitty? Kitty? Kitty smiles, tears forming. It is done."
    },
    {
      "type": "transition",
      "text": "FADE OUT."
    },
    {
      "type": "action",
      "text": "FADE IN:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I watch CRATES hoisted on trucks by the army..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "They musn’t drop it through cloud cover-"
    },
    {
      "type": "scene-heading",
      "text": "INT. T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I am talking to the AIR FORCE OFFICER who is supervising the crating of equipment-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  135.135."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "If they detonate it too high in the air, the blast won’t be as powerful-"
    },
    {
      "type": "character",
      "text": "AIR FORCE OFFICER"
    },
    {
      "type": "dialogue",
      "text": "With respect, Dr Oppenheimer. We’ll take it from here. I lose sight of the bomb as THE CRATE IS CLOSED."
    },
    {
      "type": "scene-heading",
      "text": "EXT. T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "Groves appears at my side, watching the loading..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Did Truman brief Stalin at Potsdam?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "'Brief' would be an overstatement. He referred to a powerful new weapon, Stalin said he hoped we’d make good use of it against Japan."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That’s it?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Robert, we’ve given them an ace. It’s for them to play the hand. Frustrated, I drop my cigarette and GRIND it out-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You’re aiming for the 6th?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "That’s up to the CO in the Pacific."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Should I come with you to Washington?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "What for?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Well... you’ll keep me informed? Groves turns to leave -"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  136.136."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Of course."
    },
    {
      "type": "parenthetical",
      "text": "(looks back)"
    },
    {
      "type": "dialogue",
      "text": "As best I can. I watch Groves leave, uneasy. A truck pulls out, REVEALING TELLER. He crosses, watching the loaded truck move away..."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Would the Japanese surrender if they knew what was coming?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I don’t know."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Have you seen Szilard’s petition?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Yeah. What the hell does Szilard know about the Japanese? I look at Teller."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You’re not signing it?"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "A lot of people have."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Edward, the fact that we built this bomb doesn’t give us any more right or responsibility to decide how it’s used than anyone else."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "But we’re the only people who know about it."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ve told Stimson the various opinions of the community."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "But what’s your opinion? I watch another truck pull out..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Once it’s used, nuclear war, maybe all war, becomes unthinkable."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  137.137."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Until somebody builds a bigger bomb."
    },
    {
      "type": "scene-heading",
      "text": "INT. OPPENHEIMER HOUSE, LOS ALAMOS -- NIGHT"
    },
    {
      "type": "action",
      "text": "Kitty comes downstairs to find me sitting at the kitchen table. The phone in front of me."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I thought they would call."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "It’s only the 5th."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "In Japan it’s the 6th."
    },
    {
      "type": "scene-heading",
      "text": "INT. OPPENHEIMER’S OFFICE, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I pace my office, agitated."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Charlotte? Try Groves again."
    },
    {
      "type": "character",
      "text": "CHARLOTTE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Truman’s on the Radio- ! I BOLT into-"
    },
    {
      "type": "scene-heading",
      "text": "INT. FOYER, OPPENHEIMER’S OFFICE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Charlotte is patching the PA to the radio-"
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "parenthetical",
      "text": "(over radio)"
    },
    {
      "type": "dialogue",
      "text": "...Sixteen hours ago an American airplane dropped one bomb on Hiroshima and destroyed its usefulness to the enemy..."
    },
    {
      "type": "scene-heading",
      "text": "INT. OFFICE, T-SECTION, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "Frank is doing paperwork when the PA WHISTLES-"
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "parenthetical",
      "text": "(over PA)"
    },
    {
      "type": "dialogue",
      "text": "That bomb had more power than twenty thousand tons of TNT..."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  138.138."
    },
    {
      "type": "scene-heading",
      "text": "INT. CORRIDOR, T-SECTION, LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "As Frank emerges, others DRIFT into the corridor, shocked..."
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "parenthetical",
      "text": "(over PA)"
    },
    {
      "type": "dialogue",
      "text": "It is an atomic bomb. It is a harnessing of the basic power of the universe... He hears BANGING and CHEERING- through the window SOLDIERS BEAT on trash-can lids. Frank and the scientists try uncertain smiles and handshakes..."
    },
    {
      "type": "scene-heading",
      "text": "INT. OPPENHEIMER’S OFFICE, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I listen to the radio-"
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "parenthetical",
      "text": "(over radio)"
    },
    {
      "type": "dialogue",
      "text": "The force from which the sun draws its power has been loosed against those who brought war to the Far East..."
    },
    {
      "type": "character",
      "text": "CHARLOTTE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Groves on one! I white-knuckle the phone..."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "parenthetical",
      "text": "(over phone)"
    },
    {
      "type": "dialogue",
      "text": "I’m very proud of you and all of your people."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It went alright?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "parenthetical",
      "text": "(over phone)"
    },
    {
      "type": "dialogue",
      "text": "Apparently it went with a tremendous bang."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Everybody here is feeling Reasonably good about it. It’s been a long road."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "parenthetical",
      "text": "(over phone)"
    },
    {
      "type": "dialogue",
      "text": "I think one of the wisest things I ever did was when I selected the director of Los Alamos."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  139.139."
    },
    {
      "type": "action",
      "text": "I gently put down the phone..."
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "parenthetical",
      "text": "(over radio)"
    },
    {
      "type": "dialogue",
      "text": "We have spent two billion dollars..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "I walk in a relieved daze..."
    },
    {
      "type": "character",
      "text": "TRUMAN (CONT'D)"
    },
    {
      "type": "parenthetical",
      "text": "(over radio)"
    },
    {
      "type": "dialogue",
      "text": "...on the greatest scientific gamble in history and won. Horns HONK, soldiers CHEER... people WAVE... I nod back..."
    },
    {
      "type": "scene-heading",
      "text": "INT. FULLER LODGE, LOS ALAMOS -- NIGHT"
    },
    {
      "type": "action",
      "text": "A restless, excitable CROWD is packed into the bleachers, like a HIGH-SCHOOL PEP RALLY..."
    },
    {
      "type": "scene-heading",
      "text": "INT. LOBBY, FULLER LODGE, LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Kitty reaches forward and adjusts my tie. We hear the sound of DOZENS OF FEET STAMPING RHYTHMICALLY..."
    },
    {
      "type": "scene-heading",
      "text": "INT. FULLER LODGE, LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "The impatient crowd is STAMPING IN UNISON..."
    },
    {
      "type": "scene-heading",
      "text": "INT. LOBBY, FULLER LODGE, LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Kitty nods at me, I take a breath and PUSH through the door-"
    },
    {
      "type": "scene-heading",
      "text": "INT. FULLER LODGE, LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "As I walk past the rear bleachers I get a close view of DOZENS OF FEET STAMPING IN UNISON... the STAMPING FEET GET FASTER as I approach the stage..."
    },
    {
      "type": "action",
      "text": "The STAMPING GROWS OPPRESSIVE- FASTER and FASTER until RHYTHM BREAKS, causing CACOPHONY which PEAKS as I step up..."
    },
    {
      "type": "action",
      "text": "I raise my hands in a theatrically victorious gesture- the crowd CHEERS..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  140.140."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The world will remember this day. LOUDER CHEERING..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "It’s too early to determine what the results of the bombing are... Though the crowd is still CHEERING, their sound DIMINISHES..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "But I’m sure the Japanese didn’t like it- CHEERS. CHEERS. CHEERS. BUT NO SOUND. As I look out at the EXCITED FACES I can hear my own BREATHING... I carry on-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I’m proud of what you accomplished... The crowd seems to go NUTS, but all we hear is the QUIET CREAKING OF SEATS and SHUFFLE OF FEET as they REACT, HANDS SILENTLY CLAPPING, MOUTHS SILENTLY JAWING... I try again-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I just wish we’d had it in time to use against the Germans... The CHEERING AND CLAPPING PEOPLE GET TO THEIR FEET in MORTIFYING SILENCE... I stare at them, straining to hear something, then- PIERCING SCREAMS not cheers, as INSTANT DAYLIGHT POURS IN THE WINDOWS- BRIGHTER AND BRIGHTER- My eyes are pinpricks as I see CHEERING/SCREAMING MOUTHS STRETCHED GROTESQUELY WIDE- CRACK!!... !!!... !!!! ... THE THUNDER OF A THOUSAND STORMS ROLLS OVER, DEAFENING- I see FLESH RIPPED FROM THE SMILING YOUNG FACES... I see PLASMA ROILING and the DEVIL’S CLAW reach into the night sky... I see piles of ASHES where the young crowd was cheering..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SAME -- LATER"
    },
    {
      "type": "action",
      "text": "I DRIFT through a SILENT, KINETIC WHIRLWIND OF CELEBRATION CLAPPED on the back, KISSED... NODDING and HOLLOW SMILES..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  141.141."
    },
    {
      "type": "action",
      "text": "I see a YOUNG WOMAN LAUGHING... I STEP on something, look down to see my foot inside a CHARRED CORPSE... I look up, SHAKING OFF THE IMAGE... I see young people MAKING OUT under the bleachers, a hand up a sweater... I see the young woman again but NOW SHE JUST CRIES AND CRIES AND CRIES..."
    },
    {
      "type": "scene-heading",
      "text": "INT. LOBBY, FULLER LODGE, LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "DRIFTING through... I see a young man sitting, back to the wall, WEEPING, a woman trying to console him..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. FULLER LODGE, LOS ALAMOS -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "As I exit, REVELERS RUN PAST, JOYFUL... turning, I see a young physicist at the wall, bent double..."
    },
    {
      "type": "action",
      "text": "As I pass, he looks up, DISTRAUGHT, VOMIT AROUND HIS MOUTH."
    },
    {
      "type": "transition",
      "text": "FADE OUT."
    },
    {
      "type": "scene-heading",
      "text": "INT. LOBBY, OVAL OFFICE, THE WHITE HOUSE -- DAY"
    },
    {
      "type": "action",
      "text": "Relief. Gentle formality. I look at the coffee table: Time magazine- me on the cover: \"FATHER OF THE ATOMIC BOMB\"."
    },
    {
      "type": "character",
      "text": "FEMALE VOICE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer? An AIDE on softly clicking heels, points at the magazine."
    },
    {
      "type": "character",
      "text": "AIDE"
    },
    {
      "type": "dialogue",
      "text": "Nice picture. I look up at her. Blank."
    },
    {
      "type": "character",
      "text": "AIDE (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "President Truman will see you now."
    },
    {
      "type": "scene-heading",
      "text": "INT. OVAL OFFICE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Truman comes from behind his desk to shake my hand-"
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer, it’s an honour."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Mr President. Secretary Byrnes. Byrnes nods, sits. I take a seat. Truman leans on the desk."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  142.142."
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "dialogue",
      "text": "How’s it feel to be the most famous man in the world? I can’t think of an answer. TRUMAN (CONT’D) You helped save a lot of OPPENHEIMER American lives. What we did And Nagasaki. at Hiroshima was-"
    },
    {
      "type": "character",
      "text": "TRUMAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "What?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Hiroshima and Nagasaki."
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "dialogue",
      "text": "Obviously. Your invention let us bring our boys home. Your country owes you a great debt."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It was hardly my invention."
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "dialogue",
      "text": "It’s you on the cover of Time."
    },
    {
      "type": "parenthetical",
      "text": "(indicates Byrnes)"
    },
    {
      "type": "dialogue",
      "text": "Jim here tells me you’re concerned about an arms race with the Soviets."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Well, it’s that... now is our chance to secure international cooperation on atomic energy, and I’m concerned-"
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "dialogue",
      "text": "You know when the Soviets are gonna have a bomb? OPPENHEIMER I’m not sure I could give a- TRUMAN (CONT’D) Never. I look at the President, incredulous..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Mr President, the Russians have good physicists and abundant resources-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  143.143."
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "dialogue",
      "text": "Abundant? I don’t think so."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "They’ll put everything they have... I taper off."
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "dialogue",
      "text": "I hear you’re leaving Los Alamos. What should we do with it?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Give it back to the Indians. Truman laughs. But I’m not joking. Truman looks to Byrnes for help."
    },
    {
      "type": "character",
      "text": "BYRNES"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer, if what you say about the Soviets is true, we have to build up Los Alamos, not shut it down. I WRING my hands, deeply uncomfortable..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Mr President, I feel that I have blood on my hands. Truman looks at me differently. Pulls the crisp white handkerchief from his breast pocket and offers it-"
    },
    {
      "type": "character",
      "text": "TRUMAN"
    },
    {
      "type": "dialogue",
      "text": "You think anyone in Hiroshima or Nagasaki gives a shit who built the bomb? They care who dropped it. I did. Hiroshima isn’t about you. Truman gestures to Byrnes, they both RISE. I get to my feet. Awkward. As I leave I hear -"
    },
    {
      "type": "character",
      "text": "TRUMAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Don’t let that crybaby back in here. The door of the Oval Office CLOSES on me..."
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Robert saw that hand-wringing got him nowhere..."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  144.144."
    },
    {
      "type": "scene-heading",
      "text": "INT. LOBBY, OVAL OFFICE, THE WHITE HOUSE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Walking past I notice my face staring back at me from the cover of the magazine on the table..."
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "By the time I met him, he’d fully embraced his 'father of the bomb' reputation..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss sits talking with the Senate Aide."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "He used his profile to influence policy... INSERT CUT: LIFE MAGAZINE- \"OPPENHEIMER, NO. 1 THINKER ON ATOMIC ENERGY\"... OPPENHEIMER RUNS A GAUNTLET OF FLASHBULBS... OPPENHEIMER AND KITTY ARE PHOTOGRAPHED AT OLDEN MANOR..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "But all along- with McCarthy on the rise- he knew he was vulnerable. His brother was blacklisted by every university in the country... INSERT CUT: FRANK WORKS A RANCH IN COLORADO..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Lomanitz wound up working the railroad, laying track... INSERT CUT: LOMANITZ SWINGS A HAMMER..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Chevalier went into exile..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  145.145."
    },
    {
      "type": "action",
      "text": "INSERT CUT: CHEVALIER CARRIES SHOPPING, STEPPING AROUND CHICKENS IN A RURAL FRENCH ALLEY..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "But none of that stopped Robert from om pushing the GAC to recommend arms control instead of the H-bomb. INSERT CUT: STRAUSS MOVES THE FLOWERS ON THE TABLE IN THE HOTEL CONFERENCE ROOM, WATCHING OPPENHEIMER..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "He was devastated when that didn’t go his way... INSERT CUT: HEADLINE: \"TRUMAN ANNOUNCES H-BOMB PROGRAM\"..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. BALLROOM, PLAZA HOTEL -- NIGHT (COLOUR)"
    },
    {
      "type": "action",
      "text": "Drink in hand, I watch the room sing 'Happy Birthday' to Strauss. Ruth Tolman is next to me, staring at the NEWSPAPER."
    },
    {
      "type": "character",
      "text": "RUTH"
    },
    {
      "type": "dialogue",
      "text": "I miss Richard more than I can bear... I turn to Ruth, sympathetic."
    },
    {
      "type": "character",
      "text": "RUTH (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "But part of me’s glad he didn’t live to see where this is all going. I nod, understanding. She downs her drink and leaves."
    },
    {
      "type": "character",
      "text": "STRAUSS (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Robert, my son and his fiancée are desperate to meet the father of the atomic bomb... Strauss is there with his adult children- I glance at them, raise a glass, then turn away. Strauss stands there, humiliated. The couple awkwardly moves off."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Is this a bad time?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  146.146."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "What do you think, Lewis?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I think it must have been a blow for you-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "For the world."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "The world? What does Fuchs mean to rest of the world?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Fuchs? Klaus Fuchs? Strauss looks at me with concern..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "You haven’t heard. Klaus Fuchs, the British scientist you put onto the implosion team at Los Alamos? INSERT CUT: FUCHS HANDS OPPENHEIMER HIS PIPE..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Turns out he was spying for the Soviets. The whole time. I’m sorry, Robert, you must feel awful."
    },
    {
      "type": "parenthetical",
      "text": "(gestures to bar)"
    },
    {
      "type": "dialogue",
      "text": "Have another. On me. Strauss moves off. I stand there. Frozen."
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "After the truth about Fuchs came out, they stepped up surveillance on Robert. He knew his phone was tapped-"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "He was followed everywhere..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  147.147."
    },
    {
      "type": "action",
      "text": "INSERT CUT: OPPENHEIMER, DRIVING, CHECKS HIS REAR-VIEW MIRROR, SPOTS A SEDAN FOLLOWING HIM..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "His trash picked through... INSERT CUT: KITTY, FROM THE KITCHEN WINDOW, SPOTS A SUITED MAN PICKING THROUGH THEIR TRASH..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "But it never stopped him speaking his mind."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "A man of conviction?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Sure. Or maybe he thought fame could actually protect him. When Eisenhower took over, Robert saw one more chance. He took it..."
    },
    {
      "type": "scene-heading",
      "text": "INT. CORPORATE AUDITORIUM -- NIGHT (B&W)"
    },
    {
      "type": "action",
      "text": "Oppenheimer is lecturing... Strauss is in the crowd..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "America and Russia may be likened to two scorpions in a bottle, each capable of killing the other, but only at the risk of his own life. There are various aspects of this policy which I would like to discuss but can’t. Follies that can occur only when even the men who know the facts can find no one to talk about them, when the facts are too secret for discussion, and thus for thought. Candor is the only remedy. Officials in Washington have to start levelling with the American people, and telling them what the enemy already know about the atomic armaments race. Strauss notices two generals exchanging unfavorable looks."
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "A lot of scientists blame me, but how was I supposed to protect him?"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  148.148."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "That was the last straw for Robert’s enemies."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "So he had to lose his security clearance."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "And with it, his credibility."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "But how could they do it? He was a war hero- and he’d already told everyone about his past..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Borden dredged it all up again."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "But how could Borden get access to Oppenheimer’s FBI file? Could it have been Nichols?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I can’t imagine he’d do that. But whoever did unleashed a firestorm that burned a path from the White House right to my desk at the AEC. You see them in there trying to hang Oppenheimer around my neck. I’ve worked my whole life to get here- the Cabinet of the United States of America- and now, in front of the entire country, they want to put me back in my place... a lowly shoe salesman."
    },
    {
      "type": "character",
      "text": "COUNSEL"
    },
    {
      "type": "dialogue",
      "text": "Lewis, we can win this thing."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "I think we can make the Senate grasp that you did your duty, painful though it was. Will Hill’s testimony back that up?"
    },
    {
      "type": "character",
      "text": "COUNSEL"
    },
    {
      "type": "dialogue",
      "text": "Hill should be fine."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  149.149."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I don’t really know him, but he was one of Szilard’s boys in Chicago. And they never forgave Oppenheimer..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. LECTURE HALL, LOS ALAMOS -- NIGHT (COLOUR)"
    },
    {
      "type": "action",
      "text": "Serber and MORRISON lecture using slides we never see."
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...for not supporting their petition against bombing Japan. I watch as part of a large audience."
    },
    {
      "type": "character",
      "text": "MORRISON"
    },
    {
      "type": "dialogue",
      "text": "This was taken thirty-one days after the bombing. Virtually everyone in the street for nearly a mile around was instantly and seriously burned by the heat of the bomb. Serber changes the slide. I react slightly."
    },
    {
      "type": "character",
      "text": "MORRISON (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "The hot flash burned suddenly and strangely."
    },
    {
      "type": "character",
      "text": "SERBER"
    },
    {
      "type": "dialogue",
      "text": "The Japanese told us of people who wore striped clothing upon whom the skin was burned in stripes. Changes slide. I LOOK AWAY from the screen. I hear the sound of FEET STAMPING as Morrison continues..."
    },
    {
      "type": "character",
      "text": "MORRISON"
    },
    {
      "type": "dialogue",
      "text": "There were many who thought themselves lucky, who crawled out of the ruins of their homes only slightly injured. But they died anyway. They died days or weeks later from the radium-like rays emitted in great numbers at the moment of the explosion."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  150.150."
    },
    {
      "type": "scene-heading",
      "text": "EXT. T-SECTION, LOS ALAMOS -- NIGHT"
    },
    {
      "type": "action",
      "text": "I light my pipe. Teller comes up."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Did you read this crap in the papers? A British physicist saying the atomic bombings weren’t the last act of World War II but the first act of this cold war with Russia."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Which physicist?"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "I think you knew him. Patrick Blackett? I remember- INSERT CUT: BLACKETT TAKES A MOUTHFUL OF APPLE... I smile to myself, rueful..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "He may not be wrong. We bombed an enemy that was essentially defeated."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Robert, you have all the influence now. I look at Teller."
    },
    {
      "type": "character",
      "text": "TELLER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Urge them to continue my research on the Super."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I neither can nor will, Edward. Teller looks at me. Hurt."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Why?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s not the right use of our resources."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  151.151."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "Is that what you really believe? I say nothing."
    },
    {
      "type": "character",
      "text": "TELLER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "J. Robert Oppenheimer. Sphinx-like guru of the atom. Nobody knows what you believe. Do you?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "I hope that in years to come you will look back on your work here with pride..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. FULLER LODGE, LOS ALAMOS -- DAY"
    },
    {
      "type": "action",
      "text": "I give my leaving address, Groves by my side. The THOUSANDS of members of the Los Alamos community listen..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "But today that pride must be tempered with a profound concern. If atomic weapons are to be added to the arsenals of a warring world... then the day will come when people will curse the name of Los Alamos and Hiroshima. The peoples of this world must unite or they will perish. The atomic bomb has spelled out these words for all men to understand. THUNDEROUS APPLAUSE echoes around the mountains..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- MORNING (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss and Counsel drink coffee. The Senate Aide BURSTS in-"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Sorry, Admiral- I stopped off to get this- The Senate Aide holds up TIME MAGAZINE: Strauss is on the cover- \"THE STRAUSS AFFAIR, SENATE V. PRESIDENT\"."
    },
    {
      "type": "character",
      "text": "SENATE AIDE (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "It seems pretty favorable... The Counsel looks over Senate Aide’s shoulder-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  152.152."
    },
    {
      "type": "character",
      "text": "COUNSEL"
    },
    {
      "type": "dialogue",
      "text": "There’s Oppenheimer. What’s the caption?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "'J. Robert Oppenheimer- Strauss fought him..."
    },
    {
      "type": "parenthetical",
      "text": "(pauses)"
    },
    {
      "type": "dialogue",
      "text": "...and the US won.'"
    },
    {
      "type": "character",
      "text": "COUNSEL"
    },
    {
      "type": "dialogue",
      "text": "That’ll work. The Senate Aide is perturbed. Looks up at Strauss."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Those are your words. From yesterday."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "We needed to pivot."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "But how could you know what Time magazine would write...?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Henry Luce is an old friend. The Senate Aide stares at Strauss, realizing..."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "You’ve sat there and let me tell you how this is done. But you’ve been far ahead. All along..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Survival in Washington is about knowing how to get things done."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "You get things done. What was it you said about Borden? Why get caught holding the knife yourself? I’m beginning to think that Borden was holding the knife for you."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Oh?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  153.153."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "As Chairman of the AEC, you had access to Oppenheimer’s file..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "I sit there testifying. Robb checks his notes..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "In the years following the war, would you say you exerted a great influence on the atomic policies of the USA?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I think 'great' would be an overstatement."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Really? If we look at the issue of isotopes... were you not personally responsible for destroying all opposition to their export? I think back to my congressional testimony..."
    },
    {
      "type": "scene-heading",
      "text": "INT. CONGRESSIONAL HEARING ROOM -- DAY"
    },
    {
      "type": "action",
      "text": "The room is all chuckles and smiles at my performance..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "You can use a bottle of beer for making atomic weapons, in fact, you do... I’d say isotopes are less useful for atomic energy than electronic components, but more useful than a sandwich. I’d put them somewhere in between. The room LAUGHS appreciatively. I lean over to Volpe -"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "How’d I do? Volpe glances back at Lewis Strauss, eyes down, ENRAGED..."
    },
    {
      "type": "character",
      "text": "VOLPE"
    },
    {
      "type": "dialogue",
      "text": "Maybe a little too well, Robert."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  154.154."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I was the spokesman, but the opinion was unanimous amongst scientists."
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "dialogue",
      "text": "That will do for today. We’ll reconvene tomorrow when we’ll hear from Dr Isidor Rabi."
    },
    {
      "type": "scene-heading",
      "text": "INT. HOTEL ROOM, WASHINGTON, DC -- NIGHT"
    },
    {
      "type": "action",
      "text": "I sit on the bed, Garrison and his team go over notes. Kitty raids the mini-bar."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Rabi will help us. But it’s going to come down to how much influence Borden has been able to exert on Teller- Kitty is laughing as she opens a miniature with her teeth."
    },
    {
      "type": "character",
      "text": "GARRISON (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Did I say something funny?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Borden, Borden, Borden. We all know it’s Strauss."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Kitty, Lewis brought me to Princeton."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "And you humiliated him in front of Congress."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That was six years ago."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "The truly vindictive are as patient as saints."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Strauss claims to be neutral. Kitty THROWS the miniature at me- it SMASHES into the wall-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  155.155."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Wake up! It’s always been Strauss- and you know it. Why won’t you fight him, for Christ’s sake?! She stalks into the bathroom, SLAMMING the door. Garrison watches me clean up the miniature..."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "I’ve said it before, Robert. We should not put her on the stand-"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- MORNING (B&W)"
    },
    {
      "type": "action",
      "text": "The Senate Aide stares at Strauss in morbid fascination..."
    },
    {
      "type": "action",
      "text": "SENATE AIDE It wasn’t Nichols or Hoover STRAUSS or one of Truman’s guys- it Borden didn’t take any was you. You gave the file to convincing... Borden... you set him on Oppenheimer, convinced him to-"
    },
    {
      "type": "scene-heading",
      "text": "INT. NICHOLS’ OFFICE, ATOMIC ENERGY COMMISSION -- NIGHT (B&W)"
    },
    {
      "type": "action",
      "text": "Nichols is behind the desk, but Strauss commands the room, instructing Borden..."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "Take your time, use the entire file. Write up your conclusions and send them to the FBI."
    },
    {
      "type": "character",
      "text": "BORDEN"
    },
    {
      "type": "dialogue",
      "text": "The material’s extensive- but it isn’t new."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Your conclusions will be. And they’ll have to be answered."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "Hoover passes them to McCarthy?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "parenthetical",
      "text": "(shakes head)"
    },
    {
      "type": "dialogue",
      "text": "Oppenheimer’s too slippery for that self-promoting clown."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  156.156."
    },
    {
      "type": "character",
      "text": "STRAUSSSTRAUSS  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "I’ve talked it over with Hoover- he’ll hold McCarthy at bay while you do this at the AEC."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "A trial?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "No trial. You can’t give Oppenheimer a platform, you can’t martyr him. We need a systematic destruction of Oppenheimer’s credibility so he can never again speak on matters of national security."
    },
    {
      "type": "character",
      "text": "BORDEN"
    },
    {
      "type": "dialogue",
      "text": "What, then?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "A shabby little room, far from the limelight... INSERT CUT: ROOM 2022 IS OPENED UP. DUSTED, TABLES ARRANGED..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "A simple bureaucratic procedure- his Q clearance is up for renewal."
    },
    {
      "type": "parenthetical",
      "text": "(points at Borden)"
    },
    {
      "type": "dialogue",
      "text": "You send your accusations to the FBI... INSERT CUT: BORDEN PULLS PAPER FROM HIS TYPEWRITER. HE SEALS AN ENVELOPE..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Hoover sends them to the AEC..."
    },
    {
      "type": "parenthetical",
      "text": "(points at Nichols)"
    },
    {
      "type": "dialogue",
      "text": "You’re forced to act. You write up an indictment..."
    },
    {
      "type": "scene-heading",
      "text": "INT. FRONT HALL, STRAUSS RESIDENCE -- NIGHT (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss opens the door to Oppenheimer..."
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Tell Oppenheimer his security clearance is not being renewed..."
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  157.157."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM, STRAUSS HOUSE -- NIGHT (B&W)"
    },
    {
      "type": "action",
      "text": "Nichols hands the indictment to Oppenheimer, who sits and reads. Strauss hands Oppenheimer a drink..."
    },
    {
      "type": "character",
      "text": "STRAUSS (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "But offer him the chance to appeal. Oppenheimer looks up from the letter."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Can I keep this?"
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "As you can see, Robert, it’s not yet signed. If you do decide to appeal, they’ll have to send you a copy... Oppenheimer rises. In a daze. Strauss takes his arm..."
    },
    {
      "type": "scene-heading",
      "text": "INT. NICHOLS’ OFFICE, ATOMIC ENERGY COMMISSION -- NIGHT (B&W)"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "When he appeals, I appoint a board... INSERT CUT: THE GRAY BOARD TAKE THEIR SEATS IN ROOM..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "They will, of course, have counsel- INSERT CUT: ROGER ROBB TAKES HIS SEAT..."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "A prosecutor?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "In all but name."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "Who?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Roger Robb."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "Ouch."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  158.158."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Robb will have security clearance to examine Oppenheimer’s file... INSERT CUT: ROBB OPENS A MASSIVE BLACK BINDER..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "As will the Gray Board... INSERT CUT: A BLACK BINDER IS PLACED IN FRONT OF EACH BOARD MEMBER..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Defence counsel will not. INSERT CUT: GARRISON, AT HIS TABLE IN ROOM 2022, LOOKS COVETOUSLY AT THE BLACK BINDERS GRACING EACH PLACE BUT HIS..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "A closed hearing- no audience, no reporters, no burden of proof."
    },
    {
      "type": "character",
      "text": "NICHOLS"
    },
    {
      "type": "dialogue",
      "text": "No burden of proof? Strauss sips his drink. Smiles at Nichols..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "We’re not convicting, just denying."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Oppenheimer is seated at the witness table..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "This answer is a summary of relevant aspects of my life in more or less chronological order..."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "The Senate Aide looks like he ate a bad nut."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "What is it you said? 'This is just how it’s done'?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Forgive my naïveté."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  159.159."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Amateurs seek the sun and get eaten, power stays in the shadows."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "parenthetical",
      "text": "(points to Time magazine)"
    },
    {
      "type": "dialogue",
      "text": "You’re out of the shadows, now."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "That’s why this has to work."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Well, Teller’s testifying this morning - that’ll help, then Hill is in the afternoon."
    },
    {
      "type": "character",
      "text": "COUNSEL"
    },
    {
      "type": "dialogue",
      "text": "Hill should help us, too."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "action",
      "text": "CLOSE ON: A LETTER- AEC LETTERHEAD- \"DEAR DR OPPENHEIMER...\""
    },
    {
      "type": "character",
      "text": "STRAUSS (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "As you can see, it’s not yet signed..."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM, STRAUSS HOUSE -- LATER (COLOUR)"
    },
    {
      "type": "action",
      "text": "I look up from Nichols’ letter- SHELL-SHOCKED."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "If you do decide to appeal, they’ll have to send you a copy... I hand the letter back to Nichols. Strauss takes my arm..."
    },
    {
      "type": "scene-heading",
      "text": "EXT. STRAUSS HOUSE -- CONTINUOUS"
    },
    {
      "type": "action",
      "text": "Strauss gently guides me down the steps..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Take my car and driver. I insist."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’ll have to consult my lawyers."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Of course. But don’t take too long, I can’t keep Nichols at bay. I’m sorry it’s come to this, Robert."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  160.160. Strauss, like a parent, puts me into the back of his car."
    },
    {
      "type": "scene-heading",
      "text": "INT. STRAUSS CAR -- NIGHT"
    },
    {
      "type": "action",
      "text": "I sit in the back, shadows flicking across my face..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Nichols wants me to fight so that he can get it all in the record..."
    },
    {
      "type": "scene-heading",
      "text": "INT. VOLPE’S HOUSE -- NIGHT"
    },
    {
      "type": "action",
      "text": "Kitty and I sit with Joe Volpe."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Strauss thinks I should walk away..."
    },
    {
      "type": "character",
      "text": "VOLPE"
    },
    {
      "type": "dialogue",
      "text": "You could. Your security clearance expires tomorrow. Just let it go."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "You’d be accepting the charges! You’ll lose your job. Your reputation, your place in history! We’ll lose our house. Robert, we have to fight. I look at Kitty. Nod."
    },
    {
      "type": "character",
      "text": "VOLPE"
    },
    {
      "type": "dialogue",
      "text": "As AEC Counsel, I can’t represent you. I’ll call Lloyd Garrison."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "He’s good."
    },
    {
      "type": "character",
      "text": "VOLPE"
    },
    {
      "type": "dialogue",
      "text": "The best. But I have to warn you..."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "I watch Garrison scramble to make notes..."
    },
    {
      "type": "character",
      "text": "VOLPE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "This won’t be a fair fight."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  161.161."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "During your interview with Boris Pash in 1943, did you refer to microfilm?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No. Robb consults a paper in his black binder."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "You never said 'a man at the consulate expert in the use of microfilm'?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Not specifically."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "I’d like to know what document Mr Robb is quoting from, and if we might be furnished with a copy."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "The document is classified."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Members of the board, we’re now hearing some new account of the interview... shouldn’t we get back to firsthand information?"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "This is first-hand."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "How so? Robb looks at Gray. Who nods."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "There’s a recording of the interview. Garrison is shocked. I shake my head."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "You’ve let my client sit up here and potentially perjure himself and all this time you had a recording-?"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "No one told your client to misrepresent his former answers-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  162.162."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Misrepresent? It was twelve years ago!"
    },
    {
      "type": "parenthetical",
      "text": "(to the board)"
    },
    {
      "type": "dialogue",
      "text": "Can we listen to this recording?"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Mr Garrison, you don’t have clearance. I SNAP at the absurdity-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "But you’re reading it into the transcript! Garrison puts a calming hand on my arm-"
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Is this proceeding interested in truth or entrapment? Because if it’s truth... Garrison points at the BLACK BINDERS in front of them all-"
    },
    {
      "type": "character",
      "text": "GARRISON (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Where’s the disclosure? Where’s the witness list?"
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "dialogue",
      "text": "Mr Garrison, this is not a trial- as you’re well aware. Evidentiary rules do not apply. We’re dealing with national security."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "How does national security prevent the prosecution from providing us a list of witnesses?! Gray looks at Garrison, stony-faced. GRAY Perhaps a brief recess is in OPPENHEIMER order! If I may? You gentlemen have my words. If you say it’s from a transcript then I’ll accept it. I’ve already explained that I made up a cock-and-bull story."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  163.163."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "But not the level of detail. Why would anyone present such an elabourate fiction?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Because I was an idiot. I found myself trying to give a tip to the intelligence people, without realizing that when you give a tip you have to offer the whole story. Asked for details, I went off on a false pattern. There was no microfilm, no consular attaché. There weren’t three or more people involved on the project. There was one person involved. That was me."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Why lie?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Clearly with the intention of not revealing who was the intermediary."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Your friend Haakon Chevalier. The Communist."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Yes."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Is he still your friend? I look from smug Robb to the expectant board members..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Chevalier is my friend. Robb backs down, SATISFIED."
    },
    {
      "type": "scene-heading",
      "text": "INT. CORRIDOR OUTSIDE ROOM 2022 -- DAY"
    },
    {
      "type": "action",
      "text": "Oppenheimer and Garrison take a break. Rabi approaches."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Dr Rabi, thanks for coming. Garrison looks around to see Robb conferring with his team."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  164.164."
    },
    {
      "type": "character",
      "text": "GARRISON (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(lowered voice)"
    },
    {
      "type": "dialogue",
      "text": "Do you know anyone the prosecution has called?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Teller, obviously."
    },
    {
      "type": "parenthetical",
      "text": "(looks at Oppenheimer)"
    },
    {
      "type": "dialogue",
      "text": "They’ve asked Lawrence."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "What did he say?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "He wasn’t going to help them..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "But?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Strauss told him that you and Ruth Tolman had been having an affair for years. The whole time you lived with them in Pasadena... INSERT CUT: I SIP FROM RUTH’S DRINK AT THE CHRISTMAS PARTY. RICHARD ENTERS, BANGING SNOW OFF HIS SHOULDERS..."
    },
    {
      "type": "character",
      "text": "RABI (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "He convinced Lawrence that Richard died of a broken heart."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "That’s absurd."
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Which part?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The broken heart. Richard never found out. Rabi tries not to smile. Shakes his head."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Is Lawrence going to testify?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "I don’t know."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "Rabi is testifying."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  165.165."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Dr Rabi, what governmental positions do you currently hold?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "I’m Chairman of the General Advisory Committee to the AEC, succeeding Dr Oppenheimer."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "And how long have you known Dr Oppenheimer?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Since 1928. I know him quite well."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Well enough to speak on the bearing of his character, loyalty and associations?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer is a man of upstanding character, loyal to the United States, to his friends and to the institutions of which he is a part. I’ve examined his security file, and in spite of the associations in there, I do not believe Dr Oppenheimer is a security risk, and that these associations from the past should bar him from continuing as a consultant to the AEC."
    },
    {
      "type": "scene-heading",
      "text": "EXT. CORRIDOR OUTSIDE ROOM 2022 -- DAY"
    },
    {
      "type": "action",
      "text": "I sit, exhausted. A segment of orange drops into my lap -"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Eat. I 'sip' at the orange. Rabi spots Lawrence coming down the corridor- Rabi straightens to his full height- STARES DOWN Lawrence, who looks from Rabi to me. Then TURNS and leaves."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "What was that?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Nothing to worry about."
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  166.166."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- LATER"
    },
    {
      "type": "action",
      "text": "Robb cross-examines Rabi-"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Dr Rabi, after the Russian A-bomb test did Dr Lawrence come to see you prior to the GAC meeting?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "You’d be better off asking him."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "I fully intend to. Did he come to you about the Hydrogen bomb?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "Yes. We all felt that after the Russian explosion we had to do something to regain our position."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "So you agreed with those who felt we should launch a programme for the Super at that time?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "No. There were all kinds of legitimate concerns about the allocation of our resources."
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "dialogue",
      "text": "Would you say Dr Oppenheimer was unalterably opposed to the H-bomb?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "No. He thought a fusion programme would come at the expense of our awfully good fission programme."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "But that proved not to be the case?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "In the event, both could be done. Los Alamos, which Dr Oppenheimer founded, rose to the occasion and worked miracles, absolute miracles."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "May I ask one more question? A purely hypothetical question."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  167.167."
    },
    {
      "type": "character",
      "text": "ROBBROBB  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "Suppose this board should not be satisfied that in his testimony here Dr Oppenheimer had told the whole truth... What would you say then about whether or not he ought to be cleared?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "If you want to set me up on the board then I’ll give you an answer. But I’ve never hidden my opinion that I think this whole proceeding is a most unfortunate one."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Why?"
    },
    {
      "type": "character",
      "text": "RABI"
    },
    {
      "type": "dialogue",
      "text": "He’s a consultant- you don’t want to consult the guy? Don’t. Why go through all this against a man who’s accomplished what Dr Oppenheimer has? Look at his record- we have an A-bomb and a whole series of it, and we have a whole series of Super bombs and what more do you want, mermaids?"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss watches with satisfaction as Teller testifies."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "...that’s why I’m here today. To express the warm support for science and scientists Mr Strauss has shown over the years I’ve known him."
    },
    {
      "type": "character",
      "text": "CHAIRMAN"
    },
    {
      "type": "dialogue",
      "text": "Thank you, Dr Teller. We’ll break now, unless there’s any immediate business."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Senator, I’d like to once again request that we’re furnished with a list of witnesses."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  168.168."
    },
    {
      "type": "character",
      "text": "CHAIRMAN"
    },
    {
      "type": "dialogue",
      "text": "And I’ll remind the nominee that we don’t always have that information in advance. We do know that Dr Hill will be here after lunch. With that, the Chairman BANGS his gavel..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "Robb addresses the board..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Our next scheduled witness, Dr Lawrence, has apparently come down with... colitis... I glance sideways at Garrison, who almost smiles-"
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "So I’ll proceed instead with William Borden. I watch as Borden is sworn in."
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Mr Borden, as a result of your study of Dr Oppenheimer, did you reach certain conclusions?"
    },
    {
      "type": "character",
      "text": "BORDEN"
    },
    {
      "type": "dialogue",
      "text": "I did."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Did there co me a time when you expressed those conclusions in a letter to Mr J. Edgar Hoover of the Federal Bureau of Investigation?"
    },
    {
      "type": "character",
      "text": "BORDEN"
    },
    {
      "type": "dialogue",
      "text": "That is correct."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Prior to writing that letter, did you discuss the writing of it with anybody connected with the Atomic Energy Commission?"
    },
    {
      "type": "character",
      "text": "BORDEN"
    },
    {
      "type": "dialogue",
      "text": "I did not."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  169.169."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Do you have a copy of the letter with you. Robb’s assistant distributes copies of the letter..."
    },
    {
      "type": "character",
      "text": "BORDEN"
    },
    {
      "type": "dialogue",
      "text": "I have one in front of me."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Would you be good enough to read it?"
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "A moment, please! Garrison holds up a finger, FRANTICALLY reading ahead-"
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "dialogue",
      "text": "What’s the purpose of the delay? He’s simply going to read this."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Mr Chairman, this is the first we’ve seen of this letter- and I see statements, at least one, which I don’t think anybody would be happy to have go into the record- accusations that have not before been made and are not part of the indictment from Nichols. Garrison holds up the letter -"
    },
    {
      "type": "character",
      "text": "GARRISON (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Is it the opinion of the board that these are matters into which inquiry should now be directed? I scan down the letter for what he’s seen. My face falls..."
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "dialogue",
      "text": "Testimony of this witness is not in any way going to broaden the inquiry."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "How can it avoid it, sir? Supposing you should believe the witness? Mr Robb is tasked by this board with calling in witnesses, and he brings in one to make accusations of a kind that I don’t think belong here."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  170.170."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Mr Chairman, the witness wrote this letter on his own initiative laying out evidence which has already been before the board. His conclusions are valid testimony just like the positive conclusions of friends of Dr Oppenheimer. It cuts both ways."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "How long has counsel been in possession of the letter?"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Mr Garrison, I don’t think I should be subject to cross-examination by you."
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "dialogue",
      "text": "Mr Garrison, given that we on the board have all read the letter, isn’t it better to have it in the record? Garrison says nothing. He looks at me, frustrated."
    },
    {
      "type": "character",
      "text": "GRAY (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Let’s proceed."
    },
    {
      "type": "character",
      "text": "BORDEN"
    },
    {
      "type": "dialogue",
      "text": "'Dear Mr Hoover, the purpose of this letter is to state my opinion, based upon years of study of the available classified evidence, that more probably than not J. Robert Oppenheimer is an agent of the Soviet Union.' I turn the letter face down, staring at its blank whiteness..."
    },
    {
      "type": "character",
      "text": "BORDEN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "'The following conclusions are justified. One: Between 1929 and 1942, more probably than not, J. Robert Oppenheimer was a sufficiently hardened Communist that he volunteered information to the Soviets. Two: More probably than not, he has since been functioning as an espionage agent.' I watch the STENOGRAPHER calmly type this into the record..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  171.171."
    },
    {
      "type": "character",
      "text": "BORDEN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "'Three: More probably than not, he has since acted under Soviet directive in influencing United States military, atomic energy, intelligence, and diplomatic policy.' Devastated, I cannot meet the eye of anyone in the room. Garrison gets up from his place. Sits down next to me."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "I’m sorry, Robert."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Isn’t anyone ever going to tell the truth about what’s happening here?"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss and his Counsel take their seats as the Chairman calls to order. Strauss looks around the room, CHEERFULLY."
    },
    {
      "type": "character",
      "text": "CHAIRMAN"
    },
    {
      "type": "dialogue",
      "text": "We will now hear from Dr David Hill. Strauss peers at a FAMILIAR man in GLASSES, DAVID HILL- Szilard’s note-taking scientist WHOSE PEN OPPENHEIMER GRABBED..."
    },
    {
      "type": "character",
      "text": "CHAIRMAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Dr Hill, would you care to make a statement?"
    },
    {
      "type": "character",
      "text": "HILL"
    },
    {
      "type": "dialogue",
      "text": "Thank you. I have been asked to testify about Lewis Strauss, a man who has given years of service in high positions of government and who is known to be earnest, hard- working and intelligent. Strauss glances at Counsel, satisfied."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  172.172."
    },
    {
      "type": "character",
      "text": "HILL (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "The views I have to express are my own, but I believe that much I have to say will help indicate why most of the scientists in this country would prefer to see Mr Strauss completely out of the government. Strauss narrows his eyes..."
    },
    {
      "type": "character",
      "text": "SENATOR PASTORE"
    },
    {
      "type": "parenthetical",
      "text": "(friendly lob)"
    },
    {
      "type": "dialogue",
      "text": "You’re referring to the hostility of certain scientists directed at Mr Strauss because of his commitment to security, as demonstrated in the Oppenheimer affair?"
    },
    {
      "type": "character",
      "text": "HILL"
    },
    {
      "type": "dialogue",
      "text": "No. Hill takes a sip of water before continuing..."
    },
    {
      "type": "character",
      "text": "HILL (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Because of the personal vindictiveness he demonstrated against Dr Oppenheimer, and against all those who have disagreed with his official positions. Counsel turns to Strauss, who is FIXATED on Hill. The Senate Aide REACTS, surprised. MURMURS echo through the chamber..."
    },
    {
      "type": "character",
      "text": "HILL (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "In my ten years observation of Mr Strauss I have seen his incapacity to change a position, the subordination of his integrity to the attainment of political goals and an obsessive quest for popular and professional approval... The audience REACTS- Strauss SHAKES his head- the Chairman BANGS the gavel-"
    },
    {
      "type": "character",
      "text": "CHAIRMAN"
    },
    {
      "type": "dialogue",
      "text": "Order!"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  173.173."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "Vannevar Bush is sworn in."
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "It appears to most scientists around the country that Oppenheimer is now being pilloried and put through an ordeal because he expressed his honest opinions. The written charges against him are in a poorly written indictment which the board should have rejected from the outset."
    },
    {
      "type": "character",
      "text": "EVANS"
    },
    {
      "type": "dialogue",
      "text": "Dr Bush, I thought I was performing a service to my country in hearing this case."
    },
    {
      "type": "character",
      "text": "BUSH"
    },
    {
      "type": "dialogue",
      "text": "No board in this country should sit in judgement of a man because he expressed strong opinions. If you want to try that case, you can try me- I have expressed strong opinions, often unpopular, many times. I’m doing so right now. When a man is pilloried for doing that, this country is in a severe state... excuse me, gentlemen, if I become stirred, but I am."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss fumes as Hill reads his statement."
    },
    {
      "type": "character",
      "text": "HILL"
    },
    {
      "type": "dialogue",
      "text": "From the standpoint of public welfare, the most injurious exercise of personal vindictiveness in which Lewis Straus has engaged was in the personnel security prosecution of J. Robert Oppenheimer, who had not hesitated to disagree with Mr Strauss on certain questions of fundamental policy."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  174.174."
    },
    {
      "type": "character",
      "text": "HILLHILL  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "Oppenheimer made mincemeat out of Strauss’ position on the shipments of isotopes to Norway, and Strauss never forgave him this public humiliation. Another controversy between them centreed around their differences in judgement on how the H-bomb would contribute to national security. Oppenheimer had considerable influence and prestige, and Strauss was able to find a few ambitious men who also disagreed with Oppenheimer’s position, and envied him his prestige in government circles. Teller, in the audience, stares at Hill..."
    },
    {
      "type": "character",
      "text": "HILL (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Strauss turned to the personnel security system in order to destroy Oppenheimer’s effectiveness-"
    },
    {
      "type": "character",
      "text": "SENATOR PASTORE"
    },
    {
      "type": "dialogue",
      "text": "But, Dr Hill, we’ve already heard that Mr Strauss did not bring the charges, or participate in the hearings against Dr Oppenheimer."
    },
    {
      "type": "character",
      "text": "HILL"
    },
    {
      "type": "dialogue",
      "text": "I realize that Mr Strauss didn’t sign the letter of charges, but I think when all of the evidence is viewed, it becomes highly plausible that the Oppenheimer matter was initiated and carried through largely through the animus of Lewis Strauss."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "Groves is testifying."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "General, would you clear Dr Oppenheimer today?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  175.175."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "Under my interpretation of the Atomic Energy Act, which did not exist when I hired Dr Oppenheimer in 1942... I would not clear Dr Oppenheimer today if I were a member of the commission."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Thank you, General."
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "But I’m not sure I could’ve cleared any of those guys."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "That’s all."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "General, Dr Oppenheimer had no responsibility for the selection or clearance of Klaus Fuchs, did he?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "No, not at all."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "You wouldn’t want to leave with this board even the remotest suggestion that you’re here questioning Dr Oppenheimer’s basic loyalty to the United States in the operation of Los Alamos?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "By no means. I hope I didn’t lead anybody to think otherwise for an instant."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Would you say that the revocation of Dr Oppenheimer’s position would be in the public interest?"
    },
    {
      "type": "character",
      "text": "GROVES"
    },
    {
      "type": "dialogue",
      "text": "The revocation under such extreme publicity I think would be most unfortunate, not because of the effect on Dr Oppenheimer- that I leave to one side- but because of the disastrous effect upon the attitude of the scientists of this country toward doing government research."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  176.176."
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "dialogue",
      "text": "Thank you, General. Groves gets up, walks past me with a formal nod."
    },
    {
      "type": "scene-heading",
      "text": "INT. CORRIDOR OUTSIDE ROOM 2022 -- DAY"
    },
    {
      "type": "action",
      "text": "Garrison checks his watch."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "She’ll be here."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Do you even want her here?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Only a fool or an adolescent presumes to know someone else’s relationship, and you’re neither, Lloyd. Kitty comes around the corner. Unsteady. I watch her walk towards us, not entirely straight... she catches my eye-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Kitty and I, we’re grown-ups. We’ve walked through fire together. And she’ll do fine."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "Kitty is at the witness table. From behind I can see her fiddling distractedly with her purse..."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Mrs Oppenheimer, you are no longer a member of the Communist Party?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "When would you say that you ceased to be a member?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "When I left Youngstown in 1936."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "Will you describe your views on Communism as pro, anti, neutral."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  177.177."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Very strongly against. I’ve had nothing to do with Communism since 1936. Since before I met Robert."
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "That’s all."
    },
    {
      "type": "character",
      "text": "HILL (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "The record demonstrates that Oppenheimer was not interrogated by impartial and disinterested counsel for the Gray Board... Robb gets up to cross-examine..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE COMMITTEE HEARING ROOM -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss watches Hill continue to answer questions..."
    },
    {
      "type": "character",
      "text": "HILL"
    },
    {
      "type": "dialogue",
      "text": "...he was interrogated by a prosecutor who used all the tricks of a rather ingenious legal background to try to trick Oppenheimer into erroneous statements, and he did succeed in a few instances."
    },
    {
      "type": "character",
      "text": "SENATOR SCOTT"
    },
    {
      "type": "dialogue",
      "text": "You are charging now that the Gray Board permitted a prosecution of Dr Oppenheimer. Do you think, then, that the members of the Gray Board were unfair? Hill takes a beat to consider this."
    },
    {
      "type": "character",
      "text": "HILL"
    },
    {
      "type": "dialogue",
      "text": "I can only say if I’d been on the Gray Board, I would’ve protested against the tactics of the man who served in fact as a prosecuting counsel- a man appointed not by the board but by Lewis Strauss. Strauss strokes his chin, feigning indifference."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  178.178."
    },
    {
      "type": "character",
      "text": "SENATOR MCGEE"
    },
    {
      "type": "dialogue",
      "text": "Who was this?"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "character",
      "text": "HILL (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Roger Robb. Robb tries to put himself in Kitty’s eyeline..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Mrs Oppenheimer. She will not meet his gaze."
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Did you have a Communist Party membership card?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "I, I’m not sure... Kitty fiddles with her purse..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Not sure?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Well... She FREEZES. The Board members look at her. Garrison looks at me..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Presumably the act of joining the Party was sending some money and receiving a card? Kitty is focused on her purse..."
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "No? And then Kitty LOOKS UP at Robb, pure STEEL-"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "It was so long ago, Mr Robb, wasn’t it?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  179.179."
    },
    {
      "type": "action",
      "text": "ROBB Not really- KITTY (CONT’D) Long enough to have forgotten."
    },
    {
      "type": "action",
      "text": "ROBB (CONT’D) Did you turn in the card or KITTY (CONT’D) rip it up? The card whose existence I’ve forgotten?"
    },
    {
      "type": "action",
      "text": "ROBB (CONT’D) Your Communist Party KITTY (CONT’D) membership card- I haven’t the slightest idea."
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Can a distinction be made between Soviet Communism and Communism?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "In the days when I was a member I thought they were definitely two things- Garrison and I hang on her every word..."
    },
    {
      "type": "character",
      "text": "KITTY (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I thought the Communist Party of the United States was concerned with our domestic problems. I now no longer believe this. I believe the whole thing is linked together and spread all over the world. I’ve believed this since I left the Party sixteen years ago. ROBB But- KITTY (CONT’D) Seventeen years ago. My mistake. ROBB (CONT’D) But you- KITTY (CONT’D) Sorry, eighteen. Yes, eighteen years ago. Robb sighs patiently."
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Were you familiar with the fact that your husband was making contributions to the Spanish Civil War as late as 1942?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  180.180."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "I knew that Robert gave money from time to time, yes."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Do you remember whether he gave money on a regular or periodic basis? Kitty smiles sweetly-"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Do you mean regular, or do you mean periodic, Mr Robb?"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "parenthetical",
      "text": "(annoyed)"
    },
    {
      "type": "dialogue",
      "text": "I mean... regular."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "He did not."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Were you aware that this money was going into Communist Party channels?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Don’t you mean 'through'?"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Pardon?"
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "I think you mean 'through Communist Party channels'. ROBB Yes. KITTY (CONT’D) Yes."
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Would it be fair to say that this meant that by 1942 he had not stopped having anything to do with the Communist Party? I don’t insist that you answer yes or no. You can answer any way you wish."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "I know that. Thank you. But the question isn’t properly phrased."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  181.181."
    },
    {
      "type": "action",
      "text": "ROBB Don’t you understand what I KITTY (CONT’D) am trying to get at? Yes, I do."
    },
    {
      "type": "action",
      "text": "ROBB (CONT’D) Why don’t you answer it that KITTY (CONT’D) way? I don’t like the phrase 'having anything to do with the Communist Party' because Robert never had anything to do with the Communist Party as such. I know he gave money for Spanish refugees. I know he took an intellectual interest in Communist ideas-"
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Are there two kinds of Communists? An intellectual Communist and a plain ordinary Commie? Kitty laughs the laugh of the free."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "I couldn’t answer that one."
    },
    {
      "type": "character",
      "text": "EVANS"
    },
    {
      "type": "parenthetical",
      "text": "(delighted)"
    },
    {
      "type": "dialogue",
      "text": "I couldn’t either. Gray shoots a look at Evans. CHUCKLES around the room. Garrison looks at me. Nods. She did good."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY"
    },
    {
      "type": "action",
      "text": "I watch Teller testify."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Is it your intention to suggest that Dr Oppenheimer is disloyal to the United States?"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "I do not want to suggest anything of the kind. I have always assumed, and now assume, that he is loyal to the United States. I believe this, and I shall believe it until I see very conclusive proof to the opposite."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  182.182."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Now, a question which is a corollary of that... do you or do you not believe that Dr Oppenheimer is a security risk?"
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "In a great number of cases I have seen Dr Oppenheimer act in a way which for me was exceedingly hard to understand. I thoroughly disagreed with him in numerous issues, and his actions, frankly, appeared to me confused and complicated. To this extent, I feel that I would like to see the vital interests of this country in hands which I understand better and therefore trust more."
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "dialogue",
      "text": "Thank you, doctor. Teller gets up from the table, as he walks past me he holds out his hand..."
    },
    {
      "type": "character",
      "text": "TELLER"
    },
    {
      "type": "dialogue",
      "text": "I’m sorry. I shake his hand."
    },
    {
      "type": "character",
      "text": "KITTY (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "You shook his fucking hand?!"
    },
    {
      "type": "scene-heading",
      "text": "INT. DINING ROOM, OLDEN MANOR, PRINCETON -- NIGHT"
    },
    {
      "type": "character",
      "text": "KITTY (CONT'D)"
    },
    {
      "type": "dialogue",
      "text": "I would’ve spat in his face!"
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "I’m not sure the board would’ve appreciated that."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Not gentlemanly enough? You’re all being too goddamn gentlemanly."
    },
    {
      "type": "character",
      "text": "VOLPE"
    },
    {
      "type": "dialogue",
      "text": "Gray must see what Robb is doing- why doesn’t he shut him down? Garrison shrugs."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  183.183."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "parenthetical",
      "text": "(to me)"
    },
    {
      "type": "dialogue",
      "text": "And you? Shaking Teller’s hand- you need to stop playing the martyr."
    },
    {
      "type": "scene-heading",
      "text": "EXT. OLDEN MANOR, PRINCETON -- NIGHT"
    },
    {
      "type": "action",
      "text": "Garrison drives off. Volpe turns to me..."
    },
    {
      "type": "character",
      "text": "VOLPE"
    },
    {
      "type": "dialogue",
      "text": "Robert, you can’t win this thing. It’s a kangaroo court with a predetermined outcome. Why put yourself through more of it?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I have my reasons. Volpe shrugs. Embraces me. Gets in his car."
    },
    {
      "type": "character",
      "text": "EINSTEIN (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "He has a point, you know. I turn. Einstein steps into the light."
    },
    {
      "type": "character",
      "text": "EINSTEIN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You’re a man chasing a woman who doesn’t love him any more- the United States Government."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I’m not sure you understand, Albert."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "No? I left my country, never to return. The German calamity of years ago repeats itself- people acquiesce without resistance and align themselves with the forces of evil. You’ve served America well, and if this is the reward she has to offer perhaps you should turn your back on her."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Dammit, I happen to love this country. Einstein considers this. Nods slowly."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  184.184."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "Then tell them to go to hell."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss BURSTS in, fuming..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "This has become a trial about a trial!"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "It’s not a good thing that he’s telling them that you initiated the hearings."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "He can’t prove that I gave the file to Borden."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "He doesn’t have to. We’re not in court, there’s no burden of proof... Strauss realizes. Shakes his head at himself."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "They’re not convicting. Just denying. The Senate Aide nods."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Why would Hill come here to tear me down? What’s his angle?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Do people need a reason to do the right thing? Strauss GLARES at the Senate Aide."
    },
    {
      "type": "character",
      "text": "SENATE AIDE (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I mean, as he sees it."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I told you Oppenheimer poisoned the scientists against me! Right from that first meeting..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  185.185."
    },
    {
      "type": "action",
      "text": "INSERT CUT: STRAUSS WATCHES OPPENHEIMER HAND EINSTEIN HIS HAT AS THEY SPEAK DOWN AT THE LAKE..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I don’t know what Oppenheimer said to him that day, but Einstein wouldn’t even meet my eye... INSERT CUT: AS STRAUSS APPROACHES, EINSTEIN WALKS PAST WITHOUT ACKNOWLEDGING HIM, CLEARLY UPSET..."
    },
    {
      "type": "character",
      "text": "STRAUSS (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Oppenheimer knows how to manipulate his own. At Los Alamos he preyed on the naïveté of scientists who thought they’d get a say in how we used their work... but don’t ever think he was that naïve himself..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "I am back at the witness table. Robb squares up."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Doctor, in your work on the Hydrogen bomb at Los Alamos and in the years following, were you deterred by any moral qualms about the development of this weapon?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Of course."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "But you still got on with the work, didn’t you?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Yes, because this was work of exploration. It was not the preparation of a weapon."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "You mean it was just an academic excursion?"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  186.186."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No. It’s not an academic thing whether you can make a Hydrogen bomb. It’s a matter of life and death."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Beginning in 1942 you were actively pushing the development of the H- bomb, weren’t you?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "'Pushing' is not the right word. Supporting and working on it, yes."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "When did these moral qualms become so strong that you opposed the development of the Hydrogen bomb?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "When it was suggested that it be the policy of the United States to make these things at all costs, without regard to the balance between these weapons and atomic weapons as part of our arsenal."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "parenthetical",
      "text": "(theatrical confusion)"
    },
    {
      "type": "dialogue",
      "text": "What did moral qualms have to do with that?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "parenthetical",
      "text": "(struggling)"
    },
    {
      "type": "dialogue",
      "text": "What did moral qualms have to do with it?"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Yes."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss is pacing now..."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Oppenheimer wanted to own the atomic bomb. He wanted to be the man who moved the earth."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  187.187."
    },
    {
      "type": "character",
      "text": "STRAUSSSTRAUSS  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "He talks about putting the nuclear genie back in the bottle- well, I’m here to tell you that I know J Robert Oppenheimer and if he could do it all over he’d do it all the same. He’s never once said he regrets Hiroshima- he’d do it all over because it made him the most important man who ever lived..."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "I struggle to find an answer for Robb..."
    },
    {
      "type": "action",
      "text": "OPPENHEIMER We freely used the atomic ROBB bomb. In fact, doctor, you assisted in selecting the target for the drop of the atomic bomb on Japan?"
    },
    {
      "type": "action",
      "text": "Now I can hear the sound of FEET STAMPING..."
    },
    {
      "type": "action",
      "text": "OPPENHEIMER (CONT’D) Yes. ROBB (CONT’D) You knew, did you not, that the dropping of that atomic bomb on the target you had selected would kill or injure thousands of civilians, is that correct?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Not as many as turned out..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "How many were killed or injured? The feet are stamping FASTER and FASTER..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Seventy thousand. ROBB Seventy thousand? At both OPPENHEIMER (CONT’D) Hiroshima and- One hundred and ten thousand at both."
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "On the day of each bombing."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Yes."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  188.188."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "And in the weeks and years after?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It’s been put at between fifty and one hundred thousand..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Two hundred and twenty thousand dead? At least? I nod."
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Did you have moral scruples about that?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Terrible ones."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "But you testified the other day that the bombing of Hiroshima was very successful? OPPENHEIMER Well, it was technically ROBB (CONT’D) successful. Oh, technically."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "It’s also alleged to have helped end the war. The stamping feet are LOUDER and FASTER..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Would you have supported the dropping of a Hydrogen bomb on Hiroshima?"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss TURNS on the Senate Aide-"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "But he wanted all the glory and none of the responsibility. So he needed absolution. He needed to be a martyr. To suffer, and take the sins of the world on his shoulders. To say 'no, we cannot continue on this road' even as he knew we’d have to..."
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  189.189."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "I search for an answer- the FEET STAMPING ever LOUDER-"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "It would make no sense at all."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Why?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "The target is too small."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Supposing there had been a target in Japan big enough for a thermonuclear weapon, would you have opposed dropping it? OPPENHEIMER This was not a problem with ROBB (CONT’D) which I was confronted. I’m confronting you with it now, sir. Would you have opposed the dropping of a thermonuclear weapon on Japan because of moral scruples?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I believe I would, sir."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Did you oppose the dropping of the atom bomb on Hiroshima because of moral scruples? OPPENHEIMER We set forth our- ROBB (CONT’D) I’m asking you about it, not 'we'."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I set forth arguments against dropping it. But I did not endorse them."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss PACES the room, FURIOUS-"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "He knew he’d have to be seen to suffer for what he did. It was all part of his plan."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  190.190."
    },
    {
      "type": "character",
      "text": "STRAUSSSTRAUSS  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "He wanted the glorious insincere guilt of the self-important to wear like a fucking crown. And I gave it to him..."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "Robb gets right in my face, incredulous-"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "You mean having worked night and day for three years to build the bomb, you then argued it shouldn’t be used?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "No. I was asked by the Secretary of War what the views of scientists were- I gave the views against and the views for. ROBB You supported the dropping of OPPENHEIMER (CONT’D) the atom bomb on Japan, What do you mean 'support'? didn’t you?"
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You helped pick the target, didn’t you?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I did my job- I was not in a policy- making position at Los Alamos- I would have done anything that I was asked to do-"
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "You would have made the H-bomb too wouldn’t you?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I couldn’t. The STAMPING breaks rhythm to become CACOPHONOUS... ROBB I didn’t ask you that, OPPENHEIMER (CONT’D) doctor! I would have worked on it, yes. But to run a labouratory is one thing, to advise a government is another. THE LIGHT OF A THOUSAND SUNS POURS IN THE WINDOW..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  191.191."
    },
    {
      "type": "character",
      "text": "ROBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "And the GAC report, which you co- authored, following the Russian atomic test said that a Super bomb should never be produced, did it not!"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "What we meant- what I meant- was that it would be a better world if there were no Hydrogen bombs in it. LIGHT STABS THROUGH CRACKS IN THE WALL..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "Wouldn’t the Soviets do anything to increase their military strength?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "If we did it, they’d have to do it. Our efforts would fuel their efforts- just as it had with the atomic bomb! PLASTER BREAKS AWAY AS LIGHT POURS INTO THE ROOM... I JAM my eyes closed, MORE AND MORE EXPOSED..."
    },
    {
      "type": "character",
      "text": "ROBB"
    },
    {
      "type": "dialogue",
      "text": "'Just as with the atomic bomb.' Exactly. No moral scruples in 1945, plenty in 1949... The sound STOPS. The light is gone."
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "parenthetical",
      "text": "(gentle)"
    },
    {
      "type": "dialogue",
      "text": "Dr Oppenheimer, when did your strong moral convictions develop with respect to the Hydrogen bomb? I open my eyes, exhausted..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "When it became clear to me that we would tend to use any weapon we had. Silence."
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss has stopped..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  192.192."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "J. Robert Oppenheimer- the martyr. I gave him exactly what he wanted. To be remembered for Trinity, not Hiroshima, not Nagasaki. He should be thanking me."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Well, he’s not. Strauss looks at the Senate Aide’s neck, wondering if he could get one hand all the way around it."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "parenthetical",
      "text": "(speaking softly)"
    },
    {
      "type": "dialogue",
      "text": "Do you still have enough votes, or is the crowning moment of my career about to become the most public humiliation of my life? The Senate Aide looks down at his buck slip, counts his tally."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "You’ll scrape through. Strauss looks at the Senate Aide. He smiles."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Then gather the press."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM 2022, ATOMIC ENERGY COMMISSION -- DAY (COLOUR)"
    },
    {
      "type": "action",
      "text": "I sit with Garrison and listen to Gray pass judgement..."
    },
    {
      "type": "character",
      "text": "GRAY"
    },
    {
      "type": "dialogue",
      "text": "J. Robert Oppenheimer, this board, having heard testimony from you and many of your current and former colleagues, has come to the unanimous conclusion that you are a loyal citizen..."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)(MORE)"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  193.193."
    },
    {
      "type": "character",
      "text": "GRAYGRAY  (CONT(CONT’’D)D)"
    },
    {
      "type": "dialogue",
      "text": "However, in the light of your continuing associations and disregard for the security apparatus of this country, together with your somewhat disturbing conduct in relation to the Hydrogen bomb and the regrettable lack of candor in certain of your responses to this board, we have voted two to one to deny the renewal of your security clearance. I barely hear the rest..."
    },
    {
      "type": "character",
      "text": "GRAY (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "A full written opinion, with a dissent from Mr Evans, will be issued to the AEC in the coming days... The board rises, aides start collecting files. Still dazed, I take the phone from Garrison-"
    },
    {
      "type": "character",
      "text": "GARRISON"
    },
    {
      "type": "dialogue",
      "text": "It’s Kitty."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "parenthetical",
      "text": "(over phone)"
    },
    {
      "type": "dialogue",
      "text": "Robert? Robert? I take a breath. Not trusting my voice..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Don’t... don’t... don’t... take in the sheets."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "We hear the press gathering behind the doors. Strauss checks his tie in the mirror. Smooths his hair. The Senate Aide enters, buck slip in hand."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Is it official?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "I’m afraid there were a couple of unexpected holdouts. Strauss freezes, absorbing the impact."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  194.194."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I’m denied? The Senate Aide leaves him hanging for a beat."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "I’m afraid so, sir. Strauss doesn’t know what to do or where to look."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Who were the holdouts?"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "There were three, led by the junior senator from Massachusetts. Young guy, trying to make a name for himself. Didn’t like what you did to Oppenheimer."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "What’s his name? The Senate Aide checks his tally..."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Uh... Kennedy. John F. Kennedy."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. OLDEN MANOR, BACK GATE OVERLOOKING THE INSTITUTE -- DAY"
    },
    {
      "type": "parenthetical",
      "text": "(COLOUR)"
    },
    {
      "type": "dialogue",
      "text": "I approach Kitty, who’s been crying."
    },
    {
      "type": "character",
      "text": "KITTY"
    },
    {
      "type": "dialogue",
      "text": "Did you think if you let them tar and feather you the world would forgive you? It won’t."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "We’ll see."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. SENATE OFFICE -- DAY (B&W)"
    },
    {
      "type": "action",
      "text": "Strauss listens to the hungry press pack beyond the door. He TURNS on the Senate Aide-"
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  195.195."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "Goddamn it! You told me I’d be fine!"
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Well, I didn’t have all the facts, did I?"
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "I did what was right for this country. They don’t want me in the Cabinet Room? Maybe they should just invite Oppenheimer instead."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "Perhaps they will."
    },
    {
      "type": "character",
      "text": "STRAUSS"
    },
    {
      "type": "dialogue",
      "text": "He turned the scientists against me. One by one. Starting with Einstein. I told you about that? About Einstein, by the pond? The Senate Aide picks up Strauss’s hat and coat..."
    },
    {
      "type": "character",
      "text": "SENATE AIDE"
    },
    {
      "type": "dialogue",
      "text": "You did. But, you know, sir, since nobody knows what they said to each other that day, is it possible they didn’t talk about you at all? Is it possible they spoke about something... Hands Strauss his hat and coat..."
    },
    {
      "type": "character",
      "text": "SENATE AIDE (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "...more important? Strauss looks at the Senate Aide like he wants to kill him. The Senate Aide OPENS the office door and the FLASHBULBS EAT STRAUSS ALIVE as we-"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. LAKESIDE, INSTITUTE FOR ADVANCED STUDY, PRINCETON -- DAY"
    },
    {
      "type": "parenthetical",
      "text": "(COLOUR)"
    },
    {
      "type": "dialogue",
      "text": "I approach the figure by the lake. The figure’s hat BLOWS off, releasing a mass of GREY CURLS. Strauss watches from the doorway as I scoop up Einstein’s hat..."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "Robert. The man of the moment."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "dialogue",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  196.196. I hand him his hat. He looks out at the lake."
    },
    {
      "type": "character",
      "text": "EINSTEIN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You once had a reception for me at Berkeley. Gave me an award. You all believed I’d lost the ability to understand what I’d started. So that award wasn’t for me... it was for all of you. Einstein turns to me."
    },
    {
      "type": "character",
      "text": "EINSTEIN (CONT'D) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Now it’s your turn to deal with the consequences of your achievements. And one day... when they’ve punished you enough..."
    },
    {
      "type": "scene-heading",
      "text": "INT. CABINET ROOM, WHITE HOUSE -- DAY"
    },
    {
      "type": "action",
      "text": "Dozens of formally attired GUESTS. Kitty by my side. Many faces, now older, are there - Rabi, Lawrence, Frank, Jackie..."
    },
    {
      "type": "character",
      "text": "EINSTEIN (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "They’ll serve salmon and potato salad, make speeches, give you a medal... LYNDON JOHNSON places a MEDAL around my neck. I SMILE and shake the President’s hand. Kitty BEAMS as she, in turn, shakes Johnson’s hand... Frank comes up to me, gives me a quick embrace-"
    },
    {
      "type": "character",
      "text": "FRANK"
    },
    {
      "type": "dialogue",
      "text": "You’re happy, I’m happy..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Then I’m happy you’re happy. Lawrence claps me on the shoulder, smiling affectionately..."
    },
    {
      "type": "character",
      "text": "EINSTEIN (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Pat you on the back and tell you all is forgiven... Teller approaches, I smile and take his offered hand..."
    },
    {
      "type": "character",
      "text": "EINSTEIN (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Just remember. It won’t be for you..."
    },
    {
      "type": "parenthetical",
      "text": "(CONTINUED)(CONTINUED)"
    },
    {
      "type": "action",
      "text": "8FLiX.com FYC SCREENPLAY DATABASE 20230904"
    },
    {
      "type": "action",
      "text": "GadgetGadget  2023-04-212023-04-21  FINAL Shooting ScriptFINAL Shooting Script  197.197."
    },
    {
      "type": "action",
      "text": "Teller turns to Kitty, offering the same smile and handshake..."
    },
    {
      "type": "character",
      "text": "EINSTEIN (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "...it’ll be for them. Kitty STARES Teller down, letting his hand hang in the air like a WILTING PLANT... and we-"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. LAKESIDE, INSTITUTE FOR ADVANCED STUDY, PRINCETON -- DAY"
    },
    {
      "type": "action",
      "text": "Einstein TURNS to leave. Up the hill, Strauss approaches..."
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "Albert? When I came to you with those calculations? Einstein pauses. I watch raindrops make circles on the surface of the pond"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER (CONT'D) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "We were worried that we’d start a chain reaction that would destroy the entire world..."
    },
    {
      "type": "character",
      "text": "EINSTEIN"
    },
    {
      "type": "dialogue",
      "text": "I remember it well. What of it?"
    },
    {
      "type": "character",
      "text": "OPPENHEIMER"
    },
    {
      "type": "dialogue",
      "text": "I believe we did. Einstein PALES. TURNS, passing Strauss without a word. The sound of FEET STAMPING... CLOSE IN ON: my staring eyes as I visualize THE EXPANDING NUCLEAR ARSENALS OF THE WORLD... THE FEET, FASTER AND FASTER- When I can take it no longer, I JAM my eyes CLOSED and we-"
    },
    {
      "type": "transition",
      "text": "CUT TO BLACK."
    },
    {
      "type": "action",
      "text": "CREDITS."
    },
    {
      "type": "action",
      "text": "END."
    }
  ],
  "stacks": {},
