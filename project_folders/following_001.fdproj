            "image": "data:image/svg+xml;utf8,%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20960%20540%22%20width%3D%22100%25%22%20height%3D%22100%25%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cdefs%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3ClinearGradient%20id%3D%22bg%22%20x1%3D%220%25%22%20y1%3D%220%25%22%20x2%3D%220%25%22%20y2%3D%22100%25%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%220%25%22%20stop-color%3D%22%230b111e%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%22100%25%22%20stop-color%3D%22%23030509%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2FlinearGradient%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3CradialGradient%20id%3D%22glow%22%20cx%3D%2250%25%22%20cy%3D%2250%25%22%20r%3D%2250%25%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%220%25%22%20stop-color%3D%22%2338bdf8%22%20stop-opacity%3D%220.35%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cstop%20offset%3D%22100%25%22%20stop-color%3D%22%2338bdf8%22%20stop-opacity%3D%220%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2FradialGradient%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fdefs%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Crect%20width%3D%22960%22%20height%3D%22540%22%20fill%3D%22url(%23bg)%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ccircle%20cx%3D%22480%22%20cy%3D%22270%22%20r%3D%22270%22%20fill%3D%22url(%23glow)%22%20%2F%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cline%20x1%3D%22316.8%22%20y1%3D%220%22%20x2%3D%22316.8%22%20y2%3D%22540%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.06)%22%20stroke-dasharray%3D%224%206%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cline%20x1%3D%22633.6%22%20y1%3D%220%22%20x2%3D%22633.6%22%20y2%3D%22540%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.06)%22%20stroke-dasharray%3D%224%206%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cline%20x1%3D%220%22%20y1%3D%22178.20000000000002%22%20x2%3D%22960%22%20y2%3D%22178.20000000000002%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.06)%22%20stroke-dasharray%3D%224%206%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cline%20x1%3D%220%22%20y1%3D%22356.40000000000003%22%20x2%3D%22960%22%20y2%3D%22356.40000000000003%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.06)%22%20stroke-dasharray%3D%224%206%22%20%2F%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cpath%20d%3D%22M%20440%20405%20Q%20480%20205.2%20520%20405%20Z%22%20fill%3D%22rgba(0%2C0%2C0%2C0.65)%22%20stroke%3D%22%2338bdf8%22%20stroke-width%3D%221.5%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ccircle%20cx%3D%22480%22%20cy%3D%22226.79999999999998%22%20r%3D%2218%22%20fill%3D%22rgba(0%2C0%2C0%2C0.75)%22%20stroke%3D%22%2338bdf8%22%20stroke-width%3D%221.5%22%20%2F%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cg%20transform%3D%22translate(480%2C%20442.79999999999995)%22%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cline%20x1%3D%22-35%22%20y1%3D%220%22%20x2%3D%2235%22%20y2%3D%220%22%20stroke%3D%22%2338bdf8%22%20stroke-width%3D%222%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Cpolygon%20points%3D%2235%2C-4%2045%2C0%2035%2C4%22%20fill%3D%22%2338bdf8%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctext%20x%3D%220%22%20y%3D%22-8%22%20text-anchor%3D%22middle%22%20fill%3D%22%2338bdf8%22%20font-family%3D%22sans-serif%22%20font-size%3D%2211%22%20font-weight%3D%22bold%22%20letter-spacing%3D%221%22%3ECAMERA%3A%20STATIC%3C%2Ftext%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fg%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Crect%20x%3D%2220%22%20y%3D%2220%22%20width%3D%22auto%22%20height%3D%2224%22%20rx%3D%224%22%20fill%3D%22rgba(0%2C0%2C0%2C0.7)%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.15)%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctext%20x%3D%2230%22%20y%3D%2236%22%20fill%3D%22%23ffffff%22%20font-family%3D%22'Space%20Grotesk'%2C%20monospace%22%20font-size%3D%2212%22%20font-weight%3D%22bold%22%3E%F0%9F%8E%AC%20WIDE%20SHOT%3C%2Ftext%3E%0A%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Crect%20x%3D%2220%22%20y%3D%22492%22%20width%3D%22920%22%20height%3D%2232%22%20rx%3D%226%22%20fill%3D%22rgba(0%2C0%2C0%2C0.75)%22%20stroke%3D%22rgba(255%2C255%2C255%2C0.12)%22%20%2F%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3Ctext%20x%3D%2232%22%20y%3D%22513%22%20fill%3D%22%23e2e2e6%22%20font-family%3D%22sans-serif%22%20font-size%3D%2212%22%20font-weight%3D%22600%22%3EINT.%20BALLROOM%20-%20DARKNESS%20-%2012%3A01%3A03%20AM%20%E2%80%94%20Julian%20can't%20see%20a%20thing.%20But%20in%20the%20black%2C%20Chloe's%20skin%20glows%20--%20faint%2C%20impossible%2C%20stati...%3C%2Ftext%3E%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%3C%2Fsvg%3E",
            "ts": 1787347900604
          }
        }
      }
    ]
  },
  "references": {
    "activeCategory": "directing",
    "items": []
  },
  "script": [
    {
      "type": "center-title",
      "text": "THE FOLLOWING"
    },
    {
      "type": "center-title",
      "text": "WRITTEN BY"
    },
    {
      "type": "center-title",
      "text": "CHRISTOPHER NOLAN"
    },
    {
      "type": "action",
      "text": "T H E F O L L O W I N G"
    },
    {
      "type": "scene-heading",
      "text": "EXT. CROWDED LONDON STREET - DAY"
    },
    {
      "type": "action",
      "text": "An endless stream of pedestrians crossing the frame."
    },
    {
      "type": "action",
      "text": "Cut to a shot looking through pedestrians and reflections of pedestrians of a Young Man sitting in the window of a coffee shop, looking out at the people walking past."
    },
    {
      "type": "character",
      "text": "MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "The following is my explanation... well, my... my account of... well, what happened."
    },
    {
      "type": "action",
      "text": "The Young Man is tall and slim, mid- to late twenties, with dark, long, greasy hair and unshaven."
    },
    {
      "type": "action",
      "text": "We cut to the Young Man outside, on the street. He is peering ahead as he walks, as if trying to spot a lost friend."
    },
    {
      "type": "character",
      "text": "MALE VOICE (V.O.) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I’d, ah, been on my own for quite a while by then and I’d become...lonely..."
    },
    {
      "type": "action",
      "text": "A wide shot shows the Young Man amidst a bustling Oxford Street crowd."
    },
    {
      "type": "character",
      "text": "MALE VOICE (V.O.) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "...and bored. Nothing to do all day, you see. That’s when I began shadowing."
    },
    {
      "type": "character",
      "text": "OLDER MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Shadowing?"
    },
    {
      "type": "character",
      "text": "MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Yeah, shadowing, following. I started to follow people."
    },
    {
      "type": "action",
      "text": "The young man cuts purposefully through the crowd, in slo-mo."
    },
    {
      "type": "character",
      "text": "OLDER MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Who?"
    },
    {
      "type": "character",
      "text": "MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Anyone, a stranger, I mean that was the whole point; following someone completely at random. Anyone who wouldn’t know who you were."
    },
    {
      "type": "action",
      "text": "The Young Man is staring at someone fixedly as he moves in slo-mo. His POV shows us a man’s back dodging between other people, always threatening to lose us, still in slo-mo."
    },
    {
      "type": "character",
      "text": "OLDER MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "And then?"
    },
    {
      "type": "character",
      "text": "MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "And then nothing."
    },
    {
      "type": "action",
      "text": "We SNAP INTO REAL TIME. The man’s back disappears into the crowd and we cease to follow him. The noises of the city come up loud."
    },
    {
      "type": "action",
      "text": "The Young Man has come to a virtual standstill. He watches the world washing around him."
    },
    {
      "type": "character",
      "text": "OLDER MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Nothing?"
    },
    {
      "type": "character",
      "text": "MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Nothing. I’d follow somebody for a while then pick someone else and follow them or go home or whatever."
    },
    {
      "type": "action",
      "text": "The Young Man’s eyes dart about, watching the people around him. He starts to wander down the road, pulled gently by the flow of pedestrians."
    },
    {
      "type": "character",
      "text": "OLDER MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "Why did you do it?"
    },
    {
      "type": "character",
      "text": "MALE VOICE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "How can I explain? Your eyes pass over the crowd..."
    },
    {
      "type": "action",
      "text": "We pan across endless anonymous faces."
    },
    {
      "type": "character",
      "text": "MALE VOICE (V.O.) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "...and if you let them settle on a person, then that person becomes an individual..."
    },
    {
      "type": "action",
      "text": "We fix on a face, a woman hurrying along."
    },
    {
      "type": "character",
      "text": "MALE VOICE (V.O.) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "...just...like...THAT..."
    },
    {
      "type": "action",
      "text": "SHOCK CUT on the sound of SNAPPING FINGERS at ‘THAT’ to:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM WITH TABLE - DAY"
    },
    {
      "type": "action",
      "text": "Close on fingers in front of the Young Man’s face. He looks different: hair short, clean shaven, bruised face, a plaster over one eye. Seated opposite is an OLDER MAN."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "It just became...irresistible."
    },
    {
      "type": "action",
      "text": "The Older Man considers this before replying."
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "parenthetical",
      "text": "(suspicious)"
    },
    {
      "type": "dialogue",
      "text": "So you followed women?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "It wasn’t some sex thing. I followed anyone. Just for the sake of it, just to see where they went, what they were doing."
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "dialogue",
      "text": "You were playing secret agent."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(knows its true, but doesn’t like it)"
    },
    {
      "type": "dialogue",
      "text": "No... I’m a writer- I want to be a writer. I wanted to gather material for characters, you know, to write about them. All I did was follow people- to begin with."
    },
    {
      "type": "transition",
      "text": "DISSOLVE TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. BUSY STREET IN THE WEST END - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man (long hair, unshaven) exits a café and stumbles along the road. His eye is caught by a man passing by in the opposite direction. The man is in his mid-twenties, tall, dark haired wearing a dark suit. He is carrying an overnight bag."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (V.O.) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I spotted the dangers soon enough. I could tell I was hooked and I made up rules."
    },
    {
      "type": "action",
      "text": "The Young Man turns about and starts to follow, speeding up so as not to lose the fast-moving Dark Suit."
    },
    {
      "type": "action",
      "text": "Dark Suit weaves in an out of other pedestrians, his bag slung over his shoulder, heavy."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (V.O.) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "...I wouldn’t let myself follow anyone for too long. I wouldn’t follow women after dark, stuff like that, simple things just to keep in all under control."
    },
    {
      "type": "action",
      "text": "The Young Man follows, coming up behind Dark Suit as he waits at a crossing. The lights change and they head across the road, the Young Man hanging back slightly."
    },
    {
      "type": "action",
      "text": "Dark Suit enters Charing Cross station, the Young Man in pursuit. Dark Suit crosses the station to the left-luggage office where he hands his bag to the attendant behind the counter and takes his ticket. He heads back out of the station. The Young Man follows."
    },
    {
      "type": "action",
      "text": "Dark Suit enters a small doorway between two shops. The Young Man hangs around nearby, before walking up to the doorway and examining the doorbells. The bells are for flats up above the shops; most of the names are not marked. He crosses the road and looks up at the windows, but can’t see much through any of them. The Young Man shrugs and starts to walk away, but he hears a door open behind him and he glances back to see Dark Suit coming out of a doorway carrying another overnight bag."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (V.O.) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "The most important rule was that even if I found where a person worked or lived, I would never follow the same person twice."
    },
    {
      "type": "action",
      "text": "Dark Suit looks about as he comes out on to the pavement and the Young Man is forced to turn back and continue to walk in the direction in which he was already headed. When he reaches the corner, he glances back down the street, but the street is empty. The Young Man looks around thoughtfully before hurrying off around the corner."
    },
    {
      "type": "action",
      "text": "The Young Man rushes through the crowded streets, not quite running but faster then we’ve seen him move before."
    },
    {
      "type": "action",
      "text": "The YOUNG MAN rushes into Charing Cross station and stands across from the left-luggage office, waiting breathlessly. Commuters stream across the station, obscuring his view of the office."
    },
    {
      "type": "action",
      "text": "Through a gap in the flow of people the Young Man catches a glimpse of Dark Suit. The Young Man moves closer, wading through commuters to get a better look."
    },
    {
      "type": "action",
      "text": "He sees Dark Suit hand over his ticket and pick up his first overnight bag."
    },
    {
      "type": "action",
      "text": "Dark Suit slings one bag over each shoulder before heading off through the station towards the back entrance on to Hungerford Bridge."
    },
    {
      "type": "action",
      "text": "The Young Man follows. They cross the footbridge, trains rumbling past on the right-hand side, the sky darkening."
    },
    {
      "type": "action",
      "text": "They pass through the South Bank Centre and head south, entering residential streets as it gets dark. Dark Suit arrives at a small block of flats and lets himself in. The Young Man sees a light come on in a third-floor window. He makes a not of the address, turns and walks away."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "It was the most important rule, so it was the one I broke last."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "EXT. ROW OF TERRACED TOWNHOUSES - DUSK"
    },
    {
      "type": "action",
      "text": "The Young Man looks up at a second-floor window. His appearance is dramatically different from the preceding scene: his hair is in a short, ragged near crew-cut, and he now wears an old-fashioned dark suit and tie."
    },
    {
      "type": "action",
      "text": "The Young Man walks past the row of houses then doubles back on the opposite side, stopping at a bus stop from which he can see the houses, He reaches into the inside pocket of his jacket and takes out a strip of passport photos. He stares at them, and we see that they are of a young blonde woman, perhaps the same woman who drew the curtains."
    },
    {
      "type": "action",
      "text": "One of the front doors opens and the young blonde woman exits. The Young Man glaces at the photos in his hand - it is the same young woman."
    },
    {
      "type": "action",
      "text": "The Blonde comes out on to the street. She is wearing a long overcoat, a purse under her arm."
    },
    {
      "type": "action",
      "text": "The Young Man lets her get slightly ahead before tailing her from the opposite side of the street. The Blonde strides purposefully ahead, not looking around."
    },
    {
      "type": "action",
      "text": "As they enter a more crowded West End street, the Young Man allows himself to cross onto the same side and move ever closer."
    },
    {
      "type": "action",
      "text": "The Blonde glides through the other pedestrians gracefully and easily behind her the Young Man bobs and weaves to keep her in sight."
    },
    {
      "type": "scene-heading",
      "text": "EXT. SMALL ENTRANCE TO A BASEMENT BAR/CLUB - DUSK"
    },
    {
      "type": "action",
      "text": "The Young Man approaches and stops outside. The passport photos are still in his hand. He glances at them as he replaces them in his inside pocket. He looks at the stairs down into the club, looks around, rubbing his face."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "EXT. STREET IN SOHO - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man walks down the street, following a middle-aged bald man. The Young Man has short hair and is wearing a suit and tie. He is wearing sunglasses and his lip looks swollen."
    },
    {
      "type": "action",
      "text": "Baldy stops and turns into a doorway."
    },
    {
      "type": "action",
      "text": "The Young Man comes up and examines the names by the bells. They are all companies/offices."
    },
    {
      "type": "action",
      "text": "He looks around, crosses the road and slips into a cafe."
    },
    {
      "type": "scene-heading",
      "text": "INT. CAFÉ - DAY"
    },
    {
      "type": "action",
      "text": "The café is empty apart from a woman on her own reading a book at one of the tables."
    },
    {
      "type": "action",
      "text": "The Young Man buys a coffee at the counter and heads over to the table nearest the window. He sips at his coffee and glances out of the window to the building opposite."
    },
    {
      "type": "action",
      "text": "He takes his dark glasses off and examines his reflection in the blade of the knife that was sitting on the table. His left eye is horribly bruised and swollen - it looks half- closed. There is a plaster above it, across the eyebrow. His lip is swollen and marked where it has been recently split."
    },
    {
      "type": "action",
      "text": "The Young Man looks up and sees that the lone woman is staring at him. He puts his sunglasses back on and we:"
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "EXT. OUTSIDE A BLOCK OF FLATS IN THE WEST END - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man stares up at the building, perplexed."
    },
    {
      "type": "action",
      "text": "Dark Suit comes out of the building, a sports bag slung over his shoulder. As he walks down the street the Young Man follows, the throng of people washing around them."
    },
    {
      "type": "action",
      "text": "Dark Suit dives into a café."
    },
    {
      "type": "action",
      "text": "The Young Man comes abreast of it and looks through the window. The café is crowded; Dark Suit has taken a table near the back, facing away from the door. The Young Man looks about, takes a deep breath and pushes open the door to the café."
    },
    {
      "type": "scene-heading",
      "text": "INT. CAFÉ - DAY"
    },
    {
      "type": "action",
      "text": "Five or six tables, mostly occupied. Two men behind the counter making the food, one waitress squeezing between the tables."
    },
    {
      "type": "action",
      "text": "The Young Man enters. Keeping an eye on Dark Suit’s back, the Young Man slides behind a table."
    },
    {
      "type": "character",
      "text": "WAITRESS"
    },
    {
      "type": "dialogue",
      "text": "Yeah?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Coffee, black."
    },
    {
      "type": "character",
      "text": "WAITRESS"
    },
    {
      "type": "dialogue",
      "text": "You’re going to take up one of my tables over lunch with just a coffee?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "And chips."
    },
    {
      "type": "action",
      "text": "He looks up at the waitress; she’s still there."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "And an omlette... please."
    },
    {
      "type": "action",
      "text": "The Waitress turns and leaves."
    },
    {
      "type": "action",
      "text": "The Young Man looks over to Dark Suit. The sports bag rests besides Dark Suit’s feet. Dark Suit eats, we can’t see what."
    },
    {
      "type": "action",
      "text": "The waitress brings the Young Man’s food. He plays with it as he considers Dark Suit."
    },
    {
      "type": "action",
      "text": "The Young Man gulps at his coffee. Time passes, the other tables change."
    },
    {
      "type": "action",
      "text": "Dark Suit gets up, picks up his bag and turns around, moving towards the Young Man."
    },
    {
      "type": "action",
      "text": "The Young Man studies his half-eaten omelette intently."
    },
    {
      "type": "character",
      "text": "DARK SUIT (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Mind if I join you?"
    },
    {
      "type": "action",
      "text": "The Young Man looks up; Dark Suit is at his elbow, smiling. Dark Suit sits down without waiting for a reply."
    },
    {
      "type": "character",
      "text": "DARK SUIT (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(matter-of-fact)"
    },
    {
      "type": "dialogue",
      "text": "Who and why?"
    },
    {
      "type": "action",
      "text": "The Young Man looks confused. The Waitress is at their table."
    },
    {
      "type": "character",
      "text": "DARK SUIT (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(to Waitress)"
    },
    {
      "type": "dialogue",
      "text": "Another black coffee for me and..."
    },
    {
      "type": "parenthetical",
      "text": "(to the Young Man)"
    },
    {
      "type": "dialogue",
      "text": "... What are you having?"
    },
    {
      "type": "action",
      "text": "The Young Man shakes his head and starts to murmur negatives. Dark Suit reaches over, picks up the Young Man’s empty mug and sniffs it."
    },
    {
      "type": "character",
      "text": "DARK SUIT (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(to Waitress)"
    },
    {
      "type": "dialogue",
      "text": "And another coffee..."
    },
    {
      "type": "parenthetical",
      "text": "(he looks into the mug)"
    },
    {
      "type": "dialogue",
      "text": "... also black."
    },
    {
      "type": "action",
      "text": "The Waitress leaves. Dark Suit stares at the Young Man who is having trouble returning his gaze."
    },
    {
      "type": "character",
      "text": "DARK SUIT (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You’re obviously not a policeman, so who are you and why are you following me?"
    },
    {
      "type": "action",
      "text": "The Young Man half-smiles as if he has not understood the question, then glances from side to side in an attempt to look uncomprehending."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I’m sorry?"
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "You’ve been following me all morning... why?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Following? I’m sorry but I’ve absolutely no idea what you’re talking about-"
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "parenthetical",
      "text": "(aggressive)"
    },
    {
      "type": "dialogue",
      "text": "Don’t piss me off. Who the fuck are you?"
    },
    {
      "type": "action",
      "text": "The Young Man can’t think of anything to say. An uncomfortable silence broken by the Waitress bringing two coffees."
    },
    {
      "type": "character",
      "text": "DARK SUIT (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(to Waitress, eyes still on Young Man)"
    },
    {
      "type": "dialogue",
      "text": "Thanks."
    },
    {
      "type": "parenthetical",
      "text": "(to Young Man)"
    },
    {
      "type": "dialogue",
      "text": "Sugar?"
    },
    {
      "type": "action",
      "text": "The Young Man shakes his head. Dark Suit breaks eye contact to spoon two sugars into his coffee. He stirs it noisily, looking up expectantly, waiting for the Young Man to speak. The Young Man’ mouth opens and closes silently several times before he speaks."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Look I’m not... I haven’t been following you, I just I just saw you with your bag and I thought you looked... interesting."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "What are you, a faggot?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "No! No, I, I, I, I’m a... Look I saw you on the street and, and you reminded me of someone I went to school with- to tell the truth I thought you were him, so I followed you and came in here- I came in here ‘cos I was hungry- but I wanted to see if it was him..."
    },
    {
      "type": "action",
      "text": "Dark Suit stares at him."
    },
    {
      "type": "character",
      "text": "YOUNG MAN(CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(fading)"
    },
    {
      "type": "dialogue",
      "text": "... but it wasn’t."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "Why didn’t you just ask me when you saw me?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I would’ve been embarrassed."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "parenthetical",
      "text": "(smiling)"
    },
    {
      "type": "dialogue",
      "text": "Not as embarrassed as you are now."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(laughing nervously)"
    },
    {
      "type": "dialogue",
      "text": "No, I suppose not."
    },
    {
      "type": "action",
      "text": "Dark Suit sips at his coffee. The Young Man follows suit."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "What’s your name?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Bill."
    },
    {
      "type": "action",
      "text": "Dark Suit smiles."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "Well, ‘Bill’... what do you do?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Actually, I’m kind of-"
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "‘Between jobs right now.’"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "That’s right."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "What would you do?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I don’t know."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "parenthetical",
      "text": "(smiling)"
    },
    {
      "type": "dialogue",
      "text": "Don’t be coy, ‘Bill’. There must be some burning ambition eating away at you. You look like some kind of starving artist?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "No?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "Painter?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "Photos?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "Films?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "Writer?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(slight pause)"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "Writer."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "NO."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "But you write?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Not really."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "But sometimes?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Sometimes, who doesn’t?"
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "Me."
    },
    {
      "type": "parenthetical",
      "text": "(pause)"
    },
    {
      "type": "dialogue",
      "text": "So you’re a writer."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I didn’t say that. What makes you think that I’m a writer anyway?"
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "Educated, unemployed twentysomething, fancies himself a writer... a real leap into the unknown."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Well, I’m not a writer."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "But you’re interested in people."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Yeah."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "This person?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I suppose -"
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "You haven’t even asked my name."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What’s your -"
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "dialogue",
      "text": "Or what’s in my bag."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Bag?"
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "parenthetical",
      "text": "(gestures at his feet)"
    },
    {
      "type": "dialogue",
      "text": "My bag. The one you’ve been staring at."
    },
    {
      "type": "action",
      "text": "There is a pause during which Dark Suit stares challengingly at the Young Man, who looks thoughtfully, undecided."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(sighing)"
    },
    {
      "type": "dialogue",
      "text": "What’s your name and what’s in your bag?"
    },
    {
      "type": "action",
      "text": "Dark Suit smiles, and reaches down for his bag."
    },
    {
      "type": "character",
      "text": "DARK SUIT"
    },
    {
      "type": "parenthetical",
      "text": "(dumps bag on table)"
    },
    {
      "type": "dialogue",
      "text": "My name’s Cobb. Take a look for yourself."
    },
    {
      "type": "action",
      "text": "The Young Man pauses, then, eyes on Cobb, he reaches forward and pulls the bag across the table. He unzips it and peers inside."
    },
    {
      "type": "action",
      "text": "The Young Man looks puzzled. Cobb grins."
    },
    {
      "type": "action",
      "text": "Inside the bag are CDs. Rummaging beneath them the Young Man uncovers some jewelry and a camera. He looks up at Cobb, puzzled."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(smilING)"
    },
    {
      "type": "dialogue",
      "text": "What were you expecting, drugs?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "They’re yours?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(laughing)"
    },
    {
      "type": "dialogue",
      "text": "They are now."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Why would you take their old CDs?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Easy to grab a load, easy to sell, totally untraceable. A good staple. The other stuff’s more tricky, far more unpredictable."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You don’t look like a burglar."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Sounds like a compliment."
    },
    {
      "type": "action",
      "text": "The Young Man shrugs and smiles, zipping up the bag."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(grinning broadly)"
    },
    {
      "type": "dialogue",
      "text": "Interested now?"
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "EXT. ENTRANCE TO A BASEMENT BAR/CLUB - DUSK"
    },
    {
      "type": "action",
      "text": "The Blonde approaches, pauses, looking behind herself as if suspicious of being followed. She goes down the stairs into the club."
    },
    {
      "type": "action",
      "text": "The Young Man (short hair, clean shaven) approaches the entrance, pauses, uncertain. He looks about, then dives in."
    },
    {
      "type": "scene-heading",
      "text": "INT. BASEMENT BAR/CLUB - DUSK"
    },
    {
      "type": "action",
      "text": "Three-sided bar, booths and tables, music."
    },
    {
      "type": "action",
      "text": "The Young Man enters. The place is not full. The Blonde is seated at the bar. She watches the Young Man comes in, then looks away, uninterested."
    },
    {
      "type": "action",
      "text": "The Young Man approaches the bar, leaning on it several places along from The Blonde, glancing at her out of the corner of his eye. She is oblivious to his presence, as is the bartender, who is on the phone behind the bar. The Young Man sneaks looks at The Blonde whilst tapping the bar, waiting for the bartender to hang up the phone. The Blonde has an elegant profile, as seen from along the bar, but she looks unhappy."
    },
    {
      "type": "action",
      "text": "The bartender hangs up the phone, shuffles over and looks enquiringly at the Young Man."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Beer."
    },
    {
      "type": "action",
      "text": "The bartender grabs a bottle from the fridge, opens it and sets it down in front of the Young Man. The bartender holds up a glass and raises his eyebrows at the Young Man, who shakes his head and raises the bottle to his lips, taking a sip. The Young Man puts the bottle back on the bar and turns to look at The Blonde. He gets off his barstool and moves down towards her, sliding his beer along the bar as he goes. He stops at her side."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Buy you a drink?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(staring ahead)"
    },
    {
      "type": "dialogue",
      "text": "Yeah, but you can’t sleep with me."
    },
    {
      "type": "action",
      "text": "The Young Man smiles quizzically."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Why not?"
    },
    {
      "type": "action",
      "text": "The Blonde turns to look at him, a movement of the head, nothing else, her expression hard to read."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "I’m with him."
    },
    {
      "type": "action",
      "text": "She jerks her head behind them. The Young Man turns, seeing three men seated at a table across the room, papers on the table, apparently talking business. Suits, ties, two of them young, one middle-aged and bald."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(turning back)"
    },
    {
      "type": "dialogue",
      "text": "Not that bald one?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "He’ll let you buy me a drink, but sex is out of the question."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I see."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Still want to buy me that drink?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "action",
      "text": "Right answer, The Blonde laughs. The Young Man sips from his beer."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "So what’s a beautiful young woman like you doing -"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "In a place like this?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "- with a bald old cunt like that."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Long story. Keep your voice down, he owns this place."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Just trying to get your attention. You’re interested now aren’t you?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(turning away)"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "action",
      "text": "The Young Man is disarmed. He looks at the label of his beer for something to say."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I’m Timothy Kerr - Tim to my friends."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(without looking at him)"
    },
    {
      "type": "dialogue",
      "text": "So?"
    },
    {
      "type": "action",
      "text": "The Young Manopens his mouth, pissed off, but changes his mind before he speaks."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(softly)"
    },
    {
      "type": "dialogue",
      "text": "You’ve obviously had a bad day, one of those days which makes you feel that everybody’s out for their pound of flesh."
    },
    {
      "type": "action",
      "text": "The Blonde turns to look at him, her expression softer, but not much."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(slow, considered delivery)"
    },
    {
      "type": "dialogue",
      "text": "That is the kind of day I’ve been having lately."
    },
    {
      "type": "action",
      "text": "She glances out of the corner of her towards Baldy. He is watching them."
    },
    {
      "type": "character",
      "text": "THE BLONDE (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(looking back to Young Man)"
    },
    {
      "type": "dialogue",
      "text": "Say something to me."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Such as?"
    },
    {
      "type": "action",
      "text": "The Blonde slaps the Young Man hard across the face. He looks shocked."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(turning to her drink)"
    },
    {
      "type": "dialogue",
      "text": "I’ll be outside in ten minutes."
    },
    {
      "type": "scene-heading",
      "text": "EXT. ENTRANCE TO BASEMENT BAR/CLUB - NIGHT"
    },
    {
      "type": "action",
      "text": "The Young Man is loitering outside."
    },
    {
      "type": "action",
      "text": "The Blonde comes up out of the club and walks towards the Young Man without appearing even to notice him. He falls into step beside her. They don’t speak for several paces."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Live close?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Yeah. You live, I mean, you do you live around here?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "I do. But I don’t want to go back there."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Because of the bald guy."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You want to go to my place?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(laughing)"
    },
    {
      "type": "dialogue",
      "text": "Don’t get your hopes up. I can’t be seen with you in any of the bars around here. Got anything to drink at home?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "We can stop on the way."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "INT. CAFÉ - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man sits alone at a table by the window, watching the building opposite. He has short hair and wears sunglasses to hide the worst of his facial bruises, but his swollen lip is still noticeable."
    },
    {
      "type": "action",
      "text": "In front of him on the table are a cup of coffee, a notebook and a pen. He sips at the coffee."
    },
    {
      "type": "scene-heading",
      "text": "EXT. OFFICE BUILDING - DAY"
    },
    {
      "type": "action",
      "text": "Young Man’s POV from the café. Baldy exits the building and hails a taxi."
    },
    {
      "type": "scene-heading",
      "text": "INT. CAFE - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man opens the notebook and writes in it, and we:"
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "INT. OUTSIDE THE DOOR TO A FLAT, THE LANDING OF A NARROW"
    },
    {
      "type": "action",
      "text": "STAIRWAY - DAY"
    },
    {
      "type": "action",
      "text": "Cobb comes up the stairs and stops outside the door."
    },
    {
      "type": "action",
      "text": "The Young Man (he has long hair and is unshaven) follows, standing behind Cobb, looking over Cobb’s shoulder as he examines the door."
    },
    {
      "type": "action",
      "text": "Cobb knocks gingerly on the door. After a pause, he reaches into his jacket pocket and pulls out a pair of rubber surgical gloves. He inflates the gloves one after the other before putting them on, interlacing his fingers and bumping the gloves snugly into place. He turns to the Young Man."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(whispering)"
    },
    {
      "type": "dialogue",
      "text": "Gloves?"
    },
    {
      "type": "action",
      "text": "The YOUNG MAN nods and holds up his hands for inspection- he is wearing thick, leather and wool gloves."
    },
    {
      "type": "action",
      "text": "Cobb rolls his eyes. Shaking his head, he turns back to the door, then pushes the Young Man back and lifts up the doormat. There’s nothing under there, and he lets it back down. The Young Man leans forward to whisper into Cobb’s ear."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(whispering)"
    },
    {
      "type": "dialogue",
      "text": "People don’t really do that, do they?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(whispering, reaching into his pocket)"
    },
    {
      "type": "dialogue",
      "text": "You’d be surprised."
    },
    {
      "type": "action",
      "text": "He takes a piece of plastic out and starts working it into the crack between the door and the frame."
    },
    {
      "type": "action",
      "text": "The Young Man notices a potted plant on the windmill. He reaches over and shifts it slightly, finding a key underneath it. He taps Cobb on the shoulder and when he turns around the Young Man holds it up in front of his face. COBB smiles as he grabs it, and turns back to the door to unlock it."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(whispering)"
    },
    {
      "type": "dialogue",
      "text": "Beginner’s luck."
    },
    {
      "type": "action",
      "text": "Cobb opens the door and heads inside, the Young Man following."
    },
    {
      "type": "scene-heading",
      "text": "INT. HALLWAY - DAY"
    },
    {
      "type": "action",
      "text": "No lights - cold grey daylight filtered through net curtains."
    },
    {
      "type": "action",
      "text": "Cobb is first, creeping forward through the flat with the Young Man at his shoulder. Cobb looks left and right into doorways as they advance, pushing them open gently to see inside to let more light into the hallway. At the end of the hall Cobb turns to face the Young Man."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(speaking normally now)"
    },
    {
      "type": "dialogue",
      "text": "See, nobody home. Right, first things first. We need a bag."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(whispering)"
    },
    {
      "type": "dialogue",
      "text": "A bag?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "To carry the stuff out of here. Why are you whispering?"
    },
    {
      "type": "action",
      "text": "Cobb passes through a door off to the left."
    },
    {
      "type": "scene-heading",
      "text": "INT. BEDROOM - DAY"
    },
    {
      "type": "action",
      "text": "A futon, two wardrobes, piles of books and neatly folded clothes by the wall. Cobb crosses the room to the first wardrobe and opens it, rummaging around the bottom."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(head in wardrobe)"
    },
    {
      "type": "dialogue",
      "text": "Bingo."
    },
    {
      "type": "action",
      "text": "COBB backs out of the wardrobe clutching a soft overnight bag."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(not whispering, but still quiet)"
    },
    {
      "type": "dialogue",
      "text": "Don’t you have your own?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Yeah, sure, it’s a big bag with ‘swag’ written across the side. OK... what do you fancy?"
    },
    {
      "type": "action",
      "text": "The Young Man looks around and shrugs."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Not much is here of any value."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You don’t seem too concerned."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I don’t do it for the money."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "So why-"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "For the adrenalin, and because, like you, I’m interested in people."
    },
    {
      "type": "action",
      "text": "The Young Man raises his eyebrows."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You can tell a lot about people from their stuff. How old would you say these people were?"
    },
    {
      "type": "action",
      "text": "The Young Man shrugs."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Well, just from the futon you can make a pretty good guess. Young people have futons. I’d be surprised if they were anywhere near forty with a futon. But they’ve got one laundry bag so they’re used to each other which makes me thing that they’re over twenty-five."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "But if they’re only twenty they could have been living together for years."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Look at the books. They’re educated- went to college, graduated when they were twenty-one or twenty-two, wouldn’t have moved in with each other until at least the last year of college. Get a better idea from their music."
    },
    {
      "type": "action",
      "text": "He starts to examine the shelves, running surgeon’s fingers across the shelves, touching things without picking them up. He comes across a wooden box."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Here’s the box."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What box?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Everybody’s got a box. With men it’s usually a shoebox."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "With valuable inside?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "No. More interesting, more personal. Letters, odd snapshots, a plastic toy out of a Christmas cracker, a pebble from some beach."
    },
    {
      "type": "action",
      "text": "He opens the box. The Young Man looks over his shoulder."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(picking through the contents)"
    },
    {
      "type": "dialogue",
      "text": "See? Photos, odd bits of paper, worthless plastic jewelry. An unconscious collection. A display."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Display?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Yes, a display. Each object showing something about the person, together adding up to an illustration of their personality. We’ve all got something of the artist inside of us, even if it is unconscious. It’s extremely personal. We’re privileged to see it. People rarely show anyone their box."
    },
    {
      "type": "action",
      "text": "Cobb stares lovingly at the contents of the box for a few seconds before suddenly throwing it across the room, spilling the contents everywhere with surprising violence."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(taken aback)"
    },
    {
      "type": "dialogue",
      "text": "It’s like a diary. They hide it, but secretly they want someone to look at it and that’s what I do. Concealment, display; flip sides of the same coin. This way they know that someone’s seen it. That’s what it’s all about, interrupting someone’s life, making them think about all the things they usually take for granted. That’s what you’re doing when you steal their things. When they collect the insurance money they go out and buy all these things that have just been sitting on their shelves, stuff they’d forgotten they’d bought, and they have to think all over again about why they wanted this stuff, what it’s for. You take it away and show them what they had."
    },
    {
      "type": "action",
      "text": "He moves to the laundry bag, and reaches into his pocket. He pulls out a pair of lace panties, holding them up for the Young Man to see."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Saucy, eh? I took them from the last place, two young women sharing a flat."
    },
    {
      "type": "action",
      "text": "The Young Man looks totally baffled as Cobb reaches into the laundry bag and pulls out a pair of trousers. He stuffs the panties into the front left pocket and sticks the trousers back into the bag. COBB heads towards the door, passing the baffled Young Man."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(winking)"
    },
    {
      "type": "dialogue",
      "text": "Give ‘em something to chat about."
    },
    {
      "type": "action",
      "text": "Cobb leaves the bedroom. The Young Man follows."
    },
    {
      "type": "scene-heading",
      "text": "INT. HALLWAY - DAT"
    },
    {
      "type": "action",
      "text": "Cobb walks down the corridor carrying the bag, the Young Man behind him."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Why did you do that?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(over his shoulder)"
    },
    {
      "type": "dialogue",
      "text": "She’ll find them in his trousers and want to know what he’s been up to."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Why would you want to fuck up their relationship?"
    },
    {
      "type": "action",
      "text": "Cobb spins about to face the YOUNG MAN so abruptly that they almost collide. There is a manic look in his eyes."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(deadly serious)"
    },
    {
      "type": "dialogue",
      "text": "Don’t you listen? You take it away and show them what they had."
    },
    {
      "type": "action",
      "text": "The Young Man is speechless. Cobb turns and from in front of him we can see a mischievous grin break across his face which is hidden from the Young Man. Cobb dives through a doorway. The Young Man shakes his head and heads after him."
    },
    {
      "type": "scene-heading",
      "text": "INT. KITCHEN - DAY"
    },
    {
      "type": "action",
      "text": "Cobb is taking two glasses down from the cupboard. There is a bottle of red wine on the counter."
    },
    {
      "type": "action",
      "text": "The Young Man enters."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Fancy a drink?"
    },
    {
      "type": "action",
      "text": "The Young Man looks at the bottle then at Cobb."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You’ve got to be joking."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(rummaging in a drawer)"
    },
    {
      "type": "dialogue",
      "text": "Don’t be fooled by the supermarket label - its quite good, I’ve had it before."
    },
    {
      "type": "action",
      "text": "He takes a corkscrew out of the drawer and starts to open the bottle, his hands smooth and graceful - surgical, almost - in their white latex sheaths."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(levering the cork out)"
    },
    {
      "type": "dialogue",
      "text": "You’d have trouble doing this with your gloves on."
    },
    {
      "type": "action",
      "text": "He places the corkscrew on the counter and pours two glasses of wine, handing one to the Young Man who sips at it. Cobb picks up the corkscrew and starts to remove the cork from it."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "So are we going to take anything?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(placing the corkscrew back into the drawer)"
    },
    {
      "type": "dialogue",
      "text": "Anything your heart desires. But look, that’s not the point, that’s just work. This is what it’s all about- being here. Entering someone’s life, finding out who they are... just feel it- standing in someone’s kitchen, drinking their wine, someone you’ll never even meet."
    },
    {
      "type": "action",
      "text": "He jams the cork into the neck of the bottle and sticks it up on the shelf."
    },
    {
      "type": "action",
      "text": "Just as he does so there is the unmistakable sound of the front door being opened."
    },
    {
      "type": "action",
      "text": "Cobb spins around to face the kitchen door. The Young Man throws his glass down onto the counter."
    },
    {
      "type": "action",
      "text": "We hear a muffled voice through the door."
    },
    {
      "type": "character",
      "text": "WOMAN (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Drink? I’ve got some wine."
    },
    {
      "type": "character",
      "text": "MAN (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Why not?"
    },
    {
      "type": "action",
      "text": "Cobb stands frozen, tense, staring at the door. The Young Man looks terrified, glancing from the back of Cobb’s head to the door and back."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(tense whisper)"
    },
    {
      "type": "dialogue",
      "text": "What the fuck do-"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(hissing)"
    },
    {
      "type": "dialogue",
      "text": "SHHHHH!"
    },
    {
      "type": "action",
      "text": "The door swings open and Cobb’s face transforms into an expression of innocent surprise. A young Woman stands frozen in the doorway. Cobb steps forward, palms open."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(friendly, relaxed)"
    },
    {
      "type": "dialogue",
      "text": "You startled us! From the agency or viewing, like us?"
    },
    {
      "type": "action",
      "text": "As he speaks he has moved right up to the Woman, coming close enough that she feels compelled to step back into the hall. The Young Man follows, still looking nervous, but the Woman’s attention is on Cobb."
    },
    {
      "type": "character",
      "text": "WOMAN"
    },
    {
      "type": "parenthetical",
      "text": "(tense, confused)"
    },
    {
      "type": "dialogue",
      "text": "What are you doing in my flat?"
    },
    {
      "type": "scene-heading",
      "text": "INT. HALLWAY - DAY"
    },
    {
      "type": "action",
      "text": "The Woman comes into the hall followed by the Young Man. Cobb turns his attention to the older man who stands frozen in the hall, looking as nervous as the Young Man."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(to the woman)"
    },
    {
      "type": "dialogue",
      "text": "Viewing it. The agent said you’d be out this afternoon."
    },
    {
      "type": "character",
      "text": "WOMAN"
    },
    {
      "type": "parenthetical",
      "text": "(bewildered)"
    },
    {
      "type": "dialogue",
      "text": "But we’re not moving."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(to older man, ignoring Woman)"
    },
    {
      "type": "dialogue",
      "text": "You must be the man of the house. You have a lovely home."
    },
    {
      "type": "action",
      "text": "The older man looks nervously to the Woman. The Young Man and Cobb are both now at the door."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "We’ll leave you in peace, then."
    },
    {
      "type": "character",
      "text": "WOMAN"
    },
    {
      "type": "dialogue",
      "text": "But we’re not moving!"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(opening door, looks bewildered)"
    },
    {
      "type": "dialogue",
      "text": "Not even at the end of the month?"
    },
    {
      "type": "character",
      "text": "WOMAN"
    },
    {
      "type": "dialogue",
      "text": "NO!"
    },
    {
      "type": "action",
      "text": "The woman notices their gloves."
    },
    {
      "type": "action",
      "text": "Cobb notices her noticing."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(motioning the young man out the door)"
    },
    {
      "type": "dialogue",
      "text": "I should check with the agent, then, Luv. Sorry to have bothered you."
    },
    {
      "type": "action",
      "text": "Cobb leaves, closing the door in the couple’s bewildered faces."
    },
    {
      "type": "scene-heading",
      "text": "EXT. ROOFTOP - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man comes out of a doorway onto the flat roof, hurrying, followed by Cobb. Cobb closes the door behind him."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Shouldn’t have come back up here. We’ll have to wait ages before we go down. Maybe there’s another way off here."
    },
    {
      "type": "action",
      "text": "Cobb starts to look around the edges of the roof."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Jesus shit. You think they believed you?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(laughing)"
    },
    {
      "type": "dialogue",
      "text": "Of course they didn’t fucking believe me!"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "So what did-"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I just confused them. We caught them on the hop."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "How do you mean?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "That bloke wasn’t the boyfriend. Why do you think he didn’t say anything? They were up to no good and was probably glad that we weren’t her boyfriend."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You reckon?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Definitely. Why else would she be home from work in the middle of the afternoon? You just can’t plan for that kind of shit, we were unlucky. Don’t be put off. It’s not going to happen next time."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I’m not so sure."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(offended)"
    },
    {
      "type": "dialogue",
      "text": "Oh yeah? Well next time you can do the prep work."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I didn’t mean that-"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I’m serious. You pick a mark, check it out to your own satisfaction days, months, years, whatever- and that’s what we’ll hit next."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(thoughtfully)"
    },
    {
      "type": "dialogue",
      "text": "Yeah. Yeah, all right."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Tell you what."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I feel bad about pulling the panty routine on that bloke- she’ll give him a load of shit, and it’s her that’s screwing around."
    },
    {
      "type": "action",
      "text": "The Young Man laughs, releasing tension."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - NIGHT"
    },
    {
      "type": "action",
      "text": "Small, eclectic mix of stuff. Rubber plant, portable TV, desk, portable stereo. The Blonde circles the room slowly, looking at various items, her overcoat still on."
    },
    {
      "type": "action",
      "text": "The Young Man enters (he has short hair and is clean-shaven), carrying two glasses."
    },
    {
      "type": "action",
      "text": "The Blonde hasn’t heard him come in. He watches her from the doorway as she reaches out to touch a ceramic candlestick sitting on a shoulder-high shelf. As she touches the candlestick it falls into two pieces. As she grabs at them she notices the Young Man watching her."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(flustered)"
    },
    {
      "type": "dialogue",
      "text": "I’m sorry, I just touched it, it -"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Just came apart in you hands."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "No, really, it did."
    },
    {
      "type": "action",
      "text": "The Young Man smiles as he moves into the room."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I know, it was already broken. Somebody dropped it, I was going to glue it..."
    },
    {
      "type": "action",
      "text": "He grabs two pieces, putting the glasses down on the shelf in their place."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "... But sod it, I’ll never get around to it."
    },
    {
      "type": "action",
      "text": "He drops the pieces into a waste-paper basket."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(gesturing at chair)"
    },
    {
      "type": "dialogue",
      "text": "Take a seat."
    },
    {
      "type": "action",
      "text": "The Blonde perches on the edge of a chair, her coat still on. The Young Man takes a bottle out of a plastic bag, opens it and pours two measures. He hands The Blonde a drink. She sips at it. She looks cold."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "So what about the bald guy?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "What about him?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You’re going out with him."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Not exactly."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "But you and him are -"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(matter-of-factly)"
    },
    {
      "type": "dialogue",
      "text": "I used to have a thing going with him, but it’s been over for a long time."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "So why did you tell me you were with him?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "To get rid of you."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(grins)"
    },
    {
      "type": "dialogue",
      "text": "So when you decided to have a drink with me, why did we have to come here?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "He still gets jealous, he’s a dangerous person. And I don’t want to go to my place right now."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(probing)"
    },
    {
      "type": "dialogue",
      "text": "Why not?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "I was burgled yesterday."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Really? What did it feel like, to find your place broken into?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "That’s an odd question. Most people ask ‘What did they take?’"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I’m curious about the way people feel about things."
    },
    {
      "type": "action",
      "text": "He moves to the desk, reaching at a black case which sits amidst the papers and assorted crap."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I’m a writer. (opening the case to reveal an ancient manual typewriter) See?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(deadpan)"
    },
    {
      "type": "dialogue",
      "text": "Gosh."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "So?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "So?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "How did it feel?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(annoyed)"
    },
    {
      "type": "dialogue",
      "text": "Great. How do you think it felt? I don’t really want to talk about it, thank you."
    },
    {
      "type": "action",
      "text": "The Young Man shrugs."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Sorry."
    },
    {
      "type": "action",
      "text": "He straddles the chair which is in front of the desk. He leans in towards The Blonde."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "So the bald guy’s dangerous?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(laughing)"
    },
    {
      "type": "dialogue",
      "text": "Christ, you’re a nosy bastard."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Dangerous like how?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Dangerous like criminal type, involved with bad things type dangerous."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What sort of bad things?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "The usual: girls, drugs, magazines."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Magazines?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "And films... pornography. And he owns a couple of clubs."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Wealthy?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Yes. And refined. It took me a long time to realize the sort of things which he was capable of."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What sort of things?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Perhaps another time. I think I’d better be going."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man stands at the window, watching people pass by on the street below. He has short hair and his face is badly bruised."
    },
    {
      "type": "action",
      "text": "He picks up the telephone and dials a number. After a few rings, the phone is answered by a man we might recognize as Cobb."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Yeah?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "It’s me... Bill."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "What the fuck do you want?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Advice."
    },
    {
      "type": "action",
      "text": "A pause."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "On what?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "The job."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "What fucking job?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "The one I asked you about."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Not interested."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(snorting)"
    },
    {
      "type": "dialogue",
      "text": "I gathered that. I’m doing it on my own. I wondered about protection."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Protection?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Self-defence, weapon of some sort. Surprisingly enough, I thought you might be able to advise."
    },
    {
      "type": "action",
      "text": "Cobb laughs at the other end of the phone."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Steel whip, nun-chucks - they’re all right. Tools are good: sharpened screwdriver, hammer, chisel -"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Hammer?"
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Yeah, medium size, good rubber grip - very nasty. Get a claw hammer you can pry doors with it. Slip it into the back of your waistband, you’re set."
    },
    {
      "type": "action",
      "text": "The Young Man’s eyes have glazed over - he doesn’t seem to be listening."
    },
    {
      "type": "character",
      "text": "COBB (O.S.) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You still there?"
    },
    {
      "type": "action",
      "text": "The Young Man hangs up without a word and we:"
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "EXT. OUTSIDE THE DOOR TO A FLAT - DAY"
    },
    {
      "type": "action",
      "text": "Cobb and the Young Man (he has long hair and is unshaven) are putting on their gloves."
    },
    {
      "type": "action",
      "text": "Cobb looks at the Young Man’s leather gloves."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Why don’t you get some of these, for Christ’s sake?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Where do you get them?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Stole a box from the Middlesex Hospital, but you can buy them."
    },
    {
      "type": "action",
      "text": "He bends down and checks under the doormat. He straightens, up holding a key."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Bing-fucking-go."
    },
    {
      "type": "action",
      "text": "He unlocks the door and they step cautiously inside."
    },
    {
      "type": "scene-heading",
      "text": "INT. DIMLY LIT HALLWAY OF THE FLAT - DAY"
    },
    {
      "type": "action",
      "text": "Cobb proceeds slowly down the hall, pushing open each interior door and checking the various rooms. He stops at the last door."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "You find a bag, I’ll check out the stuff."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "A small room with an eclectic mix of stuff, rubber plant, portable TV, desk, portable stereo."
    },
    {
      "type": "action",
      "text": "Cobb enters and circles around the room, running his gloved hands across the mantelpiece, rubber-plant leaves, etc."
    },
    {
      "type": "action",
      "text": "The Young Man enters, carrying a sports bag."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Here we go."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(almost to himself)"
    },
    {
      "type": "dialogue",
      "text": "That was quick. We may not need it..."
    },
    {
      "type": "parenthetical",
      "text": "(he looks at the Young Man)"
    },
    {
      "type": "dialogue",
      "text": "... there’s fuck-all here."
    },
    {
      "type": "action",
      "text": "Tight on the Young Man’s face; he’s really interested."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Oh?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(sarcastic)"
    },
    {
      "type": "dialogue",
      "text": "Oh."
    },
    {
      "type": "action",
      "text": "The Young Man looks around. Cobb prowls around the room dangerously."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What about the stereo?"
    },
    {
      "type": "action",
      "text": "Cobb has stopped at some shelves. Near his shoulder is a ceramic candlestick, no candle in it."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "How much would you pay for a second- hand, ten-year-old portable stereo? You want to carry it, you can have it. This is fucking useless."
    },
    {
      "type": "action",
      "text": "He tips the candlestick off the shelf and on to the floor. It breaks in two when it hits the floor."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(surprised)"
    },
    {
      "type": "dialogue",
      "text": "Hey, what are we - vandals or burglars?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "You’re a burglar? So burgle."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Well... what about the CDs?"
    },
    {
      "type": "action",
      "text": "Cobb crosses to the small CD rack."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(interested now)"
    },
    {
      "type": "dialogue",
      "text": "Not much of a collection."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(drawing him out)"
    },
    {
      "type": "dialogue",
      "text": "Oh?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(flipping through CDs)"
    },
    {
      "type": "dialogue",
      "text": "Very little here. And what there is seems quite personal."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "How’s that?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "There’s none of the music that people play when their friends come round, you know, not to be listened to or even noticed but to fill in gaps in conversation."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Like what?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(glances around room)"
    },
    {
      "type": "dialogue",
      "text": "For someone this age..."
    },
    {
      "type": "parenthetical",
      "text": "(MORE)"
    },
    {
      "type": "character",
      "text": "COBB (CONT'D)"
    },
    {
      "type": "dialogue",
      "text": "I dunno, maybe Simply Red or Fleetwood Mac, that sort of shit."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "He’s got good taste."
    },
    {
      "type": "action",
      "text": "Cobb moves over to the desk."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Each to his own. But he’s a sad fucker with no social life."
    },
    {
      "type": "action",
      "text": "The Young Man raises his eyebrows. At the desk Cobb flips open a black case to reveal an ancient typewriter."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Nice machine."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You think he’s a writer?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(scoffing)"
    },
    {
      "type": "dialogue",
      "text": "If he wanted to write he’d have a word processor. He doesn’t want to write, he wants to be a writer - and that’s two..."
    },
    {
      "type": "parenthetical",
      "text": "(notices something)"
    },
    {
      "type": "dialogue",
      "text": "... two completely different things."
    },
    {
      "type": "parenthetical",
      "text": "(turns to Young Man)"
    },
    {
      "type": "dialogue",
      "text": "You check this out, right?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Right."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(suspicious)"
    },
    {
      "type": "dialogue",
      "text": "You watched him come and go, saw his routine?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(defensive)"
    },
    {
      "type": "dialogue",
      "text": "I told you, I checked it out. Why?"
    },
    {
      "type": "action",
      "text": "Cobb turns to the desk and stares at it, hard."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "This guy’s unemployed."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "No he isn’t."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(emphatic)"
    },
    {
      "type": "dialogue",
      "text": "He’s unemployed. Look at this desk, people with jobs don’t want this shit in their living rooms!"
    },
    {
      "type": "parenthetical",
      "text": "(rummaging through papers, files)"
    },
    {
      "type": "dialogue",
      "text": "This guy is unemployed or a student... either way he could be back any fucking second!"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(concerned)"
    },
    {
      "type": "dialogue",
      "text": "Hw won’t. I watched him come and go, he’s got a job."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(rummaging)"
    },
    {
      "type": "dialogue",
      "text": "Yeah? What’s he do, then?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(insistent)"
    },
    {
      "type": "dialogue",
      "text": "I checked it out."
    },
    {
      "type": "action",
      "text": "Cobb stops rummaging, turns around and glares at the Young Man."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(malevolent)"
    },
    {
      "type": "dialogue",
      "text": "What the fuck is this, then?"
    },
    {
      "type": "action",
      "text": "He holds up a booklet."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(controlled anger)"
    },
    {
      "type": "dialogue",
      "text": "You should recognize this, Dole- boy..."
    },
    {
      "type": "parenthetical",
      "text": "(steps forward)"
    },
    {
      "type": "dialogue",
      "text": "... his fucking UB40."
    },
    {
      "type": "action",
      "text": "He grabs the Young Man and throws him against the wall."
    },
    {
      "type": "action",
      "text": "He holds the Young Man’s face with his left hand and slaps the booklet across with the other, hard."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Checked it out! You fucking arsehole, are you trying to get us thrown in jail? We’re leaving now."
    },
    {
      "type": "action",
      "text": "He releases the Young Man, staring at him fro a few seconds before walking out of the living room. The Young Man rubs his face before following."
    },
    {
      "type": "scene-heading",
      "text": "INT. HALL - DAY"
    },
    {
      "type": "action",
      "text": "The Young man hurtles after Cobb, who is almost at the front door."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Aren’t we going to take anything?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "We’re going now. I don’t steal from no-hope dole scroungers. No offence."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(to himself)"
    },
    {
      "type": "dialogue",
      "text": "None taken."
    },
    {
      "type": "action",
      "text": "Cobb opens the front door and turns to face the approaching Young Man."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "There’s another place. One that I’ve checked out..."
    },
    {
      "type": "action",
      "text": "They leave, closing the door behind them."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "EXT. ROW OF TERRACED TOWNHOUSES - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man (with short hair and clean-shaven) loiters at the bus stop, watching The Blonde’s second floor windows. The curtains are pulled back to reveal The Blonde. She stands at the window. The front door opens and Baldy steps out."
    },
    {
      "type": "action",
      "text": "The Young Man watches Baldy as he walks down the steps on to the street and turns right, away from the Young Man."
    },
    {
      "type": "action",
      "text": "The Young Man waits for a few seconds before walking up to the front door and ringing The Blonde’s buzzer. The front door clicks unlocked and the Young Man heads inside."
    },
    {
      "type": "scene-heading",
      "text": "INT. HALLWAY OUTSIDE THE BLONDE’S FLAT - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man comes up to the door and knocks; the door pushes open slightly with the force of the knock."
    },
    {
      "type": "character",
      "text": "THE BLONDE (O.S.)"
    },
    {
      "type": "parenthetical",
      "text": "(from within)"
    },
    {
      "type": "dialogue",
      "text": "It’s open!"
    },
    {
      "type": "action",
      "text": "The Young Man enters."
    },
    {
      "type": "scene-heading",
      "text": "INT. HALL OF A LARGE APARTMENT - DAY"
    },
    {
      "type": "action",
      "text": "Noise of a shower running, steam coming out of an open doorway."
    },
    {
      "type": "action",
      "text": "The Young Man comes down the hall, cautiously. The Blonde comes out of a doorway in a bathrobe, glances at him."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "You’re early."
    },
    {
      "type": "action",
      "text": "She disappears into the bathroom before the Young Man has a chance to reply."
    },
    {
      "type": "character",
      "text": "THE BLONDE (O.S.) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Make yourself at home, I’ll be a minute."
    },
    {
      "type": "action",
      "text": "The Young Man comes down the corridor. As he comes past the bathroom he sees that she has only half-closed the door - he peers in, but sees only a towel rail and steam. He goes through the next doorway along."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "Expensively and tastefully decorated, almost cluttered - some pictures on the walls, lots of plants."
    },
    {
      "type": "action",
      "text": "The Young Man comes into the room, glances around. He moves over to a small table by the wall and looks down at it. There is nothing on it. He runs his fingers over the polished wood surface, then turns around, looking about the room for something that he can’t find. He crosses the room and sits down in a large armchair near the windows."
    },
    {
      "type": "action",
      "text": "The Blonde enters, still in her robe, rubbing her wet hair with a towel."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Nice place."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(sitting down on the couch)"
    },
    {
      "type": "dialogue",
      "text": "Thanks. I can’t stand the idea that some stranger was in here, rummaging around. Creepy."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What’d they take?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "CD player, CDs, stuff like that. They took one of my bags to carry it in - the police told me that that’s pretty standard."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Must be bad - losing that stuff."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(shrugging)"
    },
    {
      "type": "dialogue",
      "text": "Insurance’ll cover it. The personal stuff was worse."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Personal stuff?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "They took some of my things. They rifled through my underwear."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Probably thought you kept your valuables hidden there."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(shaking her head with evident distaste)"
    },
    {
      "type": "dialogue",
      "text": "They took some of it."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Shit. Why would they do that?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(mocking)"
    },
    {
      "type": "dialogue",
      "text": "Come on, don’t play the innocent, you’re a man - you know the sort of kinky voyeuristic shit men get up to."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(shaking his head)"
    },
    {
      "type": "dialogue",
      "text": "No. No, no, no... I’m not into that kind of..."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "So you have no interest in women’s underwear whatsover?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "No. I’m interested in what’s inside it, that’s all."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "So if I offered you a pair of my panties, you wouldn’t be remotely interested?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "‘Fraid not, though I’m sure they’re lovely. Now you’ve embarrassed me enough, thanks."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(shrugging)"
    },
    {
      "type": "dialogue",
      "text": "Well, they took some. I’ll tell you what else, they took one of my earrings - not the pair, just one of the earrings. Bloody annoying."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Maybe you’ve just misplaced it."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "No. I know where it was - they took it... just to fuck me around. Bloody annoying, they probably thing they’re really clever. I wear the one they left on its own."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Why?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(shrugs)"
    },
    {
      "type": "dialogue",
      "text": "Makes me feel good and miserable. I don’t know, gives me something to talk about, anyway."
    },
    {
      "type": "action",
      "text": "She sighs and looks over to the window."
    },
    {
      "type": "character",
      "text": "THE BLONDE (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(rising)"
    },
    {
      "type": "dialogue",
      "text": "Give me a minute, I’ll get dressed."
    },
    {
      "type": "action",
      "text": "She leaves. As soon as she is out of the room the Young Man jumps out of his chair and lifts up the seat cushion, looking underneath. He thrusts his hands down the back and sides of the chair, feeling for something. He comes up empty-handed, puzzlement on his face, and replaces the cushion."
    },
    {
      "type": "action",
      "text": "He goes into the hall and crosses to another doorway."
    },
    {
      "type": "scene-heading",
      "text": "INT. HALLWAY - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man pauses at the door. It is open a crack and through the crack he can see into the bedroom."
    },
    {
      "type": "scene-heading",
      "text": "INT. BEDROOM - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man’s POV through the crack shows us The Blonde almost dressed, buttoning her blouse in front of the mirror."
    },
    {
      "type": "action",
      "text": "The Young Man watches for a second or two, then pushes the door open quietly."
    },
    {
      "type": "action",
      "text": "The Blonde turns her head to look at him, apparently unsurprised. The Young Man moves towards her. She allows him to reach out and pull her towards him. He kisses her on the lips and we:"
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "EXT. OFFICE BUILDING IN SOHO - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man loiters outside. He has short hair and wears dark glasses. Baldy exits with another man. They hail a cab and leave."
    },
    {
      "type": "action",
      "text": "The Young Man wanders down an alley running down the side of the building. He takes a piece of paper out of his pocket on which a rough floor plan has been drawn."
    },
    {
      "type": "action",
      "text": "He counts windows down the side of the building, stopping at a particular window to study it. He looks around, puts the paper back into his pocket and walks back out on to the main street."
    },
    {
      "type": "scene-heading",
      "text": "INT. BEDROOM - DAY"
    },
    {
      "type": "action",
      "text": "Small, dark, cluttered."
    },
    {
      "type": "action",
      "text": "The Young Man enters, carrying a paper bag. He removes his sunglasses, revealing his bruised face."
    },
    {
      "type": "action",
      "text": "He tosses the paper bag on to the bed, then reaches into the breast pocket of his suit jacket and pulls out a pair of rubber surgical gloves."
    },
    {
      "type": "action",
      "text": "He inflates one before stretching it on to his fingers, then does the same with the second, interlacing his fingers to jam the gloves on snugly. He flexes his hands, then turns to the bed and reaches into the paper bag, removing a brand new hammer with a rubber grip and a claw head."
    },
    {
      "type": "action",
      "text": "He tests the weight of the hammer, first in one hand then in the other. He awkwardly sticks the hammer into the back of his waistband and moves to the dusty mirror, examining himself. He removes the hammer from his waistband and looks at himself holding it in the mirror, and we:"
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "INT. INSIDE THE HALL OF A LARGE APARTMENT - DAY"
    },
    {
      "type": "action",
      "text": "Little is visible in the gloom. All is quiet."
    },
    {
      "type": "action",
      "text": "Suddenly a splintering crash breaks the silence and the front door breaks inward, revealing Cobb and the Young Man (long hair, unshaven), gloves on, glancing about nervously."
    },
    {
      "type": "action",
      "text": "Cautiously, they creep into the flat. Cobb shuts the door behind them. The Young Man moves to the nearest doorway and opens the door, spilling a cold, diffuse light into the hall. He opens the next door along and looks in and we"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "Young Man’s POV: expensively and tastefully decorated, almost cluttered - lots of pictures on the walls, lots of plants."
    },
    {
      "type": "action",
      "text": "The Young Man steps back into the hall."
    },
    {
      "type": "scene-heading",
      "text": "INT. HALL - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man looks over at Cobb."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(whispering loudly)"
    },
    {
      "type": "dialogue",
      "text": "Not bad at all."
    },
    {
      "type": "action",
      "text": "Cobb turns to look at him."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(speaking normally)"
    },
    {
      "type": "dialogue",
      "text": "I’ll check the bedrooms for a bag, you check out the stuff."
    },
    {
      "type": "action",
      "text": "The Young Man nods and passes into the living room."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man enters and crosses to the centre of the large room. He turns around, scanning the room, taking in furniture, stereo, plants, TV and VCR, pictures."
    },
    {
      "type": "action",
      "text": "Noticing something, he moves closer to a group of pictures on the wall."
    },
    {
      "type": "action",
      "text": "He leans in to study them and his POV reveals a collection of framed photographs of the same young woman. In some of them she is obviously posed; the black-and-white ones in particular look like professionally shot modelling photos. The Young woman is an attractive blonde."
    },
    {
      "type": "action",
      "text": "He stares at the pictures for a few seconds, then turns back to the room. He crosses to the small table with some framed photographs on it and leans over to examine the pictures. They are all of The Blonde. The Young Man picks up one of the framed photos and looks at it more closely."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Hey! Take a look in here!"
    },
    {
      "type": "action",
      "text": "The Young Man places the picture back on the table, keeping his eyes on it until he has moved several steps towards the door."
    },
    {
      "type": "scene-heading",
      "text": "INT. HALL - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man exits the living room and walks down the corridor looking into the room for Cobb. He enters a room near the front door."
    },
    {
      "type": "scene-heading",
      "text": "INT. BEDROOM - DAY"
    },
    {
      "type": "action",
      "text": "Double bed, light, feminine, patterned fabrics and many cushions, a chest of drawers beneath a framed photograph."
    },
    {
      "type": "action",
      "text": "Cobb is standing in front of the chest of drawers, the top drawer open."
    },
    {
      "type": "action",
      "text": "He is holding up a garter belt for the Young Man."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(mischievous, conspiratorial)"
    },
    {
      "type": "dialogue",
      "text": "Saucy lady, n’est-ce que pas?"
    },
    {
      "type": "action",
      "text": "The Young Man approaches, looking at the photograph above the chest of drawers - it is The Blonde looking serious."
    },
    {
      "type": "action",
      "text": "Cobb turns to the chest of drawers and rummages around."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I haven’t found a bag, yet."
    },
    {
      "type": "action",
      "text": "The Young Man comes up beside Cobb and looks into the drawer - it is full of silk panties. Cobb rummages through them. He looks move interested in the panties than anything he might find in them."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "This is her flat?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Yeah, and she’s a fox."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "But she’s got pictures of herself everywhere."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Yeah, and she looks good. Check this lot out."
    },
    {
      "type": "action",
      "text": "He nods his head at the underwear. The Young Man hesitates and Cobb jerks his head again. The Young Man reaches into the drawer and feels through some of the silk undergarments. Cobb grabs a handful, puts them to his nose and inhales deeply, looking at the Young Man, who shakes his head and smiles pityingly. They stand there, two piggies at the trough. The Young Man grabs some of the panties and lifts them up. He glances up and freezes, seeing the picture of The Blonde looking down at the them."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "You should take some."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What?! No way."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(shrugs)"
    },
    {
      "type": "dialogue",
      "text": "Suit yourself. I’m going to, she’s a babe."
    },
    {
      "type": "action",
      "text": "He stuffs a handful of silk into his pocket and moves from the chest of drawers. The Young Man glances at Cobb, then swiftly pockets some panties when Cobb has turned his back. The Young Man stares up at the picture of The Blonde as he backs away."
    },
    {
      "type": "character",
      "text": "COBB (O.S.) (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Bingo."
    },
    {
      "type": "action",
      "text": "The Young Man turns to see Cobb displaying a large leather holdall. Cobb turns and points at a pair of pearl earrings on the dresser. He picks just one of them up and heads into the hall."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man is stuffing CDs into the leather holdall."
    },
    {
      "type": "action",
      "text": "Cobb is slumped in a large armchair, watching."
    },
    {
      "type": "action",
      "text": "The Young Man straightens up."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "You should take that CD player. It’s small enough."
    },
    {
      "type": "action",
      "text": "The Young Man grabs the player, pulls wires out of the back and sticks it into the holdall. He moves over to a small desk. On the desk lies a set of passport photographs. He stares at four near-identical images of The Blonde."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(without turning around)"
    },
    {
      "type": "dialogue",
      "text": "Why does she have so many pictures of herself?"
    },
    {
      "type": "action",
      "text": "Cobb looks around the room."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I think she’s a model. Certainly vain."
    },
    {
      "type": "action",
      "text": "The Young Man slips the passport photos off the desk and into his pocket. Cobb notices but doesn’t say anything - just smiles to himself. The Young Man turns around. He avoids making eye contact with Cobb."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "That about it?"
    },
    {
      "type": "action",
      "text": "Cobb looks lazily over the room."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I think that covers the useful stuff."
    },
    {
      "type": "action",
      "text": "He hauls himself out of his comfortable chair with a groan."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Let’s go."
    },
    {
      "type": "action",
      "text": "He holds up the single pearl earring."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(mischievous)"
    },
    {
      "type": "dialogue",
      "text": "I’ll just misplace this for her."
    },
    {
      "type": "action",
      "text": "He pulls the seat cushion off the armchair, places the earring on the chair, dead centre, and replaces the cushion."
    },
    {
      "type": "scene-heading",
      "text": "EXT. ROW OF TERRACED TOWNHOUSES - DAY"
    },
    {
      "type": "action",
      "text": "Cobb and the Young Man exit one of the front doors, the Young Man carrying a full leather holdall."
    },
    {
      "type": "action",
      "text": "They turn down the road and walks briskly away."
    },
    {
      "type": "scene-heading",
      "text": "INT. CHARING CROSS STATION LEFT-LUGGAGE OFFICE - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man hands over the leather holdall, takes a ticket and offers it to Cobb."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(refusing the ticket)"
    },
    {
      "type": "dialogue",
      "text": "It was your job. You hang on to the stuff."
    },
    {
      "type": "action",
      "text": "They walk out of the station."
    },
    {
      "type": "scene-heading",
      "text": "EXT. CHARING CROSS STATION - DAY"
    },
    {
      "type": "action",
      "text": "Cobb and the Young Man talk as they stroll away from the building."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Pick it up tomorrow and hang on to it till I let you know we’re ready to fence it."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Right."
    },
    {
      "type": "action",
      "text": "Cobb looks thoughtfully at the Young Man."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(seductive, drawing him in further)"
    },
    {
      "type": "dialogue",
      "text": "Unless, of course, you want to sell it yourself and just give me my half of what you get for it."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Wouldn’t know how to go about it."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Look, about being hard on you back at that first place: I won’t let anyone put me at risk, it’s dangerous enough already."
    },
    {
      "type": "action",
      "text": "They stop, unsure how to proceed."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "An early supper, I think."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Look, I really can’t afford -"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(smiling)"
    },
    {
      "type": "dialogue",
      "text": "It’s covered."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "INT. RESTAURANT - NIGHT"
    },
    {
      "type": "action",
      "text": "Formal, expensive, white linen, mirrors."
    },
    {
      "type": "action",
      "text": "The Young Man and The Blonde are seated at a table in one corner; cosy, intimate. They are having coffee."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "How was your food?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(looking down)"
    },
    {
      "type": "dialogue",
      "text": "Fine."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "So what is it?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You chose this restaurant because you knew we wouldn’t run into him here."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "So?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You said it was over between the two of you."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "It is."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Then why -"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "I also said that he’s dangerous."
    },
    {
      "type": "action",
      "text": "The Young Man looks at her imploringly."
    },
    {
      "type": "character",
      "text": "THE BLONDE (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(pitying but impatient)"
    },
    {
      "type": "dialogue",
      "text": "Fine. An example. One night he came back to the flat - my flat - with a couple of the thugs who work for him. That meant trouble; right away I could tell something was going to happen. Then, a little later this other man arrives..."
    },
    {
      "type": "transition",
      "text": "DISSOLVE TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. THE BLONDE’S FLAT, FRONT HALL - DAY"
    },
    {
      "type": "action",
      "text": "A heavy-set man opens the door to a smaller man and motions him towards the living room."
    },
    {
      "type": "character",
      "text": "THE BLONDE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "... you don’t need to know who he was or anything about him except that he had cheated them out of some of their money..."
    },
    {
      "type": "scene-heading",
      "text": "INT. THE BLONDE’S FLAT, LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "The Blonde sits in the armchair, smoking, nervous. Baldy and a heavy-set man welcome the smaller man into the room."
    },
    {
      "type": "character",
      "text": "THE BLONDE (V.O.)"
    },
    {
      "type": "dialogue",
      "text": "... just money, that’s all."
    },
    {
      "type": "action",
      "text": "The two heavy-set men grab the smaller man and force him to the ground spreading his arms out before him, pinning his wrists to the floor, one of them kneeling on his back."
    },
    {
      "type": "action",
      "text": "Baldy brings the hammer down on to a finger with tremendous force."
    },
    {
      "type": "action",
      "text": "The Blonde gets up to leave. Baldy looks up at her, pointing at her with the hammer."
    },
    {
      "type": "character",
      "text": "BALDY"
    },
    {
      "type": "dialogue",
      "text": "Stay. Watch."
    },
    {
      "type": "action",
      "text": "The Blonde stops at the door and turns around. Baldy starts smashing all of the smaller man’s fingers in turn."
    },
    {
      "type": "action",
      "text": "The Blonde closes her eyes and presses her face against the door frame as if she’s trying to burrow her way out."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. RESTAURANT - NIGHT"
    },
    {
      "type": "action",
      "text": "The Young Man listens intently."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "He smashed all of his fingers... then he split his head open..."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. THE BLONDE’S LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "Baldy grunts as he brings the hammer down sharply."
    },
    {
      "type": "action",
      "text": "Baldy stands up and drops the hammer. There is blood."
    },
    {
      "type": "action",
      "text": "The Blonde is crying."
    },
    {
      "type": "character",
      "text": "BALDY"
    },
    {
      "type": "dialogue",
      "text": "Give me a fucking tea-towel or something."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. RESTAURANT - NIGHT"
    },
    {
      "type": "action",
      "text": "The Young Man is speechless. The Blonde sips at her coffee before continuing."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Dangerous enough for you?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Is it true?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Yes."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Christ. You don’t see him any more?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(deadpan)"
    },
    {
      "type": "dialogue",
      "text": "After he messed up my rug like that?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "That’s not funny."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "I know."
    },
    {
      "type": "action",
      "text": "They both sip their coffees. The Young Man looks thoughtfully at her."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "So how did you meet him?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Let’s not talk about him -"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(bitter)"
    },
    {
      "type": "dialogue",
      "text": "Did you work for him?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(furious)"
    },
    {
      "type": "dialogue",
      "text": "That’s none of your fucking business! You’re sick. And a hypocrite. You loved hearing that story, you want to hear some more for your jollies... you’re as bad as the freak who stole my pants..."
    },
    {
      "type": "parenthetical",
      "text": "(rising from the table)"
    },
    {
      "type": "dialogue",
      "text": "...well, you can fuck off, you filthy little shit."
    },
    {
      "type": "action",
      "text": "She throws her napkin down, upsetting her water glass, and strides away from the table. The Young Man grabs the glass, mopping at the spilt water with the napkin. He looks around to see if the other diners have noticed (they have). He catches the waiter’s eye and scribbles in the air for the bill."
    },
    {
      "type": "action",
      "text": "He takes out a credit card. He looks down at it, turning it over in his hands before laying it down on the table."
    },
    {
      "type": "action",
      "text": "The name on the card is Timothy Kerr."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "EXT. OFFICE BUILDING - NIGHT"
    },
    {
      "type": "action",
      "text": "The Young Man (short hair, sunglasses) glances around before diving into the side alleyway."
    },
    {
      "type": "action",
      "text": "He moves along the building, counting the windows as he goes."
    },
    {
      "type": "action",
      "text": "Finding the right one, he pulls his hammer out and levers it open using the claw. Looking about, he lifts the window and hauls himself through."
    },
    {
      "type": "scene-heading",
      "text": "INT. OFFICE - NIGHT"
    },
    {
      "type": "action",
      "text": "Big desk, filing cabinets, couple of chairs."
    },
    {
      "type": "action",
      "text": "The Young Man slithers through the window and on to the floor behind the desk."
    },
    {
      "type": "action",
      "text": "He gets on to his haunches and removes his sunglasses, putting them into his breast pocket. He looks around the office. It is well lit from the streetlights outside the windows."
    },
    {
      "type": "action",
      "text": "The Young Man moves to the bookshelves and starts to remove books, stacking them on the floor quickly but quietly."
    },
    {
      "type": "action",
      "text": "Halfway through the second shelf he uncovers a safe set into the wall."
    },
    {
      "type": "action",
      "text": "Excited, hands trembling, he removes a piece of paper from his pocket. It has a series of numbers written on it. He spins the dial according to the numbers. He tries the door - it won’t open. He tries the combination again, pulls the door and this time it swings open to reveal a large stack of money. The Young Man is shocked by the amount. Next to the money is an A4 envelope."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Bingo."
    },
    {
      "type": "action",
      "text": "He pulls the money and the envelope out of the safe, leaving it in a pile on the floor. He stands up and looks around."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(under his breath)"
    },
    {
      "type": "dialogue",
      "text": "Bag."
    },
    {
      "type": "action",
      "text": "He opens the desk drawers, looking in each one. He opens the closet, searching around, finding nothing."
    },
    {
      "type": "action",
      "text": "Increasingly frantic now, the Young Man paces around the room, peering into every corner, looking behind every piece of furniture. At length, he stops, exasperated."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(loud whisper)"
    },
    {
      "type": "dialogue",
      "text": "FUCK!"
    },
    {
      "type": "action",
      "text": "He looks at the bundles of banknotes. He looks at the cluttered desk. There is a roll of masking tape on the desk. The Young Man steps over, grabs the tape and pulls off a long strip, breaking it with his teeth and we:"
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "INT. FRENCH RESTAURANT - DUSK"
    },
    {
      "type": "action",
      "text": "Understated. Expensive; polished wooden floors, starched linen, well-dressed clientele. The Young Man and Cobb are seated at a table near the back of the place."
    },
    {
      "type": "action",
      "text": "Cobb eat his good with small, graceful movements. In his dark suit and tie he fits right in, unlike the Young Man, who is shabbily dressed, unshaven, has long greasy hair and looks ill at ease."
    },
    {
      "type": "action",
      "text": "Cobb finishes chewing a large bit of his steak, sips from his glass of water, then dabs his lips gently with his napkin."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "You’re developing a taste for it."
    },
    {
      "type": "action",
      "text": "The Young Man looks up from his food."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "The violating, the voyeurism - it’s definitely you."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I think not."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I think so. And I think before long you’ll develop a taste for the things you can do with the proceeds."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Such as?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(gesturing around them)"
    },
    {
      "type": "dialogue",
      "text": "This."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You make all of your money that way."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(smiling)"
    },
    {
      "type": "dialogue",
      "text": "Not all of it. You’re going to pay for this."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "But I told you, I can’t afford -"
    },
    {
      "type": "action",
      "text": "He is silenced by Cobb throwing a credit card on the table."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "It won’t really be you, it’ll be..."
    },
    {
      "type": "parenthetical",
      "text": "(he tilts his head to at the card)"
    },
    {
      "type": "dialogue",
      "text": "Timothy Kerr. But I thought I’d give you the pleasure of pretending to pay."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "But how -"
    },
    {
      "type": "action",
      "text": "Cobb tosses a pen on to the table next to the card."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Sign it."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(picking up the card)"
    },
    {
      "type": "dialogue",
      "text": "Sign it?"
    },
    {
      "type": "action",
      "text": "He looks at the card. He turns it over; there is no signature on the white strip. He looks up at Cobb."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Sign it in your own handwriting and you can use it for anything. I wouldn’t use it for more than a day or two, just to be safe."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(a whisper)"
    },
    {
      "type": "dialogue",
      "text": "Christ."
    },
    {
      "type": "action",
      "text": "The two men smile at each other. The Young Man reaches for the pen. He signs the back and pockets the card, shaking hsi head and laughing."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Don’t you worry about being caught?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Why else would I do it? Besides, I’m not going to get caught."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You’ve thought it all through."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(raises wine glass)"
    },
    {
      "type": "dialogue",
      "text": "I’ve thought it all through."
    },
    {
      "type": "parenthetical",
      "text": "(pause)"
    },
    {
      "type": "dialogue",
      "text": "This is just the tip of the iceberg, I do things you wouldn’t believe."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Such as?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "An example. Sometimes when I’m watching a place I’ll see that the owners are about to go on holiday. I’ll wait till they’ve gone, then move in for a week or so."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You’ve got to be joking."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Happens a lot more often than you’d think."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "But how do you know how long they’ll be gone for?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Almost always marked on the kitchen calendar."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(a whisper)"
    },
    {
      "type": "dialogue",
      "text": "Christ."
    },
    {
      "type": "action",
      "text": "He takes a sip from his win, then shovels a forkful of food into his mouth. He chews for a second then freezes, his eyes locked on something at the far end of the restaurant, behind Cobb."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(through steak)"
    },
    {
      "type": "dialogue",
      "text": "Jesus fucking Christ!"
    },
    {
      "type": "action",
      "text": "Cobb narrows his eyes."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "What’s wrong?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(swallows hard)"
    },
    {
      "type": "dialogue",
      "text": "The woman, the woman from that first place, the one who came home, the, the, the one who saw me - us... she just walked in."
    },
    {
      "type": "action",
      "text": "The Young Man’s POV shows us the young woman from the first robbery and a man, whom we have not seen before, waiting to be seated."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(calm, not turning round)"
    },
    {
      "type": "dialogue",
      "text": "Are you sure?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Yes, I’m fucking sure!"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(impatient)"
    },
    {
      "type": "dialogue",
      "text": "Is she with the same bloke?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "No."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "We’re all right then."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "All right?! What if she sees us?!"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "If she sees us, she won’t do anything. She’s with her partner now and she won’t want to have to explain how she found us at their flat when she was supposed to be at work."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "That’s one hell of a chance to take!"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(fed up)"
    },
    {
      "type": "dialogue",
      "text": "Look, just calm down. What would she do anyway? All we stole was half a bottle of an indifferent red wine. Just relax, keep your head."
    },
    {
      "type": "action",
      "text": "The Young Man looks at his plate, trying to stay calm."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You mind if we skip dessert?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(with disgust)"
    },
    {
      "type": "dialogue",
      "text": "Yes, I fucking mind."
    },
    {
      "type": "scene-heading",
      "text": "INT. FRENCH RESTAURANT - NIGHT"
    },
    {
      "type": "action",
      "text": "Later."
    },
    {
      "type": "action",
      "text": "Cobb is scraping up the last of his chocolate mousse. An almost untouched dessert sits in front of the Young Man, who repeatedly glances up past Cobb’s head. The Young Man’s POV shows us the young woman seated with her companion at the other end of the restaurant."
    },
    {
      "type": "action",
      "text": "The young woman pushes her chair back from the table, stands up, places her napkin on her chair and heads towards Cobb and the Young Man’s table. The Young Man looks terrified."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "She’s coming this way."
    },
    {
      "type": "action",
      "text": "Cobb looks up from his chocolate mousse. He nods at a door off to his left."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "She’s going to the loo, relax."
    },
    {
      "type": "action",
      "text": "The Young Man can’t take his eye off the young woman as she approaches."
    },
    {
      "type": "action",
      "text": "She comes near their table. As she turns to the left she notices the Young Man and looks at him for an instant with something which might be recognition. She carries on, passing through the doors to the lavatories."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(losing it)"
    },
    {
      "type": "dialogue",
      "text": "She fucking looked at me!"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Yeah?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Yeah! She fucking knows - we have to leave!"
    },
    {
      "type": "action",
      "text": "Cobb places his spoon back into his dish and looks up at the Young Man with an almost bored expression."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(gesturing to the waiter)"
    },
    {
      "type": "dialogue",
      "text": "We’ll leave - not that we have anything to worry about other than you making a twat of yourself."
    },
    {
      "type": "scene-heading",
      "text": "EXT. FRENCH RESTAURANT - NIGHT"
    },
    {
      "type": "action",
      "text": "Cobb and the Young Man exit. Cobb suddenly turns on the Young Man as if he might hit him."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(pointing at the Young Man’s face)"
    },
    {
      "type": "dialogue",
      "text": "You know, I really hate it when I don’t get to finish a good meal with a coffee."
    },
    {
      "type": "action",
      "text": "The Young Man looks flabbergasted."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "But -"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(bitter)"
    },
    {
      "type": "dialogue",
      "text": "Just don’t fucking say it!"
    },
    {
      "type": "action",
      "text": "He waves at a taxi."
    },
    {
      "type": "scene-heading",
      "text": "INT. BACK OF TAXI - NIGHT"
    },
    {
      "type": "action",
      "text": "Cobb looks out of the window like a sullen child. The Young Man looks at him, thinking."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Look, she recognized me, OK? She’s had a second look at me. It makes me nervous."
    },
    {
      "type": "action",
      "text": "Cobb turns to the Young Man."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(calm)"
    },
    {
      "type": "dialogue",
      "text": "If you’re worried about being recognized, why don’t you do something about your appearance? Haircut, smart clothes, your own mother won’t recognize you."
    },
    {
      "type": "action",
      "text": "The Young Man looks down at himself, chastened."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(grinning to himself)"
    },
    {
      "type": "dialogue",
      "text": "Just because you break into people’s homes, doesn’t mean you have to look like a criminal."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "EXT. ROW OF TERRACED TOWNHOUSES - NIGHT"
    },
    {
      "type": "action",
      "text": "The Young Man (short hair, clean-shaven) buzzes The Blonde."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(voice on tannoy)"
    },
    {
      "type": "dialogue",
      "text": "Fuck off."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "How do you know it’s me? Could be your mother you just told to fuck off."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(voice on tannoy)"
    },
    {
      "type": "dialogue",
      "text": "I mean it."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Please, just let me in... I’ve come to apologize."
    },
    {
      "type": "action",
      "text": "The lock clicks open and he steps inside."
    },
    {
      "type": "scene-heading",
      "text": "INT. THE BLONDE’S FLAT, HALLWAY - NIGHT"
    },
    {
      "type": "action",
      "text": "The Young Man walks slowly down the corridor. Passing the bedroom he sees The Blonde Sitting on the bed. He stands in the doorway."
    },
    {
      "type": "scene-heading",
      "text": "INT. BEDROOM - NIGHT"
    },
    {
      "type": "action",
      "text": "Double bed, light, feminine, patterned fabrics and many cushions, a chest of drawers."
    },
    {
      "type": "action",
      "text": "The Blonde sits on the bed, legs crossed, smoking a cigarette. The Young Man considers his opening line."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "So apologize."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I haven’t been entirely honest with you."
    },
    {
      "type": "action",
      "text": "The Blonde raises her eyebrows."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I’m writing about burglaries."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(confused)"
    },
    {
      "type": "dialogue",
      "text": "What?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I’m researching burglaries. I’m, I’m doing a piece about a guy I know who burgles people. That’s why I’ve been asking you questions about your burglary."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Why didn’t you just tell me."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I didn’t want to upset you. See, I’ve been breaking into houses with him - that is, he’s been breaking in and I’ve been watching him. I mean, I haven’t taken anything or... whatever, I just go along and watch, for my research."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Is that it?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Yes."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "What does that have to do with anything?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Now I’ve been honest with you, I’d like you to return the favor."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "I have been honest with you."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You’re still seeing the bald guy."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(flustered)"
    },
    {
      "type": "dialogue",
      "text": "How do -"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I was early the other day. I saw him leave. You said it was over."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(resigned)"
    },
    {
      "type": "dialogue",
      "text": "It is."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(quizzical)"
    },
    {
      "type": "dialogue",
      "text": "Then why?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "He’s blackmailing me."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You said he’s rich - why would..."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(bitter)"
    },
    {
      "type": "dialogue",
      "text": "Who said anything about money?"
    },
    {
      "type": "action",
      "text": "The Young Man sighs. He slides down the wall to sit in the doorway, his back against the frame. After a moment’s thought he looks up at The Blonde."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What’s he blackmailing you with?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Photos."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Of what?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Of me. And don’t ask me anything else about them. You’d only want the details to fuel your seedy little fantasies. Let’s just say that my mother wouldn’t frame them for her sideboard."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You’ve got me all wrong, you know."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Have I?"
    },
    {
      "type": "action",
      "text": "The Young Man nods. He thinks for a moment."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "So where does he keep them?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "In his office. Why?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Maybe I can get them back."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "How?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Break in and take them. I can get my friend to do it with me - there must be valuable stuff in his office, right?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "He sometimes has money in his safe."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(shaking his head)"
    },
    {
      "type": "dialogue",
      "text": "No, we can’t get into a safe -"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "That’s where the pictures are."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "In a manilla envelope in his safe, negatives and eight-by-ten prints."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Then we can’t -"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "I know the combination."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "How?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "I’ve seen him open it a million times. I’ve always figured that I might get a chance to lift the photos."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Right, that’s what we’ll do then."
    },
    {
      "type": "action",
      "text": "He gets up and moves on to the bed."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Nobody in their right mind would steal from him."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(putting his arms around her)"
    },
    {
      "type": "dialogue",
      "text": "If we don’t get caught it won’t make any difference who it was we stole from - and we won’t get caught."
    },
    {
      "type": "action",
      "text": "He kisses The Blonde. She pulls away to speak."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Just promise me one thing. If you get the pictures you’ll bring them to me without looking at them, without even opening the envelope."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Of course."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "I’ve got your word?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You have my word."
    },
    {
      "type": "action",
      "text": "They kiss again."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "INT. OFFICE - NIGHT"
    },
    {
      "type": "action",
      "text": "The Young Man (short hair, bruised face) has taken his jacket off and is frantically taping bundles of money to his arms and around his waist. He works in a frenzy, ripping masking tape with his teeth, grabbing bundles and slapping them against his stomach. He covers his arms and abdomen, but there’s still a lot more money, so he undoes his trousers, pulls them off and frantically starts to tape bundles to his bare legs. His jacket, the manilla envelope and his hammer are sitting on the desk. He grabs a bundle and tapes it to his ankle. He straightens up, looks at the remaining money."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(whisper)"
    },
    {
      "type": "dialogue",
      "text": "Fuck it."
    },
    {
      "type": "action",
      "text": "He takes the tape and passes it around his midriff, securing the bundles which he has already taped to his waist."
    },
    {
      "type": "action",
      "text": "As he is doing so the overhead light snaps on and the Young Man freezes."
    },
    {
      "type": "action",
      "text": "One of Baldy’s business companions is standing in the office doorway, a look of amazement on his face. Neither man moves. The Young Man eyes the hammer on the desk, within easy reach. He grabs it as he launches himself at Baldy’s man, trailing bank notes in the air behind him as he flies across the room, hammer raised."
    },
    {
      "type": "action",
      "text": "The Young Man brings the hammer down across the other man’s head in a nasty sideswipe. The man goes down and doesn’t get up. The Young Man moves back to the desk, shocked. He clumsily puts his trousers on over the money, then looks over at the man on the floor as he grabs for his suit jacket. The man is not moving; there is blood on his head and on the floor."
    },
    {
      "type": "action",
      "text": "The Young Man gets his jacket on, tears his eyes away from the prone man to realize that he has blood on his hands and now on his previously white shirt. He shudders as he jams the bloody hammer into his waistband, grabs the manilla envelope and heads for the window. A last glance at the prone man before climbing out of the window."
    },
    {
      "type": "scene-heading",
      "text": "EXT. SIDE STREET - NIGHT"
    },
    {
      "type": "action",
      "text": "The Young Man practically falls out of the window and on to the ground. He struggles to his feet, weaving like a drunk, and heads away from the office window towards the main street."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "INT. BATHROOM - DAY"
    },
    {
      "type": "action",
      "text": "Small, cold, dingy."
    },
    {
      "type": "action",
      "text": "The Young Man stands in front of the mirror, examining his longish hair and attempt at a beard."
    },
    {
      "type": "action",
      "text": "He picks up some nail scissors and starts to cut his hair."
    },
    {
      "type": "scene-heading",
      "text": "INT. BEDROOM - DAY"
    },
    {
      "type": "action",
      "text": "Small, dark, cluttered."
    },
    {
      "type": "action",
      "text": "The Young Man is knotting a tie in front of a dusty, cracked mirror. He is wearing a dark suit, old-fashioned and well- worn. His hair is dramatically shorter; a ragged near-crew cut."
    },
    {
      "type": "action",
      "text": "He plays with his hair, looking at his reflection. He rubs his newly shaven chin."
    },
    {
      "type": "action",
      "text": "Close on the mirror we see that the strip of passport photos of The Blonde are wedged into the bottom right-hand corner of the frame."
    },
    {
      "type": "action",
      "text": "The Young Man’s eye is caught by the photos and he picks them up, looking closely at them, a thoughtful expression on his face."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "Lighter. Neater, apart from the paper-covered desk."
    },
    {
      "type": "action",
      "text": "The Young Man is on the phone, waiting for it to be picked up at the other end. We hear the click as it is answered."
    },
    {
      "type": "character",
      "text": "MALE VOICE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Yeah?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Cobb? Bill."
    },
    {
      "type": "character",
      "text": "MALE VOICE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Hello, ‘Bill’."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. INDISTINCT SURROUNDINGS; A WINDOW COVERED BY A NET"
    },
    {
      "type": "action",
      "text": "CURTAIN - DAY"
    },
    {
      "type": "action",
      "text": "Cobb is standing by the windows on the phone. He wears a white shirt, unbuttoned."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "What can I do for you?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Nothing too important."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - DAY"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "It’s about the stuff."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "What about it?"
    },
    {
      "type": "action",
      "text": "The Young Man’s other hand comes into frame; he is holding the passport photos as well as some bunched-up silk."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(staring at the photos)"
    },
    {
      "type": "dialogue",
      "text": "I’ve met a guy - I won’t go into details. I’ll take care of it myself as you suggested, and you’ll get half. I can’t promise to get as much as you would but I’d like to give it a go. How does that sound?"
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Sounds fine. Anything else?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I took your advice."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "What advice?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "My appearance. I cut my hair, and I’m all dressed up."
    },
    {
      "type": "character",
      "text": "COBB (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "‘With no place to go.’"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. BY THE WINDOW - DAY"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "You know I wasn’t being entirely serious about that."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "It makes me feel better."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Safer, huh?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Safer. I’ll give you a call when I’ve got the money."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Right."
    },
    {
      "type": "action",
      "text": "He hangs up. We go wider and see that he is leaning on the windowsill in what appears to be a bedroom. His shirt is completely untucked and unbuttoned."
    },
    {
      "type": "character",
      "text": "FEMALE VOICE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "What was all that about?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "You."
    },
    {
      "type": "action",
      "text": "Cobb’s POV shows us The Blonde, lying in bed, under the sheets, but apparently naked."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Your stuff, anyway."
    },
    {
      "type": "action",
      "text": "He clambers up on to the bed to lean against the wall beside The Blonde."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "He’s going to deal with it himself."
    },
    {
      "type": "action",
      "text": "The Blonde lays her arm across Cobb’s stomach and looks up at him."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Meaning?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Meaning he took the bait and he’s hooked. He’s going to hang on to your stuff, pretend to sell it, give me some money. If you’re lucky he might even give you most of it back. It’s perfect, the photos worked. I’ve even got him to cut his hair and change his clothes."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "So are you going to tell me where you hid my earring, now?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(grinning)"
    },
    {
      "type": "dialogue",
      "text": "No. And I wouldn’t hold your breath for the return of your underwear, either. He’ll be far too embarrassed to admit to stealing your panties."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Shit. And did you have to pretend to break down my door?"
    },
    {
      "type": "parenthetical",
      "text": "(MORE)"
    },
    {
      "type": "character",
      "text": "THE BLONDE (CONT'D)"
    },
    {
      "type": "dialogue",
      "text": "Couldn’t you have pretended to find the spare key?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(laughing)"
    },
    {
      "type": "dialogue",
      "text": "Couldn’t. That would have been three spare keys in a row - even ‘Bill’ isn’t going to buy that. When went to his place it was embarrassing - right under the mat, just like I told him... pathetic. It was a new mat as well, and I swear, I seriously think he went out and bought the mat just so he could put his key under it."
    },
    {
      "type": "action",
      "text": "The Blonde laughs. Cobb laughs."
    },
    {
      "type": "transition",
      "text": "FADE TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. YOUNG MAN’S BEDROOM - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man is knotting his tie in front of the mirror."
    },
    {
      "type": "action",
      "text": "The Blonde is lying on the bed behind him."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "What if he won’t help?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Then I’ll do it on my own."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "How long will you be?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Couple of hours."
    },
    {
      "type": "scene-heading",
      "text": "EXT. CHARING CROSS STATION LEFT-LUGGAGE OFFICE - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man hands over his ticket and collects the leather holdall."
    },
    {
      "type": "scene-heading",
      "text": "EXT. HUNGERFORD BRIDGE - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man crosses south, carrying the leather holdall."
    },
    {
      "type": "scene-heading",
      "text": "INT. HALLWAY IN A BLOCK OF FLATS - DAY"
    },
    {
      "type": "action",
      "text": "The Young Man knocks on a door."
    },
    {
      "type": "action",
      "text": "The door is opened by Cobb."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "You’re late."
    },
    {
      "type": "parenthetical",
      "text": "(noticing the holdall)"
    },
    {
      "type": "dialogue",
      "text": "You said you’d fenced it."
    },
    {
      "type": "action",
      "text": "He steps back to let the Young Man in."
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "Comfortable, tastefully furnished."
    },
    {
      "type": "action",
      "text": "Cobb is sitting on the couch. The Young Man stands at the window."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "It’ll take me a few days to sell all of it."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Whatever."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Something else on your mind?"
    },
    {
      "type": "action",
      "text": "The Young Man turns to face Cobb."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I want to break into a place."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I’ve been scouting a couple -"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "A particular place. For some photos."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Photos?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Photos. For a friend."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "What’s the place?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Office. In a safe, but we’ll have the combination."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "If it’s for a friend, where’s the money in it?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "There’s money in the safe... probably."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Probably? Whose office?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Club-owner, pornographer type."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Heavy?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "From the sound of it."
    },
    {
      "type": "action",
      "text": "Cobb exhales. He stares hard at the Young Man."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "What the fuck’s going on?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I’m seeing someone. They need my help."
    },
    {
      "type": "action",
      "text": "Cobb stands up and walks over to the Young Man."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Who are you seeing?"
    },
    {
      "type": "action",
      "text": "The Young Man looks away."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(loud)"
    },
    {
      "type": "dialogue",
      "text": "Who?! Who are you seeing?!"
    },
    {
      "type": "action",
      "text": "The Young Man looks into Cobb’s eyes."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "The owner of the bag."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(confused)"
    },
    {
      "type": "dialogue",
      "text": "What?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "The woman who owns the flat we hit - the one with the pictures of herself."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(barely concealing rage)"
    },
    {
      "type": "dialogue",
      "text": "Tell me you’re fucking joking."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(excited)"
    },
    {
      "type": "dialogue",
      "text": "Her pictures - I was curious, I followed her, got to know her. She’... she’s... she’s... we’re in love."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "You’ve slept with her?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(unaware of Cobb’s growing rage)"
    },
    {
      "type": "dialogue",
      "text": "Yeah. She’s fantastic, amazing. That’s why I haven’t sold her stuff, I mean, I thought that I might give it back to her but that would mean -"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "That would mean telling her that it was you who fucking robbed her! How shrew - How, how, how, prudent of you not to tell her that!"
    },
    {
      "type": "action",
      "text": "The Young Man is quiet, realizing he has misjudged the situation."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Nice hair, by the way. And a nice suit, shame about the bloodstains, though."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(looks down at himself)"
    },
    {
      "type": "dialogue",
      "text": "Bloodstains?"
    },
    {
      "type": "action",
      "text": "Cobb punches him in the face then belts him in the stomach. The Young Man doubles over, groaning."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I fucking warned you."
    },
    {
      "type": "action",
      "text": "He smiles as he brings his elbows down hard into the Young Man’s back. The Young Man grunts and staggers to the side, just keeping on his feet. Cobb pushes him back across the room and charges at him."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I won’t let anyone put me at risk."
    },
    {
      "type": "action",
      "text": "As he speaks, Cobb grabs the Young Man’s face with one hand and punches him hard in the face several times."
    },
    {
      "type": "action",
      "text": "The Young Man slips to the floor, dragging Cobb down with him. The two men scrabble around on the floor, the Young Man putting up a right until Cobb finally swivels round and boots him in the ribs, then the face."
    },
    {
      "type": "action",
      "text": "The Young Man groans and bleeds as Cobb staggers to his feet, out of breath. Cobb dusts himself down and does his hair in the mirror."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(at his reflection)"
    },
    {
      "type": "dialogue",
      "text": "Idiot. How could you be so stupid?"
    },
    {
      "type": "parenthetical",
      "text": "(turns to look at the Young Man)"
    },
    {
      "type": "dialogue",
      "text": "You’re on your own, Billy-boy. Here... (reaches into his pocket and pulls out a pair of rubber gloves; he tosses them at the Young Man) ... take these. Present from you. To get you started on your new solo career."
    },
    {
      "type": "action",
      "text": "He reaches down and pulls the Young Man to his feet. The Young Man’s face is a bloody mess. Cobb picks up the rubber gloves and stuffs them into the Young Man’s breast pocket."
    },
    {
      "type": "action",
      "text": "He drags the Young Man to the door."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "Now, fuck off."
    },
    {
      "type": "action",
      "text": "He throws the Young Man out of the door and slams it behind him. He laughs hysterically as he walks back into the living room and we:"
    },
    {
      "type": "transition",
      "text": "DISSOLVE TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. COBB’S LIVING ROOM - NIGHT"
    },
    {
      "type": "action",
      "text": "Cobb is lying on the floor, tossing a golfball into the air and catching it just before it hits his face."
    },
    {
      "type": "action",
      "text": "The Blonde is sitting on the couch."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Did you have to beat him?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Did you have to sleep with him?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "You told me to."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I said you should if you had to, that’s not the same as telling you to."
    },
    {
      "type": "parenthetical",
      "text": "(catches the ball and looks over)"
    },
    {
      "type": "dialogue",
      "text": "Did you enjoy it?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Did you enjoy beating him up?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Of course."
    },
    {
      "type": "action",
      "text": "The Blonde shakes her head pityingly."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "He brought it on himself. He didn’t have to tell me he was seeing you, but once he did I had to react the way I would really."
    },
    {
      "type": "action",
      "text": "He sits up."
    },
    {
      "type": "character",
      "text": "COBB (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I’m in deep shit, this has to work."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "But why are you so sure they think you were involved?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "They’ve already had me in for questioning, for Christ’s sake. They know my m.o. And it’s just a matter of time before they find the bloke who saw me leave and pull me in."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "You think he got a good look at you?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "No, which is why this will work; all we need is someone else with the same way of working and roughly the same appearance caught in the act."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Why can’t you just tell them what really happened - that you just found her like that?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "If you’d seen her, you wouldn’t even ask. It was horrible, blood everywhere. Her face had been... beaten... almost not human. I’d been in the flat a while, I may have left traces, forensic stuff, I don’t know. But she was fresh, she hadn’t been dead long, the witness might put me there close enough to the time of death -"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "But if he didn’t get the a good look -"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "That’s not the point! A crime that brutal, an old lady beaten like that... if they think it’s me, they’ll find a way to make it stick. There has to be someone else - I’ve told them there’s someone else!"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "What if he has an alibi?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "He’s a loner, that’s why he’s so perfect. And he looks so different now that strangers aren’t going to remember having seen him. He’s our man."
    },
    {
      "type": "action",
      "text": "The Blonde and Cobb look at each other."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "EXT. NARROW PASSAGEWAY CONNECTING TWO STREETS LIT BY A"
    },
    {
      "type": "action",
      "text": "STREETLIGHT - NIGHT"
    },
    {
      "type": "action",
      "text": "It is raining."
    },
    {
      "type": "action",
      "text": "The Young Man (short shair, shades) stumbles along. His dark suit bulges oddly. He brings his hand up to adjust his shades and we see a fifty-pound note sticking out of his cuff."
    },
    {
      "type": "action",
      "text": "He disappears around the corner and we:"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. LIVING ROOM - NIGHT"
    },
    {
      "type": "action",
      "text": "The Young Man has taken his suit off and is removing the money from his body. He is wet, his tie is loose, there is blood on his shirt, he is on the phone."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(strained, on edge)"
    },
    {
      "type": "dialogue",
      "text": "I got it."
    },
    {
      "type": "character",
      "text": "THE BLONDE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "You’re bringing them to me?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(bending to remove money from his leg)"
    },
    {
      "type": "dialogue",
      "text": "I had to stop off to dump the money."
    },
    {
      "type": "character",
      "text": "THE BLONDE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Money?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(giggling)"
    },
    {
      "type": "dialogue",
      "text": "Lot of fucking money!"
    },
    {
      "type": "action",
      "text": "He yelps as he yanks tape from his hairy legs."
    },
    {
      "type": "character",
      "text": "THE BLONDE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "What?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Nothing. I’ll be over soon."
    },
    {
      "type": "character",
      "text": "THE BLONDE (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "So it was OK?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(a pause, close to tears)"
    },
    {
      "type": "dialogue",
      "text": "OK, yeah. I’ll be over soon."
    },
    {
      "type": "action",
      "text": "He hangs up the phone. He’s removed most of the money, but odd bundles hang from his legs and shirt."
    },
    {
      "type": "action",
      "text": "He looks at the hammer lying on the floor, blood on it. Next to the hammer lies the manilla envelope."
    },
    {
      "type": "action",
      "text": "The Young Man picks up the envelope, pauses for a moment, then rips it open and yanks out the contents: eight-by-ten glossies."
    },
    {
      "type": "action",
      "text": "The photos are straight modelling portrait shots of The Blonde - absolutely nothing interesting or remarkable about them whatsoever."
    },
    {
      "type": "action",
      "text": "He flips through them again and again looking for some meaning, some super-subtle obscenity he might be missing, a manic desperate look developing on his face."
    },
    {
      "type": "action",
      "text": "He flings them across the room, and we:"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. OUTSIDE THE BLONDE’S FLAT"
    },
    {
      "type": "action",
      "text": "The Young Man looks up at the window. He’s not happy."
    },
    {
      "type": "scene-heading",
      "text": "INT. THE BLONDE’S FRONT HALL - NIGHT"
    },
    {
      "type": "action",
      "text": "The Blonde moves to answer the door."
    },
    {
      "type": "action",
      "text": "The door opens to reveal a wet, bedraggled Young Man, bruises on his face. The Young Man slaps The Blonde hard and walks in past her. She expresses neither pain nor surprise."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "You promised me you wouldn’t look in the envelope."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Wasn’t sealed, they fell out."
    },
    {
      "type": "action",
      "text": "The Blonde stairs at him with a half-smile."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Right... They fell out."
    },
    {
      "type": "action",
      "text": "The Young Man looks back at her coldly."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Are you going to explain?"
    },
    {
      "type": "action",
      "text": "The Blonde says nothing."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(rising anger)"
    },
    {
      "type": "dialogue",
      "text": "What?! Was it all bullshit just to get the money?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(shrugs)"
    },
    {
      "type": "dialogue",
      "text": "He’s never had any in there before."
    },
    {
      "type": "action",
      "text": "The Young Man grabs her by the shoulders and shakes her."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "What, then?!!"
    },
    {
      "type": "action",
      "text": "The Blonde puts her hands up defensively to tell him to remove his hands. He does so."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(matter-of-factly)"
    },
    {
      "type": "dialogue",
      "text": "For a friend. The police think he did something which he didn’t and he needs a decoy - another likely suspect, someone caught robbing a place the same way he does, using his methods."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "His methods?"
    },
    {
      "type": "parenthetical",
      "text": "(truth dawning)"
    },
    {
      "type": "dialogue",
      "text": "Who’s the friend?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(mischievous, waiting for a reaction)"
    },
    {
      "type": "dialogue",
      "text": "Cobb."
    },
    {
      "type": "action",
      "text": "The Young Man closes his eyes."
    },
    {
      "type": "action",
      "text": "The Blonde turns away."
    },
    {
      "type": "character",
      "text": "THE BLONDE (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(straight)"
    },
    {
      "type": "dialogue",
      "text": "He broke into a flat a couple of weeks ago. Found an old lady who’d been beaten to death. He ran off, somebody saw him and a few days later the police picked him up for questioning. They think he killed her -"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(opens eyes)"
    },
    {
      "type": "dialogue",
      "text": "He probably did."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "He’s a thief, Not a murderer. He told them they had the wrong man, had him confused with another burglar he knew about, one who has the same m.o....you."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Why me?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(like it’s his own fault)"
    },
    {
      "type": "dialogue",
      "text": "You set yourself up for it. Cobb noticed you following him days before he approached you - at first the thought you were the police but then he followed you -"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "He followed me?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(sarcastic)"
    },
    {
      "type": "dialogue",
      "text": "He followed you and realized that you were just some... weirdo... waiting to be drawn into it, used."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(asking for it)"
    },
    {
      "type": "dialogue",
      "text": "So you and Cobb..."
    },
    {
      "type": "action",
      "text": "The Blonde shrugs and smiles."
    },
    {
      "type": "action",
      "text": "The Young Man slaps the wall hard by the side of The Blonde’s head. She doesn’t flinch. He turns around, raising his hands in total frustration."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "How could you do this to me? To anyone?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "It’s not that bad. You’ve got the money. You didn’t kill the old woman. You’re just there to plant doubt in the minds of the police - they’ll never charge you. The idea was that someone would catch you breaking in tonight, the police would pull you in, then ask you about the old lady - which you wouldn’t know anything about."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(incredulous)"
    },
    {
      "type": "dialogue",
      "text": "Yeah, but they’d still charge me with breaking and entering!"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(amused)"
    },
    {
      "type": "dialogue",
      "text": "But you did do that. And anyway, for whatever reason, nobody did catch you red-handed."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(wielding the bloody hammer)"
    },
    {
      "type": "dialogue",
      "text": "He came in, he went down. I didn’t hang around to see if he got up. It’s his blood on my hammer."
    },
    {
      "type": "parenthetical",
      "text": "(smashes hammer into wall)"
    },
    {
      "type": "dialogue",
      "text": "How could you do this to me?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(unimpressed)"
    },
    {
      "type": "dialogue",
      "text": "It’s not personal. When I agreed to it, I didn’t even known you."
    },
    {
      "type": "action",
      "text": "The Young Man drops the hammer. The Blonde opens her eyes. The Young Man takes a deep breath, regains his composure."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I’m going to the police in the morning."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "You can’t."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I’m going and I’ll tell them everything."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "You can’t - they’ll never believe you."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "I’ll tell them everything and they’ll believe me because it’s the truth."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "They’ll never believe you unless someone backs you up."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "You could."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "I won’t."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(confident)"
    },
    {
      "type": "dialogue",
      "text": "They’ll make you. Your lies won’t hold up against the truth."
    },
    {
      "type": "action",
      "text": "The Blonde turns away, shaking her head."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "You know, I really wouldn’t do -"
    },
    {
      "type": "action",
      "text": "She is cut off by the sound of the door slamming. She turns to see that the Young Man is gone."
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM WITH TABLE - DAY"
    },
    {
      "type": "action",
      "text": "Close on the Young Man (short hair, bruises)"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "That’s it."
    },
    {
      "type": "action",
      "text": "Wider shows us a room lit by early morning sun, the Young Man seated at a table, an Older Man opposite. Between them on the table is a tape recorder. They both look tired. The Older Man doesn’t speak."
    },
    {
      "type": "character",
      "text": "YOUNG MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I mean.. If you’ve got questions.."
    },
    {
      "type": "action",
      "text": "The Older Man leans forward."
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "dialogue",
      "text": "One or two."
    },
    {
      "type": "action",
      "text": "A pause. The Young Man raises his eyebrows in expectation."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. STREET IN THE WEST END - DAY"
    },
    {
      "type": "action",
      "text": "Cobb strolls down the street. He is carrying the leather holdall."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM WITH TABLE AND TAPE RECORDER - DAY"
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "dialogue",
      "text": "You see... We don’t actually have any unsolved murders of old ladies right now."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(baffled)"
    },
    {
      "type": "dialogue",
      "text": "But there has -"
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "parenthetical",
      "text": "(more assertive)"
    },
    {
      "type": "dialogue",
      "text": "There is no such ongoing investigation."
    },
    {
      "type": "action",
      "text": "The Young Man looks confused and scared."
    },
    {
      "type": "character",
      "text": "OLDER MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "And we don’t know this..."
    },
    {
      "type": "parenthetical",
      "text": "(looks at his notes)"
    },
    {
      "type": "dialogue",
      "text": "... ‘Cobb’ of yours."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. THE BLONDE’S FRONT HALL - DAY"
    },
    {
      "type": "action",
      "text": "The Blonde opens the front door to Cobb and we:"
    },
    {
      "type": "transition",
      "text": "DISSOLVE TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. THE BLONDE’S LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "The Blonde and Cobb are having a drink."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "I warned you he’d look in the envelope."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "He gave me his word. I believed him."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Nothing personal, he couldn’t help himself - he’s a born peeper. Anyway, down to business."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Business?"
    },
    {
      "type": "action",
      "text": "Cobb takes a handkerchief out of his pocket and starts to wipe the outside of his glass and we:"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM WITH TABLE - DAY"
    },
    {
      "type": "action",
      "text": "We move in on the Young Man, puzzled, thinking hard."
    },
    {
      "type": "character",
      "text": "OLDER MAN (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Perhaps there’s something else you’d like to tell me about."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. THE BLONDE’S LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "The Blonde watches, puzzled as Cobb stretches his rubber gloves and puts them on, interlacing his fingers for a snug fit."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Where’s the hammer?"
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "Oh, down there in the bag."
    },
    {
      "type": "action",
      "text": "She points to a shopping bag on the table across from Cobb. Cobb rises, crosses the room and picks up the bag with his back to The Blonde. She can’t see him take it out of the bag and look at the dried blood on its head."
    },
    {
      "type": "character",
      "text": "THE BLONDE (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "What are you going to do with it?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(his back to her)"
    },
    {
      "type": "dialogue",
      "text": "The old man was pretty specific about the way I should do things."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(puzzled)"
    },
    {
      "type": "dialogue",
      "text": "What’s he have to say about it?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(turning around, hammer in hand)"
    },
    {
      "type": "dialogue",
      "text": "Well, he is giving me all the money out of his safe."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(not liking this)"
    },
    {
      "type": "dialogue",
      "text": "Money? What for?"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM WITH TABLE - DAY"
    },
    {
      "type": "action",
      "text": "Close on the Young Man as he thinks."
    },
    {
      "type": "action",
      "text": "The Older Man puts on a pair of rubber surgical gloves."
    },
    {
      "type": "character",
      "text": "OLDER MAN (O.S.)"
    },
    {
      "type": "dialogue",
      "text": "Anything at all. Your side of things?"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. THE BLONDE’S LIVING ROOM - DAY"
    },
    {
      "type": "action",
      "text": "Cobb moves towards The Blonde with the hammer."
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(smiling)"
    },
    {
      "type": "dialogue",
      "text": "He says your demands have become unreasonable... too greedy in your blackmail."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "parenthetical",
      "text": "(scared now)"
    },
    {
      "type": "dialogue",
      "text": "But, no - I, I, I don’t -"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(smiling, soothing)"
    },
    {
      "type": "dialogue",
      "text": "Something about an incident you witnessed in this very room? He was specific about where and how I should take care of things. Some sense of poetic justice, I suppose."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "But I -"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "dialogue",
      "text": "Something about a bloodstained carpet you’ve got stashed away to back up your story, should it ever be told."
    },
    {
      "type": "action",
      "text": "The Blonde is crying."
    },
    {
      "type": "character",
      "text": "THE BLONDE"
    },
    {
      "type": "dialogue",
      "text": "How could you do this to me?"
    },
    {
      "type": "character",
      "text": "COBB"
    },
    {
      "type": "parenthetical",
      "text": "(softly)"
    },
    {
      "type": "dialogue",
      "text": "Money."
    },
    {
      "type": "action",
      "text": "He lunges for The Blonde, grabbing her wrist and pulling her to the floor. He forces her hand flat against the floor and raises the hammer high above his had and we:"
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "INT. ROOM WITH TABLE - DAY"
    },
    {
      "type": "action",
      "text": "Close on the Young Man as he realizes something."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Did you talk to her?"
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "parenthetical",
      "text": "(nods gravely)"
    },
    {
      "type": "dialogue",
      "text": "We found her early this morning."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "Found her?"
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "dialogue",
      "text": "Her body."
    },
    {
      "type": "action",
      "text": "The Young Man covers his face with his hands."
    },
    {
      "type": "character",
      "text": "OLDER MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "We also found a hammer with two types of blood on it, one type which I assume will match the block you put in the hospital. All of her fingers were smashed - you must have tortured her for the combination."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "NO! I haven’t done anything to her! Go and pick up Cobb, he did it, he must have done it -"
    },
    {
      "type": "action",
      "text": "The Older man silences the Young Man by putting a shoebox on the table between them."
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "parenthetical",
      "text": "(rifling through the contents of the box)"
    },
    {
      "type": "parenthetical",
      "text": "(MORE)"
    },
    {
      "type": "character",
      "text": "OLDER MAN (CONT'D)"
    },
    {
      "type": "dialogue",
      "text": "We found some interesting items at your flat. In addition to the various items which the deceased reported stolen last week, we found several pairs of ladies’ underwear - are they hers?"
    },
    {
      "type": "action",
      "text": "The Young Man says nothing."
    },
    {
      "type": "character",
      "text": "OLDER MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "I assume so, since they were found stashed with some passport-style photographs of the deceased."
    },
    {
      "type": "action",
      "text": "The Young Man closes his eyes."
    },
    {
      "type": "character",
      "text": "OLDER MAN (CONT’D)"
    },
    {
      "type": "parenthetical",
      "text": "(pulls a small, clear plastic bag from the box)"
    },
    {
      "type": "dialogue",
      "text": "We also found this pearl earring."
    },
    {
      "type": "action",
      "text": "The Young Man opens his eyes. He looks at the evidence bag which the Older Man is holding out for him to see. Inside it is The Blonde’s pearl earring."
    },
    {
      "type": "character",
      "text": "OLDER MAN (CONT’D)"
    },
    {
      "type": "dialogue",
      "text": "It matches the one worn by the deceased at the time of her death. Little trophy?"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(desperation)"
    },
    {
      "type": "dialogue",
      "text": "NO! Cobb planted it! He took it when we broke in - pick him up, I gave you his address, he’s the one who killed her - he has to be."
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "dialogue",
      "text": "We went to the address you gave us. There’s no ‘Cobb’ there. The flat belongs to a..."
    },
    {
      "type": "parenthetical",
      "text": "(checks notes)"
    },
    {
      "type": "dialogue",
      "text": "... Timothy Kerr. He just got back from holiday and he says that he was robbed while he was away. Not too much was taken... but his new credit card hasn’t arrived -"
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "dialogue",
      "text": "That was Cobb, see?! We used it to buy a meal one time!"
    },
    {
      "type": "action",
      "text": "The Older Man reaches into the box and pulls out another clear evidence bag. Inside it is as credit card."
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "dialogue",
      "text": "We found this at your flat."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(running out of steam)"
    },
    {
      "type": "dialogue",
      "text": "It was... Cobb who stole it..."
    },
    {
      "type": "action",
      "text": "The Older Man flips the card over to display the signature on the back."
    },
    {
      "type": "character",
      "text": "OLDER MAN"
    },
    {
      "type": "dialogue",
      "text": "Is this your handwriting?"
    },
    {
      "type": "action",
      "text": "The Young Man looks at the card in despair."
    },
    {
      "type": "character",
      "text": "YOUNG MAN"
    },
    {
      "type": "parenthetical",
      "text": "(quiet)"
    },
    {
      "type": "dialogue",
      "text": "Yes."
    },
    {
      "type": "transition",
      "text": "CUT TO:"
    },
    {
      "type": "scene-heading",
      "text": "EXT. BUSY WEST END STREET CROWDED WITH PEDESTRIANS - DAY"
    },
    {
      "type": "action",
      "text": "Cobb comes out of a café and walks away from us down the street."
    },
    {
      "type": "action",
      "text": "He stops and looks back towards us over his shoulder as if to check that no one is following him."
    },
    {
      "type": "action",
      "text": "Satisfied, he turns back, moves off and is swallowed by the mass of pedestrians, crossing the frame in slo-mo and we:"
    },
    {
      "type": "transition",
      "text": "FADE TO BLACK."
    }
  ],
  "stacks": {},
